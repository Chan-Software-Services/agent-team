  "github": [
    {
      "id": "push",
      "method": "POST",
      "path": "graphql",
      "body": {
        "query": "query($owner: String!, $name: String!, $ref: String!) { repository(owner: $owner, name: $name) { ref(qualifiedName: $ref) { refUpdateRule { viewerCanPush } } } }",
        "variables": {"owner": "@OWNER@", "name": "@NAME@", "ref": "refs/heads/@BASE@"}
      },
      "answer": ".body.data.repository.ref | if . == null then null elif .refUpdateRule == null then true else .refUpdateRule.viewerCanPush end",
      "refused": [false]
    },
    {
      "id": "protection",
      "method": "POST",
      "path": "repos/@REPO@/branches/@BASE@/protection/enforce_admins",
      "body": null,
      "answer": ".status",
      "refused": [403, 404]
    },
    {
      "id": "setting",
      "method": "PATCH",
      "path": "repos/@REPO@",
      "body": {"name": "@NAME@"},
      "answer": ".status",
      "refused": [403, 404]
    },
    {
      "id": "merge",
      "method": "PUT",
      "path": "repos/@REPO@/pulls/@PULL@/merge",
      "body": {"sha": "0000000000000000000000000000000000000000"},
      "answer": "if .status == 405 and ((.body.message // \"\") | test(\"not authorized to push\"; \"i\") | not) then \"405: \\(.body.message // \"no message\")\" else .status end",
      "refused": [403, 405],
      "unshown": [
        {"answers": [409], "reason": "GitHub compared the head first"},
        {"pattern": "^405: ", "reason": "GitHub refused the merge for another reason than the push restriction (@ANSWER@)"}
      ]
    }
  ]
