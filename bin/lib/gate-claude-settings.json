{
  "attribution": { "commit": "", "sessionUrl": false },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "cat \"$HOME/agent-team/bin/lib/gate-rules.md\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME/agent-team/bin/hooks/command-guard\"", "onFailure": "block", "timeout": 10 }
        ]
      }
    ]
  }
}
