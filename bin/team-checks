#!/usr/bin/env bash
# Run a project's local checks on a head the way team-merge does: in a fresh detached worktree of it.
#
# Usage: team-checks <project> <head> [--from <checkout>] [--label <text>]
# Reads the project's local_checks from projects.toml; with none, says so and exits 0. Otherwise
# adds a detached worktree of <head> (a commit, in full or short) from <checkout> (default: the
# repository of the current directory) under a fresh mktemp -d outside the home directory, so
# nothing the checkout has that the head lacks (installs, builds, untracked files) can make a
# check pass. Each command runs from the worktree's root with bash -c, TMPDIR a fresh directory
# beside it (the test sandbox refuses one under /home or /Users), under the machine's heavy-run
# lock (team-heavy run --label "<text>: <command> on <head>", the text "team-checks <project>"
# by default, its cost sample heavy:checks:<project>), which waits for another holder.
# Each command gets TEAM_JOBS, how many processes it may run at once, which tests/run's bats take:
# the caller's when set, else team-capacity jobs' (the floor of the level's CPU budget, at least
# 1), read once before the first command.
# Prints "team-checks: running <command> on <head>" on stderr before each, and its result on
# stdout: "local check '<command>' passed on the head <head>", or failed (exit <n>), or could not
# run yet (exit 75, the lock stayed held). One that did not pass says where its whole log is kept,
# then, indented below, the lines above its last 20 that name a failure (a line starting FAIL or
# not ok, or holding --- FAIL, panic: or DATA RACE: go's and bats'), the first 20 at most, each
# cut at 300 characters, with how many there were when more, and then its last 20 lines.
# The log is kept for the coordinator to read, never in the team home: one file per project, head
# and check, ${XDG_CACHE_HOME:-~/.cache}/agent-team/checks/<project>/<head>/<n>-<command>.log (the
# check's number in local_checks and its command, each run of characters outside letters, digits
# and _ a dash, 60 characters at most), readable by its owner alone, printed with ~ for the home
# directory. The next run of that check on that head overwrites it, or removes it when it passes,
# and every run removes the project's kept logs older than 30 days; one that cannot be kept is
# said in the result's line, and neither that nor one that cannot be removed changes an exit.
# The worktree is removed with git worktree remove --force and its directory by the path mktemp
# printed.
# Exit 0 all passed or there are none, 1 any failed, 75 none failed but one could not run yet.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"

usage="usage: team-checks <project> <head> [--from <checkout>] [--label <text>]"

args=() from='' label=''
while (($#)); do
  case $1 in
    --from | --label)
      [[ $# -ge 2 && -n $2 ]] || usage_error "$usage"
      if [[ $1 == --from ]]; then from=$2; else label=$2; fi
      shift
      ;;
    -*) usage_error "$usage" ;;
    *) args+=("$1") ;;
  esac
  shift
done
[[ ${#args[@]} -eq 2 ]] || usage_error "$usage"
project=${args[0]} rev=${args[1]}
label=${label:-team-checks $project}

checks=$(team_project "$project" local_checks) || exit 1
mapfile -t local_checks < <(jq -r '.[]' <<<"$checks")
if ((${#local_checks[@]} == 0)); then
  echo "team-checks: $project has no local checks"
  exit 0
fi

from=${from:-.}
checkout=$(git -C "$from" rev-parse --show-toplevel 2>/dev/null) || die "$from is not a git checkout"
head=$(git -C "$checkout" rev-parse -q --verify "$rev^{commit}") || die "$rev is not a commit in $checkout"

# Outside the home directory, whose paths the ledger reads as any machine's.
base=${TMPDIR:-/tmp}
case $base in /home/* | /Users/* | "$HOME"/*) base=/tmp ;; esac
scratch=$(mktemp -d "$base/team-checks.XXXXXX")
trap 'git -C "$checkout" worktree remove --force "$scratch/head" 2>/dev/null || true; rm -rf "$scratch"' EXIT
git -C "$checkout" worktree add -q --detach "$scratch/head" "$head" 2>"$scratch/error" ||
  die "cannot check out ${head:0:7} for the local checks: $(grep -m1 . "$scratch/error")"

# A failed check's whole log outlives the scratch directory here, a cache and never a record; what
# is older than 30 days goes, so the heads that failed once do not pile up.
kept_root=${XDG_CACHE_HOME:-$HOME/.cache}/agent-team/checks/$project
if [[ -d $kept_root ]]; then
  find "$kept_root" -type f -name '*.log' -mtime +30 -delete 2>/dev/null || true
  find "$kept_root" -mindepth 1 -type d -empty -delete 2>/dev/null || true
fi
# The lines of a log that name a failure: go test's and bats'.
failure_lines='^FAIL|--- FAIL|panic:|DATA RACE|^not ok'

TEAM_JOBS=${TEAM_JOBS:-$(TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-capacity" jobs)}
export TEAM_JOBS

failed=0 later=0 number=0
for command in "${local_checks[@]}"; do
  number=$((number + 1))
  slug=$(tr '\n' ' ' <<<"$command" | LC_ALL=C sed -E 's/[^A-Za-z0-9_]+/-/g; s/^-//; s/-$//' | cut -c1-60)
  kept=$kept_root/$head/$number-$slug.log
  echo "team-checks: running $command on ${head:0:7}" >&2
  rm -rf "$scratch/tmp"
  mkdir "$scratch/tmp"
  rc=0
  (cd "$scratch/head" && TMPDIR=$scratch/tmp "$(dirname "$TEAM_LIB")/team-heavy" run --label "$label: $command on ${head:0:7}" --kind "checks:$project" -- bash -c "$command") \
    </dev/null >"$scratch/check.log" 2>&1 || rc=$?
  if ((rc == 0)); then
    echo "local check '$command' passed on the head ${head:0:7}"
    rm -f "$kept" 2>/dev/null || true
    rmdir "$kept_root/$head" 2>/dev/null || true
    continue
  fi
  if (umask 077 && mkdir -p "$kept_root/$head" && cp "$scratch/check.log" "$kept") 2>/dev/null; then
    where="its whole log is ${kept/#"$HOME/"/"~/"}"
  else
    where="its whole log could not be kept at ${kept/#"$HOME/"/"~/"}"
  fi
  if ((rc == 75)); then
    later=1
    echo "local check '$command' could not run on the head ${head:0:7} yet (exit 75, try again later); $where"
  else
    failed=1
    echo "local check '$command' failed on the head ${head:0:7} (exit $rc); $where"
  fi
  # The tail shows its own failure lines, so only the ones above it are named.
  head -n -20 "$scratch/check.log" | { grep -aE -- "$failure_lines" || true; } >"$scratch/named"
  named=$(wc -l <"$scratch/named")
  if ((named > 20)); then
    echo "    the first 20 of its $named earlier lines that name a failure:"
  elif ((named > 0)); then
    echo "    its earlier lines that name a failure:"
  fi
  head -n 20 "$scratch/named" | cut -c1-300 | sed 's/^/      /'
  echo "    its last lines:"
  tail -n 20 "$scratch/check.log" | sed 's/^/      /'
done

if ((failed)); then exit 1; elif ((later)); then exit 75; fi
