#!/usr/bin/env bash
# Wait on a pull request's GitHub checks, or with --run on one workflow run's jobs, and always end:
# the coordinator's checks wait (team-next T<n> --ci) runs it and acts on how it ended, and a
# worker may run it by hand, with Bash run_in_background; --json and --look are for a script that
# reads its end.
#
# Usage: team-ci-wait [--no-agent-review] [--json] [--look] <pr url> [<sha>]
#        team-ci-wait [--json] [--look] --run <run url> [<sha>]
#        team-ci-wait --merge-group <trial sha> [--no-agent-review] [--json] <pr url>
#   --no-agent-review
#           leave the agent-review check out of every look, as though GitHub had not reported it:
#           the checks wait after a pass and the findings round's look (team-next), which run once
#           the reviewer has set its own status, end on CI's checks alone and leave the review to
#           the review's own verdict
#   --json  print one JSON object instead of the text, on every end but a refused command line
#           (below); the exit code is as without it
#   --look  take one readable look at <sha> and end, with no wait (below)
#   --merge-group <trial sha>
#           wait on the checks of the merge queue's trial commit for the PR, the full 40-hex sha,
#           in place of the PR's head (below); team-land runs it
#   --run <run url>
#           wait on that one workflow run in place of a PR's checks (below, "With --run"):
#           https://github.com/<owner>/<name>/actions/runs/<id>, in a registered project's repo;
#           --no-agent-review and --merge-group do not go with it, since a run has no review check
#           and no queue entry
#           the options come in any order, before the PR URL or the sha
#   pr url  https://github.com/<owner>/<name>/pull/<n>, in a registered project's repo
#   sha     the head its caller means (the commit it pushed, the head it reviews), in full or
#           short (7 to 40 hex characters); without it, the head of the first readable look
# While the PR's head is not <sha>, it keeps looking for a grace of 2 minutes from the first look
# (GRACE_SECONDS), since GitHub may not show a push of a moment ago yet, and reads nothing else of
# those looks but a merged or closed PR; the first look whose head is <sha> is "the first look"
# below. TEAM_CI_WAIT_GRACE_SECONDS replaces the grace's seconds, TEAM_CI_WAIT_QUEUED_SECONDS the
# queued limit's 20 minutes (QUEUED_SECONDS), and TEAM_CI_WAIT_DEADLINE_SECONDS the deadline's 90
# minutes (DEADLINE_SECONDS), in seconds (the tests' seams).
# The interval before each look is gh_interval's over a base of 30 s (WAIT_SECONDS), or of 60 s
# (QUEUED_WAIT_SECONDS) when the last readable look waits only on queued things (a check pending,
# no pending check in_progress and no open workflow run in_progress), but 30 s through the grace
# for a push and while a reading stands for its 2 minutes; gh_interval raises it to 60, 120 or 300
# s as the hour's budget of GitHub's core requests (with --merge-group, GraphQL's points too) falls
# under a half, a quarter or a tenth; no interval runs past the grace's end, in the grace and with
# --look, or else past the deadline's. It counts its clocks in seconds, so a test steps it with a
# stub sleep: the grace and the deadline count every second it slept (elapsed), and each other clock
# (stuck, queued, settled, failing) adds the look interval slept before each look that counts for
# it, so each ends at its minutes whatever the interval. It reads GitHub's
# REST API through bin/lib/github-api.sh's reader alone (gh_read, and gh_call where an answer
# cannot be cached), which logs each request for <repo>#<n> (with --run, <repo> run <id>): every
# process of the machine shares its cache, and it asks again with the answer's ETag, so a read of
# an unchanged answer is a 304, which costs nothing against GitHub's limit. Its own subject's
# reads (the PR, its head's checks and runs, a run and its jobs) ask GitHub every look (OWN_FRESH,
# 0 s), so a wait begun seconds after a rerun never ends on the answer an earlier wait cached; the
# repository's runs in progress, the one read every wait on the repository makes, are read once in
# 20 s among them all, whichever wait makes it.
# Each look reads, at repos/<repo>/:
#   pulls/<n>                                     the PR's state (merged, closed or open) and head
#   commits/<head>/check-runs?filter=latest&per_page=100
#   commits/<head>/status?per_page=100            its head's checks: the check runs, every page
#                                                 with gh api --paginate only when GitHub counts
#                                                 over 100 of them, and the statuses, each read as
#                                                 gh pr checks reads a check (a check run's
#                                                 html_url its link; a conclusion of success
#                                                 passed, of skipped or neutral skipped, of
#                                                 cancelled cancelled, any other a failure)
#   actions/runs?head_sha=<head>&per_page=100     the head's workflow runs, which give the run of
#                                                 each pending check whose link is an Actions job
#                                                 link (.../actions/runs/<run id>/job/<job id>)
#   actions/runs/<run id>                         such a run, once per look, only when the head's
#                                                 runs do not list it
#   actions/runs?status=in_progress&per_page=1    how many workflow runs of the repository are in
#                                                 progress, its total_count, for the queued clock:
#                                                 the same read for every wait on the repository
# Once, when the wait ends on a failure, it reads the Actions job of each failed or cancelled check
# with an Actions job link that is not a roll-up (actions/jobs/<job id>), for its runner and
# steps: only reads of metadata, never a log or a check's output.
# A workflow run of the head that is not completed holds the wait whatever the checks show, since
# in a re-run's or a push's first seconds the head's checks may list only another workflow's, and
# an earlier attempt's failure may yet be replaced.
# A run GitHub does not list yet holds nothing, so a reading of no check, or of every check passed,
# counts only once it has stood for 2 minutes of looks (SETTLE_SECONDS), with no run open and no
# new check listed: until then any of these restarts it. The project's required_checks are read
# through team-project (with --merge-group, beside the base's rules, below), and one still not
# listed when that reading has stood is a failure.
# agent-review is never among them here, since a reviewer sets it at its verdict, apart from CI.
# Before each look, while the team holds offline (offline_hold), it ends at once with exit 75 and
# the hold's text.
# Then, while GitHub's rate limit stands for a resource the look reads (core, and graphql too with
# --merge-group), as the reader's limit.json of its login records it, the wait sends nothing and
# sleeps it out, to a second past its until (at most to the deadline), then looks: the first sleep
# for each until prints one line on stderr, "team-ci-wait: <the limit's text>; waiting for it, then
# looking again", the text naming the limit, primary or secondary, its reset in local time, and
# that it is no outage. A limit's sleep counts toward the grace and the deadline alone, and a read
# the limit refuses ends its look as a failed read does, but neither starts nor advances the
# failing clock: a limit never ends the wait but at its deadline, which, with GitHub not read yet,
# names it.
# Nothing here writes the team's offline flag for a limit, since GitHub is up.
# Without --json or --look, it prints one line when it starts, naming the PR and the short head of
# the first look, and its result when it ends, nothing in between; it ends at the earliest look
# where one of these holds:
#   the PR is merged or closed                         exit 1, naming its state
#   the head is still not <sha> after the grace        exit 1, naming both short heads: it is
#                                                      another commit; report it to the
#                                                      coordinator when it is not the worker's own
#   the head is not the first look's                   exit 1, naming both short heads: the new
#                                                      head's checks need a wait of their own
#   no check reported, none required, and no workflow  exit 0: the head has no GitHub checks
#   run open, for 2 minutes of looks
#   no check pending and no workflow run open, every   exit 0, naming each
#   check passed or skipped, for 2 minutes of looks,
#   and every required check listed
#   the same, with a required check not listed         exit 1, naming each such check as the PR's
#                                                      (on a trial commit, as the rules')
#   no check pending but stuck or queued ones, no      exit 1, naming each failed, cancelled,
#   workflow run open but a queued one's, and at       stuck or queued check in its class (below)
#   least one failed, cancelled, stuck or queued       and, on a trial commit, each required
#                                                      check no check lists as the rules', once
#                                                      that reading has stood for 2 minutes of
#                                                      looks with no new check listed (a run
#                                                      GitHub lists late is waited on)
#   a gh call failing at every look for 5 minutes,     exit 75, with gh's last reason line
#   the rate limit's refusals not counted
#   90 minutes of looks with checks still pending or   exit 75, naming each pending check with
#   a workflow run open                                its run's id and status and each other
#                                                      open run: run team-ci-wait again to wait
#                                                      on them, or report BLOCKED; a reading
#                                                      standing then gets its 2 minutes first
# A check is stuck when it is pending while its Actions run's status is completed, at every
# readable look for 5 minutes from the first that saw it: GitHub lost the job's status, and the
# message names the run, its conclusion and time, and the step: re-run it with gh run rerun <run
# id> --repo <repo>, then run team-ci-wait again, and report BLOCKED if it sticks again. A check is
# queued when it is pending in any state but in_progress (queued, pending, waiting, requested) and
# its Actions run is not completed, at every readable look from the first that saw it, for 20
# minutes of the looks at which nothing else of the repository runs: no runner took it, and neither
# it nor its run holds the wait any more. Something else runs at a look when GitHub lists more
# workflow runs of the repository in progress than the look's own open runs that are, or a check of
# the look is in_progress in an Actions run not completed (a stuck one's job runs nowhere, and a
# check from outside Actions takes no runner): such a look
# holds every queued clock at its count, since a job may wait well past 20 minutes for one of the
# plan's runners while the team's other runs hold them, and only one queued while nothing runs is
# one no runner took; the deadline bounds the wait all the same. A look whose gh call
# fails reads no state: it neither starts nor advances the stuck, the queued or the standing
# clock, while the deadline counts every sleep. A pending check from outside Actions (no run in
# its link) is never queued, and is waited on until it concludes or the deadline; agent-review is
# a check like any other, unless --no-agent-review leaves it out.
# A failure's text keeps the first line, "the checks on <short> did not pass:", and gives each
# check its own line, led by its class, the PR's first, then rules, then infrastructure, then
# roll-ups:
#   roll-up         a failed or cancelled check R beside a check of the same workflow run (the run
#                   id in their Actions links), failed, cancelled, stuck or queued, whose name is R
#                   then "-shard" or " shard" (test beside test-shards (2), e2e beside e2e shard
#                   3/6): "roll-up: R, of <its shards>, left out"; one whose shards all passed is
#                   the PR's
#   infrastructure  never started: a failed or cancelled check whose job has no runner and no step
#                   that ran (none concluded but skipped); setup: a failed check whose first
#                   failing step is GitHub's own (Set up job, Set up runner, Initialize containers,
#                   Complete job) or a stock action's (Run actions/..., Post Run actions/...); and
#                   each queued or stuck check: each line names its link and the gh run rerun (for
#                   a queued one, gh run cancel first) to run before running team-ci-wait again
#   rules           with --merge-group, a required check not listed on the trial commit: "rules:
#                   <name> was not reported on the trial commit, though <base>'s rules require it
#                   (or the project requires it, for one of the registry's alone): no workflow
#                   makes it on a merge queue's trial commit", which no change of the PR's fixes
#   the PR's        every other: a failed step of the project's own, a cancel after a step ran, a
#                   required check not listed on a PR's head, a check from outside Actions, and a
#                   check whose job could not be read, so said
# Every class is a failure, since the head is not green.
# --look ends at the first readable look whose head is <sha>, keeping the grace for a push: it
# prints no starting line, and its text names each failed or cancelled check, classed as above, then
# the checks still pending and each open workflow run as the deadline names them ("  still pending:
# ..."). It names no queued or stuck check and no required check not listed, since each of those
# needs a clock across looks and --look takes one; such a check is named pending. Its ends: a
# failure, exit 1 (failed); none, but checks pending or a run open, exit 0 (pending); every check
# passed or skipped, exit 0 (passed); no check and no run open, exit 0 (none); the head still not
# <sha> after the grace, the PR merged or closed, or the team holding offline, as the wait ends;
# GitHub not read for the grace, exit 75 (unreadable). A rate limit, standing or met by the look's
# own read, is met at once, with no look interval first: one that lifts within what is left of the
# grace is slept out as above, then the look taken; one that does not ends the look at once, exit
# 75 (unreadable), "team-ci-wait: <the limit's text>: look again after it".
# --json's object is {schema: "team-ci-wait/1", outcome, head, text, failures, limited_until}:
# outcome one of passed, none, failed, other-head (still not <sha> after the grace), moved, closed
# (merged or closed), deadline, unreadable (gh failing for its 5 minutes, a look's grace, a rate
# limit past a look's grace, or the deadline with no readable look), offline, and with --look
# pending; head the PR's head at the last readable look, null before
# one; text what the end prints without --json, the starting line left out; failures each failure
# of a failed end, in the text's order, as {name, class (pr, rules, infrastructure or rollup), kind
# (failed, cancelled, missing, never-started, setup, queued, stuck or rollup), state (the check's,
# lowercase, null for a missing one), link, run, job (the Actions run and job ids as numbers, else
# null), step (the first failing step's name, else null), rerun (the command its line gives, else
# null), and on a rules failure source, what requires the check: rules when the base's rules do,
# else required_checks, the project's alone}, and [] on any other end; limited_until the until of
# the last rate limit the wait met, as a UTC time (2026-11-16T07:27:14Z), else null.
# --merge-group waits on the trial commit the merge queue built for the PR, with the same clocks,
# classes, deadlines and outcomes, --json's head the trial commit, and these differences. Each look
# reads the PR's state and its queue entry's head commit (gh api graphql, through gh_call, one
# GraphQL point a look, never cached) in place of pulls/<n>, and the rest as a PR's look does, at
# the trial commit: its check runs and statuses and its workflow runs, with the repository's runs
# in progress. There is no grace, since the caller read the trial commit from the entry. Before
# its first look it reads the base's rules once (base_rules in bin/lib/team.sh, for the project's
# base on the PR's repository, on the login it runs on), and holds every context they require but
# agent-review, which team-land posts itself, as required beside the registry's required_checks; a
# read that fails prints one line on stderr, "team-ci-wait: <base>'s rules on <repo> could not be
# read, so only the registry's required checks are held: <its first error line>", and the wait
# goes on with those. Once the entry's head commit is no longer <trial sha> (the queue rebuilt the
# entry onto another trial commit, landed it or dropped it), the wait ends at that look: on a
# merged or closed PR as on a head; when a check of the trial commit failed, as a failure, exit 1,
# the cancelled and pending checks of that look left out, since the queue cancels the rest of a
# commit it gives up, and each required check no check of the look lists (a cancelled or pending
# one counts as listed) named as the rules', that reading first held for 2 minutes of looks as
# above; else exit 1 (other-head), naming where the entry is. --look and a <sha>
# after the URL are refused with it.
# With --run, the wait is on the one workflow run, read as a PR's checks are, but for what follows.
# Each look reads, through the reader as above, the run (repos/<repo>/actions/runs/<id>), its jobs,
# the latest attempt's (repos/<repo>/actions/runs/<id>/jobs?per_page=100), and the repository's runs
# in progress. A job is a check: its name, its state the conclusion once completed else its status,
# passed on success, skipped on skipped or neutral, cancelled on cancelled, failed on any other
# conclusion or none, pending while not completed, its link the job's page, and a pending job's run
# the run itself. The head is the run's head_sha, which never changes, and there is no PR to be
# merged, closed or moved: a run whose head is not <sha> ends the wait at the first readable look,
# exit 1 (other-head), with no grace. The run holds the wait while it is not completed, with no job
# listed too; once it is completed, a reading with nothing pending counts at once, with no 2
# minutes, since a completed run's jobs are final until a rerun, which needs a wait of its own. A
# completed run with a job still pending is held, and that job is stuck after 5 minutes. The
# required checks are the project's as for a PR, and one the completed run does not list is a
# failure, but for a run of another workflow than the project's branch_ci, when it names one, which
# answers for its own jobs alone. A run that completed with a conclusion that is no pass, with no
# job failed, cancelled or pending to say why (a workflow that never started, a cancel before any
# job), is a failure of the branch's own, named by its workflow with the run's link. Its texts: the
# starting line names the run, "waiting on CI run <id> of <repo> at <short>"; the class "the PR's"
# reads "the branch's" (--json's class stays pr); and wherever a line says to run team-ci-wait again
# it says to wait on the run again, since its caller may be team-ci-run. Its ends, at the earliest
# look where one holds:
#   the run's head is not <sha>                        exit 1, naming both short heads
#   the run completed, no job pending, every job       exit 0, naming each (with no job at all and
#   passed or skipped, every required check listed     none required, saying so: outcome none)
#   the same, with a required check not listed         exit 1, naming each as the branch's
#   the run completed or its only pending jobs queued  exit 1, naming each failed, cancelled, stuck
#   or stuck, and at least one failed, cancelled,      or queued job in its class
#   stuck or queued
#   a gh call failing at every look for 5 minutes,     exit 75, as for a PR
#   the deadline, or the team holding offline
# --look and --json are as for a PR, a look's outcome pending while the run is not completed.
# Exit 0 the checks passed, 1 they did not or the wait no longer applies, 2 a malformed command
# line, 75 try again later.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"
# shellcheck source=bin/lib/github-api.sh
source "$TEAM_LIB/github-api.sh"

# Seconds between looks, and while only queued things are pending, how long a check must look stuck
# or queued, how long a reading with nothing left to wait on must stand, how long gh may fail, and
# the deadline.
WAIT_SECONDS=30
# Seconds within which an answer about the wait's own subject is served from the cache with no
# request: none, so each look asks again, for a 304 when nothing changed.
OWN_FRESH=0
QUEUED_WAIT_SECONDS=60
STUCK_SECONDS=300
QUEUED_SECONDS=${TEAM_CI_WAIT_QUEUED_SECONDS:-1200}
SETTLE_SECONDS=120
FAILING_SECONDS=300
DEADLINE_SECONDS=${TEAM_CI_WAIT_DEADLINE_SECONDS:-5400}
GRACE_SECONDS=${TEAM_CI_WAIT_GRACE_SECONDS:-120}

[[ $DEADLINE_SECONDS =~ ^[0-9]+$ ]] || usage_error "TEAM_CI_WAIT_DEADLINE_SECONDS must be a number of seconds"
[[ $GRACE_SECONDS =~ ^[0-9]+$ ]] || usage_error "TEAM_CI_WAIT_GRACE_SECONDS must be a number of seconds"
[[ $QUEUED_SECONDS =~ ^[0-9]+$ ]] || usage_error "TEAM_CI_WAIT_QUEUED_SECONDS must be a number of seconds"
usage="usage: team-ci-wait [--no-agent-review] [--json] [--look] <pr url> [<sha>]
       team-ci-wait [--json] [--look] --run <run url> [<sha>]
       team-ci-wait --merge-group <trial sha> [--no-agent-review] [--json] <pr url>"
without_review=false json=false look=false group='' run_url=''
while [[ ${1:-} == --* ]]; do
  case $1 in
    --no-agent-review) without_review=true ;;
    --json) json=true ;;
    --look) look=true ;;
    --merge-group)
      [[ ${2:-} =~ ^[0-9a-f]{40}$ ]] || usage_error "--merge-group takes the trial commit's full 40-hex sha; $usage"
      group=$2
      shift
      ;;
    --run)
      [[ -z $run_url && $# -ge 2 ]] || usage_error "$usage"
      run_url=$2
      shift
      ;;
    *) usage_error "$usage" ;;
  esac
  shift
done

# A workflow run URL's project, repo and run id, one per line, as registered_pr gives a PR URL's:
# the repo found among the registered projects' and given at the end of its moves.
registered_run() {
  local project repo id
  [[ $1 =~ ^https://github\.com/([A-Za-z0-9-]+/[A-Za-z0-9._-]+)/actions/runs/([1-9][0-9]*)$ ]] ||
    usage_error "not a GitHub Actions run URL (https://github.com/<owner>/<name>/actions/runs/<id>): $1"
  repo=${BASH_REMATCH[1]} id=${BASH_REMATCH[2]}
  project=$(team_project --find repo "$repo") || exit 1
  [[ -n $project ]] || die "$repo is no registered project's repo"
  project=${project%%$'\n'*}
  repo=$(canonical_repo "$(team_project "$project" repo)") || exit 1
  printf '%s\n' "$project" "$repo" "$id"
}

# The mode: a workflow run's (--run), its id in run_id, a PR's queue trial commit's
# (--merge-group), its sha in group, or a PR's head's, the PR's number in number. The texts that
# differ between a run and a PR: whose a failure of the head's own is, and what to do after a rerun.
if [[ -n $run_url ]]; then
  $without_review && usage_error "--no-agent-review does not go with --run: a workflow run has no review check"
  [[ -z $group ]] || usage_error "--merge-group does not go with --run: a workflow run has no queue entry"
  [[ $# -eq 0 || ($# -eq 1 && $1 =~ ^[0-9a-f]{7,40}$) ]] || usage_error "$usage"
  expected=${1:-}
  found=$(registered_run "$run_url")
  { read -r project && read -r repo && read -r run_id; } <<<"$found"
  number=''
  whose="the branch's" again="wait on the run again" again_wait=$again again_unread=$again
  # A completed run's jobs are final until a rerun, so its reading stands at once.
  SETTLE_SECONDS=0
else
  if [[ -n $group ]]; then
    if [[ $# -ne 1 ]] || $look; then usage_error "$usage"; fi
    expected=$group
  else
    [[ $# -eq 1 || ($# -eq 2 && $2 =~ ^[0-9a-f]{7,40}$) ]] || usage_error "$usage"
    expected=${2:-}
  fi
  found=$(registered_pr "$1")
  { read -r project && read -r repo && read -r number; } <<<"$found"
  run_id=''
  whose="the PR's" again="run team-ci-wait again" again_wait="$again to wait on them" again_unread="$again to wait"
fi
required=$(team_project "$project" required_checks)
base=$(team_project "$project" base)
# The workflow whose run carries the required checks, when the project names one.
branch_ci=$(team_project "$project" branch_ci)
# Whom the reader logs each request for.
if [[ -n $run_id ]]; then GH_FOR="$repo run $run_id"; else GH_FOR="$repo#$number"; fi

dir=$(team_mktemp -d)
echo '[]' >"$dir/failures"

# finish <outcome> <exit code> <text>: print <text>, or with --json the object of this end, its
# failures those report wrote, and exit with <exit code>.
finish() {
  if $json; then
    jq -cn --arg outcome "$1" --arg head "$head" --arg text "$3" --slurpfile failures "$dir/failures" \
      --arg limited "$([[ -z $limited_until ]] || gh_utc "$limited_until")" \
      '{schema: "team-ci-wait/1", outcome: $outcome, head: (if $head == "" then null else $head end), text: $text,
        failures: $failures[0], limited_until: (if $limited == "" then null else $limited end)}'
  else
    printf '%s\n' "$3"
  fi
  exit "$2"
}

# read_checks <sha>: $dir/checks, the commit's check runs and statuses as gh pr checks gives a PR's
# ({name, state, bucket, link}): a check run's state its conclusion once completed, else its
# status, its link its html_url, its bucket pass on success, skipping on skipped or neutral,
# cancel on cancelled, fail on any other conclusion, else pending; a status's state its own, pass
# on success, pending on pending, else fail. The check runs are one page unless GitHub counts more
# than 100 of them, then every page, uncached. Fails as the reader does, its reason in $dir/error.
read_checks() {
  gh_read "$dir" check-runs "repos/$repo/commits/$1/check-runs?filter=latest&per_page=100" "$OWN_FRESH" || return
  if jq -e '(.total_count // 0) > 100' "$dir/check-runs" >/dev/null 2>&1; then
    gh_call "$dir" check-runs api "repos/$repo/commits/$1/check-runs?filter=latest&per_page=100" --paginate || return
  fi
  gh_read "$dir" statuses "repos/$repo/commits/$1/status?per_page=100" "$OWN_FRESH" || return
  jq -n --slurpfile runs "$dir/check-runs" --slurpfile statuses "$dir/statuses" '
    [($runs[].check_runs[] | (if .status == "completed" then .conclusion // "" else .status end) as $state
      | {name, state: ($state | ascii_upcase), link: (.html_url // ""),
         bucket: ({success: "pass", skipped: "skipping", neutral: "skipping", cancelled: "cancel"}[$state]
           // (if .status == "completed" then "fail" else "pending" end))}),
     ($statuses[0].statuses[] | {name: .context, state: (.state | ascii_upcase), link: (.target_url // ""),
       bucket: ({success: "pass", pending: "pending"}[.state] // "fail")})]' >"$dir/checks"
}

# --merge-group's reads of a look: $dir/view, {state, headRefOid: the trial commit, entry: the
# head commit of the PR's queue entry, "" with none}, and $dir/checks, the trial commit's; fails
# with the reason in $dir/error.
read_group() {
  # shellcheck disable=SC2016 # the query's variables are GraphQL's
  gh_call "$dir" entry api graphql -f query='query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) { pullRequest(number: $number) {
    state mergeQueueEntry { headCommit { oid } } } } }' \
    -f owner="${repo%%/*}" -f name="${repo#*/}" -F number="$number" || return
  if ! jq -e --arg sha "$group" '.data.repository.pullRequest | objects
    | {state, headRefOid: $sha, entry: (.mergeQueueEntry.headCommit.oid // "")}' "$dir/entry" >"$dir/view" 2>/dev/null; then
    echo "gh api graphql: no such pull request" >"$dir/error"
    return 1
  fi
  read_checks "$group"
}

# Read one look into $dir/look, {state, head, entry, checks: [{name, state, bucket, link, run}],
# open_runs: [{id, name, status}], busy}, each pending check's run {id, status, conclusion,
# updated_at} when its link is an Actions job link, else null, open_runs the head's workflow runs
# not yet completed (with --run, the run itself), entry the head commit of the PR's queue entry
# with --merge-group ("" with none), else null, and busy whether something of the repository runs:
# more workflow runs in progress than open_runs has, or a check in progress of an Actions run not
# completed. It fails as the reader does (3 for a limit, else 1), its reason in $dir/error, and
# leaves the last look's file as it was.
read_look() {
  if [[ -n $run_id ]]; then read_run; else read_pr; fi || return
  gh_read "$dir" running "repos/$repo/actions/runs?status=in_progress&per_page=1" || return
  jq --slurpfile running "$dir/running" '
    .busy = (($running[0].total_count // 0) > ([.open_runs[] | select(.status == "in_progress")] | length)
      or any(.checks[]; .state == "in_progress" and .run != null and .run.status != "completed"))' "$dir/reading" >"$dir/look.new"
  mv "$dir/look.new" "$dir/look"
}

# With --run, the reading of the run and its jobs, the latest attempt's, into $dir/reading: each job
# a check, its state the conclusion once completed else its status, its link the job's page, and a
# pending one's run the run itself; state always OPEN, since a run is never merged or closed. A run
# that completed with a conclusion that is no pass, and no job failed, cancelled or pending to say
# why (a workflow that never started, a cancel before any job), is itself a failed or cancelled
# check, by the workflow's name with the run's link.
read_run() {
  gh_read "$dir" wf-run "repos/$repo/actions/runs/$run_id" "$OWN_FRESH" || return
  gh_read "$dir" wf-jobs "repos/$repo/actions/runs/$run_id/jobs?per_page=100" "$OWN_FRESH" || return
  jq -n --slurpfile run "$dir/wf-run" --slurpfile jobs "$dir/wf-jobs" '
    $run[0] as $r
    | [$jobs[0].jobs[]
        | {name, state: (if .status == "completed" then .conclusion // "completed" else .status end | ascii_downcase),
           bucket: (if .status != "completed" then "pending" elif .conclusion == "success" then "pass"
             elif .conclusion == "skipped" or .conclusion == "neutral" then "skipping"
             elif .conclusion == "cancelled" then "cancel" else "fail" end),
           link: (.html_url // "")}
        | .run = (if .bucket == "pending" then $r | {id, status, conclusion, updated_at} else null end)] as $checks
    | {state: "OPEN", head: $r.head_sha,
       checks: ($checks + if $r.status == "completed" and ($r.conclusion | IN("success", "skipped", "neutral") | not)
           and all($checks[]; .bucket == "pass" or .bucket == "skipping") then
         [{name: ($r.name // "the run"), state: ($r.conclusion // "completed"),
           bucket: (if $r.conclusion == "cancelled" then "cancel" else "fail" end), link: ($r.html_url // ""), run: null}]
       else [] end),
       open_runs: [$r | select(.status != "completed") | {id, name, status}]}' >"$dir/reading"
}

# The reading of the PR, its checks and its head's workflow runs, into $dir/reading: the PR's state
# MERGED once merged, CLOSED once closed, else OPEN, and a pending check's run taken from the head's
# runs, or read by its id when they do not list it.
read_pr() {
  local id files=()
  rm -f "$dir"/run-*
  if [[ -n $group ]]; then
    read_group || return
  else
    gh_read "$dir" pull "repos/$repo/pulls/$number" "$OWN_FRESH" || return
    jq '{state: (if .merged then "MERGED" elif .state == "closed" then "CLOSED" else "OPEN" end), headRefOid: .head.sha}' \
      "$dir/pull" >"$dir/view"
    read_checks "$(jq -r .headRefOid "$dir/view")" || return
  fi
  gh_read "$dir" head-runs "repos/$repo/actions/runs?head_sha=$(jq -r .headRefOid "$dir/view")&per_page=100" "$OWN_FRESH" || return
  while IFS= read -r id; do
    gh_read "$dir" "run-$id" "repos/$repo/actions/runs/$id" "$OWN_FRESH" || return
    files+=("$dir/run-$id")
  done < <(jq -r --slurpfile head_runs "$dir/head-runs" '[$head_runs[0].workflow_runs[].id | tostring] as $listed
    | [.[] | select(.bucket == "pending") | .link // "" | capture("/actions/runs/(?<id>[0-9]+)/job/[0-9]+").id]
    | unique[] | select(IN($listed[]) | not)' "$dir/checks")
  jq -n --slurpfile view "$dir/view" --slurpfile checks "$dir/checks" --slurpfile head_runs "$dir/head-runs" --argjson without_review "$without_review" \
    --argjson runs "$(jq -s 'map({key: (.id | tostring), value: {id, status, conclusion, updated_at}}) | from_entries' \
      /dev/null "${files[@]}")" '
    ($head_runs[0].workflow_runs | map({key: (.id | tostring), value: {id, status, conclusion, updated_at}}) | from_entries)
      + $runs as $runs
    | {state: $view[0].state, head: $view[0].headRefOid, entry: $view[0].entry,
     checks: [$checks[0][] | select($without_review and .name == "agent-review" | not) | {name, state: (.state | ascii_downcase), bucket, link: (.link // ""),
       run: (if .bucket == "pending" then $runs[(.link // "") | capture("/actions/runs/(?<id>[0-9]+)/job/[0-9]+").id // ""]
         else null end)}],
     open_runs: [$head_runs[0].workflow_runs[] | select(.status != "completed") | {id, name, status}]}' >"$dir/reading"
}

# The text naming each pending check of the last readable look, with its run's id and status, and
# each open workflow run no pending check names.
pending_text() {
  jq -r '[.checks[] | select(.bucket == "pending") | .run.id // empty] as $named
    | [(.checks[] | select(.bucket == "pending")
        | "\(.name) (\(.state), " + (if .run then "run \(.run.id) \(.run.status))" else "not an Actions run)" end)),
       (.open_runs[] | select(.id | IN($named[]) | not) | "\(.name) (workflow run \(.id) \(.status))")]
    | join("; ")' "$dir/look"
}

# The span of <seconds>, in whole minutes when it is some, one of either in the singular.
span() {
  local n=$1 unit=second
  if ((n > 0 && n % 60 == 0)); then n=$((n / 60)) unit=minute; fi
  ((n == 1)) || unit+=s
  echo "$n $unit"
}

# tick <clocks> <seconds> <filter> <out> <step>: the clocks of the checks the jq <filter> selects at
# the last readable look, in the associative array <clocks> (each name's seconds since the first
# look that saw it, which this look adds its <step> to: the look interval slept before it or, to
# hold every clock, 0; a check no longer selected loses its clock), and in the array <out> each
# name whose clock has run <seconds>.
# shellcheck disable=SC2004 # counted is an associative array, by nameref, keyed by $name
tick() {
  local -n counted=$1 out=$4
  local name
  local -A now=()
  while IFS= read -r name; do
    now[$name]=1
    if [[ -n ${counted[$name]:-} ]]; then counted[$name]=$((counted[$name] + $5)); else counted[$name]=0; fi
  done < <(jq -r ".checks[] | select($3) | .name" "$dir/look")
  out=()
  for name in "${!counted[@]}"; do
    if [[ -z ${now[$name]:-} ]]; then
      unset "counted[$name]"
    elif ((counted[$name] >= $2)); then
      out+=("$name")
    fi
  done
}

# The classes, as jq definitions over a look, with $stuck and $queued the names of the checks that
# ran out their clocks, $jobs each Actions job read by its id, $repo, and the mode's $whose and
# $again. unpassed is each check
# that did not pass, failed, cancelled, stuck or queued, with its run_id and job_id from its Actions
# job link (else null) and shards, the names of the checks of its run, failed, cancelled, stuck or
# queued, that make a failed or cancelled check a roll-up of them. classed is each of them as
# {name, class, kind, state, link, run, job, step, rerun, line}, line its text.
CLASSES='
  def ids: (.link | capture("/actions/runs/(?<run>[0-9]+)/job/(?<job>[0-9]+)")
    | {run_id: (.run | tonumber), job_id: (.job | tonumber)}) // {run_id: null, job_id: null};
  def unpassed:
    [.checks[] | select(.bucket == "fail" or .bucket == "cancel" or (.name | IN($stuck[], $queued[]))) | . + ids] as $c
    | $c[] | . as $r
    | . + {shards: (if (.bucket == "fail" or .bucket == "cancel") and .run_id != null then
        [$c[] | select(.run_id == $r.run_id
          and (.name | startswith($r.name + "-shard") or startswith($r.name + " shard"))) | .name]
      else [] end)};
  def setup_step: IN("Set up job", "Set up runner", "Initialize containers", "Complete job")
    or startswith("Run actions/") or startswith("Post Run actions/");
  def classed:
    unpassed
    | (if .job_id == null then null else $jobs[.job_id | tostring] end) as $job
    | ([$job.steps[]? | select(.conclusion == "failure")] | sort_by(.number) | .[0].name) as $step
    | (if .link == "" then "no link" else .link end) as $link
    | "gh run rerun \(.run_id) --job \(.job_id) --repo \($repo)" as $rerun
    | {name, state, link: (if .link == "" then null else .link end), run: .run_id, job: .job_id, step: null, rerun: null}
      + if .shards != [] then
        {class: "rollup", kind: "rollup", line: "roll-up: \(.name), of \(.shards | join(", ")), left out"}
      elif .name | IN($stuck[]) then
        {class: "infrastructure", kind: "stuck", rerun: "gh run rerun \(.run.id) --repo \($repo)",
         line: "infrastructure: \(.name) is still \(.state), but its run \(.run.id) completed \(.run.conclusion) at \(.run.updated_at): GitHub lost the job\u0027s status; re-run it with gh run rerun \(.run.id) --repo \($repo), then \($again), and report BLOCKED if it sticks again"}
      elif .name | IN($queued[]) then
        {class: "infrastructure", kind: "queued", rerun: $rerun,
         line: "infrastructure: \(.name) is still \(.state) after \($queued_span) of looks: no runner took it (\($link)); cancel its run with gh run cancel \(.run_id) --repo \($repo), then rerun the job with \($rerun), then \($again)"}
      elif $job != null and ($job.runner_name // "") == ""
        and all($job.steps[]?; .conclusion == null or .conclusion == "skipped") then
        {class: "infrastructure", kind: "never-started", rerun: $rerun,
         line: "infrastructure: \(.name) never started: no runner took it (\($link)); rerun it with \($rerun), then \($again)"}
      elif .bucket == "fail" and ($step // "" | setup_step) then
        {class: "infrastructure", kind: "setup", step: $step, rerun: $rerun,
         line: "infrastructure: \(.name) failed in setup, at its step \"\($step)\" (\($link)); rerun it with \($rerun), then \($again)"}
      else
        {class: "pr", kind: (if .bucket == "fail" then "failed" else "cancelled" end), step: $step,
         line: ("\($whose): \(.name) " + (if .bucket == "fail" then "failed" else "was cancelled" end) + ": \($link)"
           + (if .job_id != null and $job == null then " (its job could not be read)" else "" end))}
      end;
'

# report <missing>: sets text to the text of a wait that ends on a failure: today's first line, then
# a line for each check the last readable look did not pass, classed, and each required check in
# the JSON array <missing> (with --merge-group, each of class rules), the PR's (with --run, the
# branch's) first, then rules, then infrastructure, then roll-ups; and writes those
# failures, in that order, to $dir/failures as --json gives them. It reads the Actions job of each
# failed or cancelled check that is not a roll-up, once; one it cannot read stays the PR's.
report() {
  local id
  : >"$dir/jobs"
  while IFS= read -r id; do
    if gh_read "$dir" "job-$id" "repos/$repo/actions/jobs/$id"; then
      jq -c --arg id "$id" '{($id): .}' "$dir/job-$id" >>"$dir/jobs"
    fi
  done < <(jq -r --argjson stuck "$stuck_json" --argjson queued "$queued_json" --arg repo "$repo" \
    --arg queued_span "" --arg whose "" --arg again "" --argjson jobs '{}' "$CLASSES"'
    unpassed | select(.shards == [] and (.bucket == "fail" or .bucket == "cancel") and .job_id != null) | .job_id' "$dir/look")
  jq -c --argjson stuck "$stuck_json" --argjson queued "$queued_json" --argjson missing "$1" --arg repo "$repo" \
    --arg queued_span "$(span "$QUEUED_SECONDS")" --arg whose "$whose" --arg again "$again" \
    --arg unreported "$([[ -n $run_id ]] || echo " for $(span "$SETTLE_SECONDS")")" \
    --arg base "$base" --argjson group "$([[ -n $group ]] && echo true || echo false)" --argjson rules "$rules_required" \
    --argjson jobs "$(jq -s 'add // {}' "$dir/jobs")" "$CLASSES"'
    [classed, ($missing[] | {name: ., class: (if $group then "rules" else "pr" end), kind: "missing", state: null,
       link: null, run: null, job: null, step: null, rerun: null}
       + if $group then
           (if IN($rules[]) then "rules" else "required_checks" end) as $source
           | {source: $source, line: ("rules: \(.) was not reported on the trial commit, though "
               + (if $source == "rules" then "\($base)\u0027s rules require" else "the project requires" end)
               + " it: no workflow makes it on a merge queue\u0027s trial commit")}
         else {line: "\($whose): \(.) was not reported\($unreported), and the project requires it"} end)]
    | sort_by({pr: 0, rules: 1, infrastructure: 2, rollup: 3}[.class])' "$dir/look" >"$dir/classed"
  jq 'map(del(.line))' "$dir/classed" >"$dir/failures"
  text="team-ci-wait: the checks on ${head:0:7} did not pass:"$'\n'$(jq -r '.[] | "  " + .line' "$dir/classed")
}

# The text of a look whose every check passed or was skipped, naming each.
passed_text() {
  jq -r --arg short "${head:0:7}" '"team-ci-wait: every check passed on \($short): "
    + ([.checks[] | "\(.name) " + (if .bucket == "pass" then "passed" else "skipped" end)] | join(", "))' "$dir/look"
}

# With --run, the text of a completed run that passed with no job.
no_job_text() {
  echo "team-ci-wait: the run $run_id completed with no job on ${head:0:7}"
}

# --look's end, at the first readable look of the head: each failed or cancelled check, classed,
# then what is still pending.
look_end() {
  local pending
  pending=$(pending_text)
  if jq -e 'any(.checks[]; .bucket == "fail" or .bucket == "cancel")' "$dir/look" >/dev/null; then
    report '[]'
    [[ -z $pending ]] || text+=$'\n'"  still pending: $pending"
    finish failed 1 "$text"
  elif [[ -n $pending ]]; then
    finish pending 0 "team-ci-wait: no check has failed on ${head:0:7} so far; still pending: $pending"
  elif jq -e '.checks == []' "$dir/look" >/dev/null; then
    [[ -z $run_id ]] || finish none 0 "$(no_job_text)"
    finish none 0 "team-ci-wait: ${head:0:7} has no GitHub checks reported so far"
  fi
  finish passed 0 "$(passed_text)"
}

# The clocks, in seconds: elapsed, every sleep's, which bounds the grace and the deadline; slept,
# the look interval slept before this look, which each clock that counts this look adds; failing,
# since the first look of a run of failed reads, and settled, since the reading now standing was
# first seen, each empty when not running. limited_until is the until of the last limit met, and
# told the last one whose sleep was said on stderr.
elapsed=0 slept=0 head='' first_head='' failing='' settled='' settled_on='' text='' limited_until='' told=''
# How long gh may fail before the end: a look's grace, else FAILING_SECONDS.
if $look; then failing_limit=$GRACE_SECONDS; else failing_limit=$FAILING_SECONDS; fi
# The rate limits a look reads under: core, and with --merge-group GraphQL's for its entry.
limits=(core)
[[ -z $group ]] || limits+=(graphql)

# The seconds at which the wait ends: the deadline, and a reading standing then gets its 2 minutes.
deadline_at() {
  echo $((DEADLINE_SECONDS + (${#settled} ? SETTLE_SECONDS : 0)))
}

# pause [grace]: sleep the look interval before the next look, gh_interval's over its base: 30 s,
# or 60 s when the last readable look waits only on queued things, but 30 s in the grace (with
# "grace") and while a reading stands, and the base alone while a limit stands; at most to the
# grace's end in the grace and with --look, else to the deadline's.
pause() {
  local base=$WAIT_SECONDS seconds end
  if [[ ${1:-} != grace && -z $settled ]] && jq -e '[.checks[] | select(.bucket == "pending")] as $pending
    | ($pending | length) > 0 and all($pending[]; .state != "in_progress")
      and all(.open_runs[]; .status != "in_progress")' "$dir/look" >/dev/null 2>&1; then
    base=$QUEUED_WAIT_SECONDS
  fi
  # A limit standing is slept out at the next look, so the budget its refusal emptied adds nothing.
  if gh_limited "${limits[@]}" >/dev/null; then seconds=$base; else seconds=$(gh_interval "$base" "${limits[@]}"); fi
  if [[ ${1:-} == grace ]] || $look; then end=$GRACE_SECONDS; else end=$(deadline_at); fi
  ((elapsed >= end || seconds <= end - elapsed)) || seconds=$((end - elapsed))
  sleep "$seconds"
  elapsed=$((elapsed + seconds)) slept=$seconds
}

# sleep_limit: when a limit stands for a resource the look reads, sleep it out, to a second past
# its until but at most to the deadline, saying so on stderr once for each until; with --look, end
# unreadable instead when it does not fit in what is left of the grace. The sleep adds to elapsed
# alone, never to slept.
sleep_limit() {
  local record lifts resource kind seconds left
  record=$(gh_limit_record "${limits[@]}") || return 0
  read -r lifts resource kind <<<"$record"
  limited_until=$lifts
  seconds=$((lifts + 1 - $(gh_now)))
  if $look; then
    if ((seconds > GRACE_SECONDS - elapsed)); then
      finish unreadable 75 "team-ci-wait: $(gh_limit_text "$lifts" "$resource" "$kind"): look again after it"
    fi
  else
    left=$(($(deadline_at) - elapsed))
    ((seconds <= left)) || seconds=$left
  fi
  if [[ $lifts != "$told" ]]; then
    echo "team-ci-wait: $(gh_limit_text "$lifts" "$resource" "$kind"); waiting for it, then looking again" >&2
    told=$lifts
  fi
  sleep "$seconds"
  elapsed=$((elapsed + seconds))
}
# hold_rules: with --merge-group, read the base's rules (base_rules, on the login this runs on),
# once, at the wait's start, and add every context they require but agent-review, which team-land
# posts itself, to the required checks, keeping those in rules_required; a read that fails is said
# on one line on stderr, and the registry's required checks alone are held.
rules_required='[]' rules_read=false
hold_rules() {
  local rules
  rules_read=true
  if rules=$(base_rules "$repo" "$base" 2>"$dir/rules.error"); then
    rules_required=$(jq -c '[.required[].context | select(. != "agent-review")] | unique' <<<"$rules")
    required=$(jq -c --argjson rules "$rules_required" '. + ($rules - .)' <<<"$required")
  else
    echo "team-ci-wait: $base's rules on $repo could not be read, so only the registry's required checks are held: $(grep -m1 . "$dir/rules.error" || echo "no reason given")" >&2
  fi
}

# unreported: with --merge-group, the required checks but agent-review that no check of the look
# lists, in any state, as a JSON array; [] otherwise.
unreported() {
  if [[ -z $group ]]; then echo '[]'; return; fi
  jq -c --argjson required "$required" '[.checks[].name] as $listed
    | [$required[] | select(. != "agent-review" and (IN($listed[]) | not))]' "$dir/look"
}

# stood: keeps the clock of the reading now standing, the names of the look's checks, and succeeds
# once it has stood for SETTLE_SECONDS of looks; a new name restarts it.
stood() {
  local names
  names=$(jq -c '[.checks[].name] | sort' "$dir/look")
  if [[ $names != "$settled_on" || -z $settled ]]; then
    settled_on=$names settled=0
  else
    settled=$((settled + slept))
  fi
  ((settled >= SETTLE_SECONDS))
}

# next_look: the deadline's end, then the pause before the next look.
next_look() {
  # A reading standing at the deadline gets its 2 minutes, which bounds the wait all the same.
  if ((elapsed >= $(deadline_at))); then
    if [[ -s $dir/look ]]; then
      finish deadline 75 "team-ci-wait: $(span "$DEADLINE_SECONDS"), and checks still pending on ${first_head:0:7}: $(pending_text): $again_wait, or report BLOCKED"
    fi
    finish unreadable 75 "team-ci-wait: $(span "$DEADLINE_SECONDS"), and GitHub not read yet: $(cat "$dir/error"): $again_unread, or report BLOCKED"
  fi
  pause
}

# The stuck and queued clocks, which tick keeps by nameref, and the names that ran theirs out.
# shellcheck disable=SC2034
declare -A stuck_looks=() queued_looks=()
stuck=() queued=() stuck_json='[]' queued_json='[]'
while :; do
  if hold=$(offline_hold); then
    finish offline 75 "team-ci-wait: $hold"
  fi
  sleep_limit
  [[ -z $group ]] || $rules_read || hold_rules
  read_rc=0
  read_look || read_rc=$?
  if ((read_rc == 0)); then
    failing=''
    { read -r state && read -r head; } < <(jq -r '.state, .head' "$dir/look")
    if [[ -z $first_head ]]; then
      if [[ -n $run_id && $head != "$expected"* ]]; then
        # A run's head never changes, so there is no grace.
        finish other-head 1 "team-ci-wait: the run $run_id is of ${head:0:7}, not ${expected:0:7}"
      fi
      if [[ $head != "$expected"* ]]; then
        if [[ $state != OPEN ]]; then
          finish closed 1 "team-ci-wait: $repo#$number is ${state,,}: its checks no longer matter"
        fi
        if ((elapsed >= GRACE_SECONDS)); then
          finish other-head 1 "team-ci-wait: the head of $repo#$number is ${head:0:7}, not ${expected:0:7}, after $(span "$GRACE_SECONDS") of looks: it is another commit, and its checks are not the ones to wait on; if ${head:0:7} is not your own, report it to the coordinator"
        fi
        # GitHub may not show the push yet: look again.
        pause grace
        continue
      fi
      first_head=$head
      if [[ -n $run_id ]]; then
        $json || $look || echo "team-ci-wait: waiting on CI run $run_id of $repo at ${head:0:7}"
      else
        $json || $look || echo "team-ci-wait: waiting on the checks of $repo#$number${group:+, on its trial commit,} at ${head:0:7}"
      fi
    fi
    if [[ $state != OPEN ]]; then
      finish closed 1 "team-ci-wait: $repo#$number is ${state,,}: its checks no longer matter"
    fi
    if [[ $head != "$first_head" ]]; then
      finish moved 1 "team-ci-wait: the head of $repo#$number moved from ${first_head:0:7} to ${head:0:7}: the new head's checks need a wait of their own"
    fi
    if [[ -n $group ]]; then
      entry=$(jq -r .entry "$dir/look")
      if [[ $entry != "$group" ]]; then
        # The queue gave this commit up: a failed check is why, and the rest it cancelled or left,
        # which count as reported. A required check none lists is held for the settle first.
        if jq -e 'any(.checks[]; .bucket == "fail")' "$dir/look" >/dev/null; then
          unseen=$(unreported)
          if [[ $unseen != '[]' ]] && ! stood; then
            next_look
            continue
          fi
          jq '.checks |= map(select(.bucket != "cancel" and .bucket != "pending")) | .open_runs = []' "$dir/look" >"$dir/look.left"
          mv "$dir/look.left" "$dir/look"
          stuck_json='[]' queued_json='[]'
          report "$unseen"
          finish failed 1 "$text"
        fi
        finish other-head 1 "team-ci-wait: the queue entry of $repo#$number is no longer on the trial commit ${group:0:7}: $(if [[ -n $entry ]]; then echo "its trial commit is now ${entry:0:7}, whose checks need a wait of their own"; else echo "the PR is not in the merge queue"; fi)"
      fi
    fi
    $look && look_end
    # The clocks: a pending check whose run completed is stuck, and one of an Actions run still
    # open, pending in any state but in_progress, is queued, from the first readable look that saw
    # it; the queued clocks count only the looks at which nothing else of the repository runs, since
    # a check queued while something runs may only be waiting for a runner.
    tick stuck_looks "$STUCK_SECONDS" '.bucket == "pending" and .run.status == "completed"' stuck "$slept"
    tick queued_looks "$QUEUED_SECONDS" \
      '.bucket == "pending" and .state != "in_progress" and .run != null and .run.status != "completed"' queued \
      "$(jq -r --argjson slept "$slept" 'if .busy then 0 else $slept end' "$dir/look")"
    stuck_json=$(jq -cn '$ARGS.positional' --args "${stuck[@]}")
    queued_json=$(jq -cn '$ARGS.positional' --args "${queued[@]}")
    # What this look says with nothing left to wait on: "failed" now, or "settled" for a reading
    # that must stand. Nothing at all while a check is pending or a run open, but a stuck or a
    # queued check and a queued one's run.
    if result=$(jq -re --argjson stuck "$stuck_json" --argjson queued "$queued_json" '
      [.checks[] | select(.name | IN($queued[])) | .run.id] as $queued_runs
      | if any(.open_runs[]; .id | IN($queued_runs[]) | not)
        or any(.checks[]; .bucket == "pending" and (.name | IN($stuck[], $queued[]) | not)) then empty
      elif all(.checks[]; .bucket == "pass" or .bucket == "skipping") then "settled"
      else "failed" end' "$dir/look"); then
      if [[ $result == failed ]]; then
        # With --merge-group, a required check no check lists is named too, once the reading has
        # stood for the settle, since GitHub may list a run late.
        unseen=$(unreported)
        if [[ $unseen == '[]' ]] || stood; then
          report "$unseen"
          finish failed 1 "$text"
        fi
      elif stood; then
        names=$settled_on
        # With --run, a run of another workflow than the project's branch_ci answers for its own
        # jobs alone: the required checks are branch_ci's.
        wanted=$required
        if [[ -n $run_id && -n $branch_ci ]] &&
          ! jq -e --arg path ".github/workflows/$branch_ci" '.path == $path' "$dir/wf-run" >/dev/null 2>&1; then
          wanted='[]'
        fi
        unlisted=$(jq -c --argjson required "$wanted" '[.checks[].name] as $listed
          | [$required[] | select(. != "agent-review" and (IN($listed[]) | not))]' "$dir/look")
        if [[ $unlisted != '[]' ]]; then
          report "$unlisted"
          finish failed 1 "$text"
        fi
        if [[ $names == '[]' && -n $run_id ]]; then
          finish none 0 "$(no_job_text)"
        elif [[ $names == '[]' ]]; then
          finish none 0 "team-ci-wait: ${head:0:7} has no GitHub checks: none reported for $((SETTLE_SECONDS / 60)) minutes"
        fi
        finish passed 0 "$(passed_text)"
      fi
    else
      settled='' settled_on=''
    fi
  elif ((read_rc == 3)); then
    # A refusal for the limit is no failure to read: the next look finds the limit standing. With
    # --look that is at once, with no look interval first: it sleeps the limit out or ends.
    limited_until=${GH_LIMIT_UNTIL:-}
    if $look && gh_limit_record "${limits[@]}" >/dev/null; then continue; fi
  else
    if [[ -z $failing ]]; then failing=0; else failing=$((failing + slept)); fi
    if ((failing >= failing_limit)); then
      finish unreadable 75 "team-ci-wait: GitHub could not be read for $(span "$failing_limit") running: $(cat "$dir/error")"
    fi
  fi
  next_look
done
