#!/usr/bin/env bash
# PreToolUse hook that keeps a machine that lost the lease from acting: exit 2 blocks the tool
# call and shows stderr to the agent; exit 0 passes it.
#
# Usage: lease-fence [--coordinator | --assistant]   (the hook's input on stdin; the session's
#   role on its Bash, and the assistant's on its Discord tools too, for its own texts)
#   Discord (the coordinator's and the assistant's reply, react and edit_message), and a Bash
#     command of any role that runs team-post, team-ask or team-inbox: blocked while this
#     machine is fenced, or when the lease on origin is not this machine's last write and names
#     another holder or a higher epoch, so an old coordinator, assistant or worker never posts in
#     the channel the new one owns, even before its heartbeat fences it (lease_refusal in
#     bin/lib/team.sh, which team-post runs itself too: origin asked at most once a minute;
#     unreachable passes, since the heartbeat owns offline).
#   Bash, a command of any role that runs team-answer (which logs Daniel's answer), team-thread
#     wait (an interview's read of Discord) or team-thread archive (which archives the team's
#     Discord threads): blocked as a post is, with what such a machine does instead.
#   Bash (workers): a command that runs git push is blocked while this machine is fenced; while
#     the team holds offline, one that runs git push, gh, gh-axi, team-ci-wait, team-ci-run or
#     team-thread wait is blocked with the hold (offline_hold: "GitHub is unreachable (since
#     13:05); the team is holding: ..."), so no worker retries or waits on.
#   Bash (the coordinator, --coordinator): a command that runs git push, team-merge, team-land,
#     team-catch-up, team-open or team-close is blocked as a Discord post is, so a coordinator
#     left running on a machine that lost the lease merges, opens, closes and pushes nothing while
#     the holder's does.
#   Bash (the assistant, --assistant): a command that runs git push, team-assistant or
#     team-current is blocked as a Discord post is, saying another machine runs the team, so an
#     assistant left on a machine that lost the lease pushes, hands off and keeps no list; while
#     the team holds offline, one that runs git push, gh or gh-axi is blocked with its own hold
#     (offline_hold assistant: "GitHub is unreachable (since 13:05); the team is holding: keep
#     talking with Daniel, ..."), the text its session-start digest gives.
#     Its Discord posts, and its team-post, team-ask and team-inbox, are blocked as every role's,
#     saying the assistant on the holder answers #assistant.
# What a Bash command runs is read by bin/lib/fence_rules.py, through command_text.py's walk of
# each simple command of the call, as bin/hooks/command-guard reads one: past the wrappers (env,
# command, timeout, xargs and the rest), into a string a shell's -c or eval runs, what is piped
# into a shell, a substitution, a group and a function's body, by the command's name without its
# directory or quotes, and for git push past git's own options (git -C <dir> push). So a call that
# only names one of them passes: in a heredoc's body no shell reads, a quoted argument, a commit
# message or a search pattern, or that only looks one up (command -v gh). A git push is read
# among any command's later words too (strace git push, ssh host git push, $(echo git push)), so
# an unquoted mention is refused (echo then git push >> notes.md) and a quoted one passes; and a
# held command is read in each line of a substitution whose output eval runs. Not seen, as that
# file's header lists: a name built by a substitution or held in a variable, and a held command in
# one quoted word that something else runs (c='git push'; $c, git rebase -x 'git push', python3
# -c, ssh host 'git push'), each of which passes; gh behind a command the walk knows as no
# wrapper; and a function, alias or script that runs one.
# A command holding none of gh, push and team-, with its quotes and backslashes removed too, and
# no $'...' or brace expansion that may spell one, passes without the reader.
# Reads, in ~/.local/state/agent-team/: fenced (team-lease's), offline (team-timers run's,
# through offline_hold in bin/lib/team.sh), and what lease_refusal reads there.
# When it cannot decide it refuses, saying so, as a guard does: input that is not a JSON object
# with a tool_name string; a call the lease decides (each above but a worker's git push, gh,
# team-ci-wait and team-ci-run and the assistant's gh, which read only the fence and the offline
# hold) on a machine that names no team home, whose lease it cannot read; a wrong argument on its
# command line, which so blocks every call; a Bash command the reader fails on, naming its error;
# and any command of its own that fails, which ends as
# an exit 2 naming the hook and the exit code (team_guard in bin/lib/team.sh). What passes on
# purpose:
# the lease part with origin unreachable, or with no machine name or no origin (the fence alone
# decides then), since the heartbeat owns offline and fences a machine once it finds the lease
# lost, and refusing there would stop the coordinator's posts whenever GitHub is down.
set -euo pipefail
# A guard decides or refuses (bin/lib/team.sh); it reads the lease from the team home, and with
# none it refuses each call the lease decides, itself.
# shellcheck disable=SC2034 # read by bin/lib/team.sh
team_guard=lease-fence team_home_report=1
source "$(dirname "${BASH_SOURCE[0]}")/../lib/team.sh" "$@"

role=worker
case $#:${1:-} in
  0:) ;;
  1:--coordinator) role=coordinator ;;
  1:--assistant) role=assistant ;;
  # A wrong argument in the settings blocks every call the hook sees, the fail-closed side.
  *) usage_error "usage: lease-fence [--coordinator | --assistant]" ;;
esac

# What a guard that cannot decide tells the agent.
CANNOT="a guard that cannot decide refuses, so report it as BLOCKED and do not reach it another way."

block() {
  echo "Blocked: $1" >&2
  exit 2
}

input=$(cat)
tool=$(jq -er 'if type == "object" then .tool_name | strings else empty end' <<<"$input" 2>/dev/null) ||
  block "lease-fence could not read the hook's input (JSON with a tool_name); $CANNOT"
machine=$(machine_name 2>/dev/null) || machine="this machine"
# Why the lease cannot be read, with no team home to read it from, or nothing.
homeless=$TEAM_HOME_PROBLEM
[[ -n $homeless || -d $TEAM_HOME ]] || homeless="the team home $TEAM_HOME is not a directory"

# What a machine that may not post does not do, for lease_refusal.
POSTS="posts nothing to Discord; the coordinator on the holder answers there."
[[ $role != assistant ]] || POSTS="posts nothing to Discord; the assistant on the holder answers #assistant."
# What one that may not log Daniel's answer does not do, as team-answer says it.
ANSWERS="logs no answer; the coordinator on the holder takes Daniel's answers."
# What one that may not wait on an interview does not do, as team-thread wait says it.
WAITS="waits on no interview; stop, since the coordinator on the holder takes the task on."
# What one that may not archive threads does not do, as team-thread archive says it.
ARCHIVES="archives no thread; the coordinator on the holder does."

# Block when this machine may not <does> (lease_refusal), or when it cannot tell, with no team
# home: lease_block <does>
lease_block() {
  [[ -z $homeless ]] || block "lease-fence cannot tell whether $machine holds the lease, since $homeless; $CANNOT"
  why=$(lease_refusal "$1") && block "$why"
  return 0
}

case $tool in
  mcp__plugin_discord_discord__reply | mcp__plugin_discord_discord__react | mcp__plugin_discord_discord__edit_message)
    lease_block "$POSTS"
    ;;
  Bash)
    command=$(jq -r '.tool_input.command // empty | strings' <<<"$input")
    # A command naming none of the reader's words, as written or with its line continuations, the
    # $ of each $"...", its quotes and its backslashes removed (g''h, pu\sh), runs none of them,
    # so it passes with no Python run; one that may spell a name otherwise, by a $'...' escape or
    # a brace list or range, always goes to the reader, as in bin/hooks/command-guard.
    stripped=${command//\\$'\n'/}
    stripped=${stripped//\$\"/\"}
    text=$command$'\n'${stripped//[\'\"\\]/}
    [[ $text == *gh* || $text == *push* || $text == *team-* ||
      $command == *"\$'"* || $command == *\{*,*\}* || $command == *\{*..*\}* ]] || exit 0
    # The classes of command the call runs, one per line (bin/lib/fence_rules.py); an error of the
    # reader's own is its last line.
    classes=$(python3 -I "$TEAM_LIB/fence_rules.py" <<<"$input" 2>&1) ||
      block "lease-fence could not read the command (${classes##*$'\n'}); $CANNOT"
    # Whether the call runs a command of the class: runs <class>
    runs() { [[ $'\n'$classes$'\n' == *$'\n'"$1"$'\n'* ]]; }
    if runs post; then
      lease_block "$POSTS"
    fi
    if runs answer; then
      lease_block "$ANSWERS"
    fi
    if runs wait; then
      lease_block "$WAITS"
    fi
    if runs archive; then
      lease_block "$ARCHIVES"
    fi
    if [[ $role == coordinator ]]; then
      if runs push || runs team_write; then
        lease_block "pushes, merges, opens and closes nothing; the coordinator on the holder does."
      fi
    elif [[ $role == assistant ]]; then
      if runs push || runs assistant_write; then
        lease_block "pushes, hands off and keeps no list; another machine runs the team now, and the assistant there takes Daniel's messages."
      fi
      if { runs push || runs gh; } && hold=$(offline_hold assistant); then
        block "$hold"
      fi
    elif why=$(fence_reason); then
      ! runs push ||
        block "$machine is $why: a fenced machine pushes nothing; commit locally and stop."
    elif hold=$(offline_hold); then
      if runs push || runs gh || runs ci_wait || runs wait; then
        block "$hold"
      fi
    fi
    ;;
esac
exit 0
