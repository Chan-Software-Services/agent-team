#!/usr/bin/env bash
# SessionStart hook for the assistant: on start, resume, clear or compaction, print what it left
# and what to do first, so a restarted or compacted assistant picks its conversations up again.
# Claude Code adds what it prints to the session's context. In order:
#   - while the team holds offline, one line (offline_hold assistant in bin/lib/team.sh, the text
#     the lease-fence hook blocks the assistant's GitHub calls with): keep talking with Daniel and
#     touch no GitHub;
#   - when DISCORD_STATE_DIR (the settings' env) is not ~/.claude/channels/discord-assistant, a
#     WARNING line: the Discord plugin may be reading the coordinator's channels, so post nothing;
#   - the team home's assistant/handoff.md, its stow note, when there is one, under a line saying
#     to delete it once its work is done;
#   - the hand-offs open to and from it (team-assistant list --open), or a line saying none is;
#     a list that fails is said, and the digest goes on;
#   - its list of current items (team-current list --list assistant), each item whose review date
#     has come (team-current due --list assistant) marked "DUE ", or a line saying it is empty; a
#     read that fails is said, and the digest goes on;
#   - the catch-up step: read #assistant and each thread of its still open back to its own last
#     message with the plugin's fetch_messages, and answer first what Daniel asked unanswered,
#     with the ids of the thread cache (ASSISTANT_THREADS in bin/lib/team.sh), so the
#     assistant need not read the file;
#   - on any start but compact (read from the event's JSON on stdin, and when it cannot be read),
#     one ListAgents call: a row named assistant but this session is a twin to tell Daniel of; a
#     compaction keeps the process, so it does not.
# Exit 0, but non-zero when a command of its own fails (the stow note's read)
# and when the library refuses, with no team home. Wired only in assistant.settings.json.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/team.sh" "$@"

errors=$(team_mktemp)

event=''
[[ -t 0 ]] || event=$(cat)
start_source=$(jq -r '.source | strings' 2>/dev/null <<<"$event") || start_source=''

# The hold, one line, while the team holds offline: the text the lease-fence hook blocks with.
! hold=$(offline_hold assistant) || echo "$hold"

# The plugin's state directory: the assistant's own, or a loud line.
own=$HOME/.claude/channels/discord-assistant
if [[ -z ${DISCORD_STATE_DIR:-} || $(realpath -m "$DISCORD_STATE_DIR") != "$(realpath -m "$own")" ]]; then
  echo "WARNING: DISCORD_STATE_DIR is ${DISCORD_STATE_DIR:-unset}, not $own: the Discord plugin may be" \
    "reading the coordinator's channels: post nothing, and tell Daniel in #coordinator through the" \
    "coordinator (a note hand-off)."
fi

# The stow note.
note=$TEAM_HOME/assistant/handoff.md
if [[ -e $note ]]; then
  echo "Your stow note, from your last stow ($note): delete it once its work is done."
  cat "$note"
fi

# The open hand-offs, both ways.
status=0
open=$(TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-assistant" list --open </dev/null 2>"$errors") || status=$?
if ((status)); then
  echo "team-assistant list --open failed (exit $status), so the open hand-offs are unknown: run it by" \
    "hand.$([[ -s $errors ]] && printf ' It said: %s' "$(grep -m1 . "$errors")")"
elif [[ -n $open ]]; then
  echo "The hand-offs open to and from you (team-assistant list --open); read each with team-assistant show H<n>:"
  printf '%s\n' "$open"
else
  echo "No hand-off is open to or from you (team-assistant list --open)."
fi

# The assistant's list, each due item marked.
status=0
items=$(TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-current" list --list assistant </dev/null 2>"$errors") || status=$?
((status)) ||
  due=$(TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-current" due --list assistant </dev/null 2>"$errors") || status=$?
if ((status)); then
  echo "team-current failed (exit $status), so your list is unknown: run team-current list and team-current due by" \
    "hand.$([[ -s $errors ]] && printf ' It said: %s' "$(grep -m1 . "$errors")")"
elif [[ -n $items ]]; then
  echo "Your list (team-current list), each item whose review date has come marked DUE: done each that is" \
    "done, and renew one that still stands with team-current renew <id> --review --reason <why>:"
  while IFS= read -r item; do
    if grep -qxF -- "$item" <<<"$due"; then echo "DUE $item"; else echo "$item"; fi
  done <<<"$items"
else
  echo "Your list is empty (team-current list)."
fi

# The catch-up step, with the thread cache's ids, so the assistant need not read the file.
known=none
[[ ! -s $ASSISTANT_THREADS ]] || known=$(grep -E '^[0-9]+$' "$ASSISTANT_THREADS" | paste -sd ' ' | sed 's/ /, /g') || known=none
echo "Catch up on Discord before anything else: messages sent while no assistant listened are" \
  "never delivered to you, only readable. Read #assistant (${ASSISTANT_CHANNEL:-no channel set})" \
  "and each thread of yours still open (your stow note's, and of the threads found so far:" \
  "${known:-none}) back to your own last message there with the Discord plugin's fetch_messages," \
  "which reads at most 100 messages, and answer first what Daniel asked that has no answer."

# The twin step, on any start but a compaction.
if [[ $start_source != compact ]]; then
  echo "Call ListAgents once now, since no script can list a Remote Control session: a row named" \
    "assistant but this session (the one ListAgents says you are) is an assistant twin, which hears" \
    "#assistant beside you. Tell Daniel in #assistant where it runs (this machine or Remote" \
    "Control), and stop nothing yourself."
fi
exit 0
