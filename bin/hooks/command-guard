#!/usr/bin/env bash
# PreToolUse hook on the Bash of a worker, of the assistant and of a gate's agents, that
# refuses a guarded thing a command runs, never for its name inside an argument, a commit message,
# a search or a file's text: exit 2 blocks the call and shows the agent "Blocked by command-guard:
# <the rule>; a guardrail, so report it as BLOCKED and do not reach it another way." on stderr;
# exit 0 passes it. A rule that names an allowed way shows "Blocked by command-guard: <the rule>;
# the allowed way: <the way>. A guardrail: report it as BLOCKED, saying you took the allowed way,
# and go on only by that way." to a worker (AGENT_TEAM_ROLE builder, planner, reviewer or ops,
# the roles whose prompts say to go on by it), and "... <the way>. A guardrail: do not reach it
# another way." to any other session: one with no role, as a gate agent has, and the assistant,
# whose role stops that line of work. The kill and delete rows judge the assistant's calls as a
# worker's, with its directory, the team home, as its worktree.
#
# Usage: command-guard   (the hook's input on stdin)
#
# Input it cannot read is refused, naming why: not JSON, no tool_name, or a Bash call whose
# tool_input.command is missing or not a string. Another tool's call passes, and so does a command
# naming none of team-worker, team-load-check, ui-capture, AGENT_TEAM_, GH_CONFIG_DIR, GH_TOKEN,
# GITHUB_TOKEN, --steal, team-ask, team-answer, team-inbox, team-thread, team-run-approved, curl,
# wget, kill (pkill, killall and tmux's kill-server among it), fuser, -delete, push with an f after
# a dash or a +, .config/agent-team, .claude/channels, discord and rm as a word of its own (git rm
# among it), nor env or exec before an option, nor, for the assistant alone (AGENT_TEAM_ROLE
# assistant), the coordinator's acts' names (team-checkpoint, team-handoff, team-ops-end,
# team-records-rewrite, team-resume, team-review-comment, team-stow, claude-coordinator,
# team-capacity, team-config, team-heavy, team-lease, team-quota, team-secrets, team-stack and
# team-timers), gh or gh-axi as a word, as written or with its quotes and backslashes removed
# (pk''ill, r\m), and
# holding no $', no brace list or range ({,} or {..}), and no printf or echo with a > or tee, by
# which a name may be spelled otherwise, at once, with no Python run. Any other is decided by one
# rule table, bin/lib/command_rules.py, run once on the hook's input: it walks each simple command
# the call runs (past its wrappers, into the strings its shells, eval, su, script, env -S, flock -c,
# watch, parallel and find -exec run, and a shell's script or a sourced file by its name), and
# prints the first row that refuses one, in its table's order: an ops launch, the frontend toolkit's
# capture script, an assignment or an unset of AGENT_TEAM_ROLE or AGENT_TEAM_TASK, an assignment or
# an unset of GH_CONFIG_DIR, GH_TOKEN or GITHUB_TOKEN (the session's GitHub login), a team script
# run with its environment emptied, a lease steal, the coordinator's commands (but the assistant's
# first --help or -h of each and its team-inbox --item <n>), the assistant's run of one of the
# coordinator's acts (any but a first --help or -h), the assistant's GitHub write by gh or gh-axi
# (gh api with a writing method, a body, a field with no GET or HEAD, or a GraphQL call that is no
# query it can read; any other group or subcommand that is no read, an unknown group among them), an
# upload of a file or body to a host outside the team's own (as bin/lib/outbound.py reads it), a
# worker's or the assistant's force push or cd into the team's keys' or the Discord bot's
# directories, a kill that reaches what is not the session's own (by name or pattern, tmux's kill-*,
# of PIDs read from input, of a PID it cannot read, of a process group, of a literal PID whose
# process is not proven its own; bin/lib/kill_rules.py), and a recursive delete that reaches what is
# not the worker's own (outside the worktree and the job's tmp, either of them or its .scratch/task,
# a repository's .git, a variable left empty, a find with no start path, or a path it cannot read
# before it runs; bin/lib/delete_rules.py), and last any other command run with its environment
# emptied, which drops the session's GitHub login. The hook refuses with that row's reason, and its
# allowed way when it names one, and for a call of more than one line a second line naming the line
# the refused command stands on when one holds it, and a heredoc that ended before it ("It stands on
# line <n> of the call: <the line>...", command_rules.py's where); command_rules.py's header holds
# each row's wording, what the guard does not see, and in its Contract paragraph what the kill and
# delete rows promise and what they leave to a kernel layer. It fails closed: when command_rules.py
# exits non-zero, the call is refused with "it could not check the command for an upload
# (bin/lib/outbound.py: <the error>)" when the upload row raised, else "it could not read the
# command (bin/lib/command_rules.py: <its last stderr line>)", and so, naming its last line, when
# what it prints holds no reason. It reads nothing of the team home, so it decides on a machine that
# names none. A wrong argument on its command line refuses every call, and any command of its own
# that fails ends as an exit 2 naming the hook and the exit code (team_guard in bin/lib/team.sh): a
# guard that cannot decide refuses.
set -euo pipefail
# A guard decides or refuses (bin/lib/team.sh), and reads nothing of the team home, so it decides
# on a machine that names none.
# shellcheck disable=SC2034 # read by bin/lib/team.sh
team_guard=command-guard team_home_report=1
source "$(dirname "${BASH_SOURCE[0]}")/../lib/team.sh" "$@"

# A wrong argument in the settings blocks every call the hook sees, the fail-closed side.
[[ $# -eq 0 ]] || usage_error "usage: command-guard   (the hook's input on stdin)"

# Refuse with <reason>, and the allowed way when one is given, and where the refused command
# stands on a second line when given: block <reason> [<allowed> [<where>]]
block() {
  if [[ -z ${2:-} ]]; then
    echo "Blocked by command-guard: $1; a guardrail, so report it as BLOCKED and do not reach it another way." >&2
  elif [[ ${AGENT_TEAM_ROLE:-} == @(builder|planner|reviewer|ops) ]]; then
    echo "Blocked by command-guard: $1; the allowed way: $2. A guardrail: report it as BLOCKED, saying you took the allowed way, and go on only by that way." >&2
  else
    echo "Blocked by command-guard: $1; the allowed way: $2. A guardrail: do not reach it another way." >&2
  fi
  [[ -z ${3:-} ]] || echo "$3" >&2
  exit 2
}

input=$(cat)
tool=$(jq -er 'if type == "object" then .tool_name | strings else empty end' <<<"$input" 2>/dev/null) ||
  block "it could not read the hook's input (JSON with a tool_name)"
[[ $tool == Bash ]] || exit 0
command=$(jq -er '.tool_input.command | strings' <<<"$input" 2>/dev/null) ||
  block "it could not read the Bash call's command (tool_input.command, a string)"
# The trigger words are matched on the command and on it with its line continuations, the $ of
# each $"...", its quotes and its backslashes removed, so a name split by them (pk''ill, r\m, pk$""ill,
# a backslash-newline) is read; a call that may spell a name otherwise, by a $'...' escape, a brace
# list or a script printf or echo writes or pipes, always goes to Python.
stripped=${command//\\$'\n'/}
stripped=${stripped//\$\"/\"}
text=$command$'\n'${stripped//[\'\"\\]/}
# The assistant's own trigger words, the coordinator's acts its assistant-acts row refuses, and gh
# and gh-axi, whose every call its assistant-github-write row reads; a worker's fast path never
# reads them.
assistant_words=
[[ ${AGENT_TEAM_ROLE:-} != assistant ]] ||
  assistant_words='team-(checkpoint|handoff|ops-end|records-rewrite|resume|review-comment|stow|capacity|config|heavy|lease|quota|secrets|stack|timers)|claude-coordinator|(^|[^[:alnum:]_.-])gh(-axi)?([^[:alnum:]_.-]|$)'
[[ $text == *team-worker* || $text == *team-load-check* || $text == *ui-capture* ||
  $text == *AGENT_TEAM_* || $text == *GH_CONFIG_DIR* || $text == *GH_TOKEN* || $text == *GITHUB_TOKEN* ||
  $text == *--steal* || $text == *team-ask* || $text == *team-answer* ||
  $text == *team-inbox* || $text == *team-thread* || $text == *team-run-approved* ||
  $text == *curl* || $text == *wget* || $text == *kill* || $text == *fuser* || $text == *-delete* ||
  ($text == *push* && ($text == *-*f* || $text == *+*)) ||
  $text == *.config/agent-team* || $text == *.claude/channels* || $text == *discord* ||
  $text =~ (^|[^[:alnum:]_.-])rm([^[:alnum:]_.-]|$) ||
  $text == *env*[[:space:]]-* || $text == *exec*[[:space:]]-* ||
  (-n $assistant_words && $text =~ $assistant_words) ||
  $command == *"\$'"* || $command == *\{*,*\}* || $command == *\{*..*\}* ||
  (($text == *printf* || $text == *echo*) && ($command == *'>'* || $command == *'|'* || $text == *tee*)) ]] ||
  exit 0

# The rule table's one line names the first row that refuses; an error of its own, or a row's,
# is its last line, the upload row's naming outbound.py.
rules=$(python3 -I "$TEAM_LIB/command_rules.py" <<<"$input" 2>&1) || {
  last=${rules##*$'\n'}
  [[ $last != upload:* ]] ||
    block "it could not check the command for an upload (bin/lib/outbound.py: ${last#upload: })"
  block "it could not read the command (bin/lib/command_rules.py: $last)"
}
[[ -n $rules ]] || exit 0
reason=$(jq -er '.reason | strings' <<<"$rules" 2>/dev/null) ||
  block "it could not read the command (bin/lib/command_rules.py: ${rules##*$'\n'})"
allowed=$(jq -r '.allowed // empty | strings' <<<"$rules" 2>/dev/null) ||
  block "it could not read the command (bin/lib/command_rules.py: ${rules##*$'\n'})"
where=$(jq -r '.where // empty | strings' <<<"$rules" 2>/dev/null) ||
  block "it could not read the command (bin/lib/command_rules.py: ${rules##*$'\n'})"
block "$reason" "$allowed" "$where"
