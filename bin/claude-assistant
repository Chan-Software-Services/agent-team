#!/usr/bin/env bash
# Start the assistant: the long-lived session Daniel talks to in #assistant on Discord, beside the
# coordinator, which keeps the tasks, the workers, the ledger and the merges.
#
# It hears only #assistant (ASSISTANT_CHANNEL in bin/lib/team.sh) and the threads under it,
# through a Discord state directory of its own, ~/.claude/channels/discord-assistant/ (mode 700),
# which its settings name to the Discord plugin as DISCORD_STATE_DIR, with DISCORD_ACCESS_MODE
# static, so the access file is pinned at boot and no pairing or /discord:access edit changes it.
# Each launch writes it: .env, a symlink to ../discord/.env, so the one bot token is never copied;
# and access.json, written whole, with no DM reaching the assistant (dmPolicy allowlist, an empty
# top-level allowFrom) and one group, #assistant, heard without a mention from Daniel's ids alone
# (the top-level allowFrom of the coordinator's ~/.claude/channels/discord/access.json).
#
# Bypass mode, by Daniel's choice. Its settings are assistant.settings.json with @TEAM_CODE@
# naming this checkout, @TEAM_HOME@ the team home and @DISCORD_STATE_DIR@ that directory, written
# to ~/.local/state/agent-team/assistant.settings.json: every deny rule of the coordinator's on a
# command or a path but those its command-guard hook holds command by command (its GitHub login, a
# force push and a cd into ~/.config/agent-team), so deny rules stop the plain spelling of a force
# push, a push to dev or main, git reset --hard, git clean, git branch -D, a Docker prune and a
# merge outside team-merge, by the workers' own rules and its own git push * (tests/repo.bats
# holds the three together), and besides them the Discord token and both access files, any git
# push and git commit, the gh pr and gh issue writes they name, gh repo create, delete and edit,
# team-land, and starting or stopping a session. Its command-guard hook's assistant-acts row
# refuses its run of the coordinator's acts (a hand-off, a stow, a resume, a lease change, a load
# check, a stack's start or stop, a timer's change, a config apply and the rest), command by
# command, as each act script but team-heavy does itself (assistant_refusal), so it still reads
# each script's file and runs its --help; its assistant-github-write row holds every gh and gh-axi
# call but a read (gh api with a writing method, a body, a field with no GET, a GraphQL mutation
# or a $ in a query, and any group's subcommand outside its reads), so it still reads GitHub; and
# its assistant-thread-cache row holds a call naming the thread cache that is no plain list of
# readers (a redirection, tee, cp, rm, sed -i, an interpreter, a wrapper, an assignment, a loop
# and the rest), so it still reads the cache, whose Edit its settings deny. Its memory is the team
# home's memory/assistant/ (autoMemoryDirectory), not the coordinator's, though both run in the
# team home. Its role prompt is roles/assistant.md, appended to the system prompt. Its MCP config,
# ~/.local/state/agent-team/assistant.mcp.json, names no server, and its settings deny every
# server `claude mcp list` names in the team home but the Discord plugin's, as
# claude-coordinator's do (bin/lib/launch.sh). Its session runs on the worker login when
# bin/lib/worker-login names one, by its settings' env, as the coordinator's does. It runs on the
# user settings' model at their effort, with their Remote Control, as the coordinator does, and
# compacts at 200k tokens by the launch's --autocompact flag, idle from 100k.
#
# It refuses (exit 1), in this order: while another launch holds the non-blocking flock on
# ~/.local/state/agent-team/assistant-launch.lock; while `claude agents --json --all` lists a
# session named assistant in any state but stopped, naming its id, so two sessions never answer
# one message; unless `team-lease check` confirms against origin that this machine holds the
# lease, naming the holder, or saying an assistant never starts offline when GitHub is
# unreachable; with no ASSISTANT_CHANNEL (an empty TEAM_ASSISTANT_CHANNEL); with no bot token in
# ~/.claude/channels/discord/.env; with no Daniel's id readable from the coordinator's
# access.json; while that file has a group for #assistant, since the coordinator would hear it
# too; and while the worker login is named but not on this machine. Each of these comes before its
# Discord state or settings are written.
#
# Usage: claude-assistant [--prompt <text>]   (always in the team home)
#        claude-assistant --load-check <worktree> [--prompt <text>]
#   --prompt      the session's first prompt, in place of "You are the assistant. Daniel talks to
#                 you in #assistant on Discord. Wait for their messages."
#   --load-check  team-load-check's form, for its --probe and --context of the assistant: it
#                 launches T0-assistant in <worktree> with the assistant's settings and role
#                 prompt but the Discord plugin off (its server denied with the others), no
#                 --channels and no Stop or SessionStart hook (assistant-stop and
#                 assistant-digest read the live assistant's list and hand-offs, which this
#                 session must never act on, so --context measures its start without the
#                 digest), and Remote Control off (remoteControlAtStartup false), so it leaves
#                 no row in Daniel's Remote Control list on claude.ai, and prints the session's
#                 id alone, as team-worker does. Its settings and MCP config are
#                 ~/.local/state/agent-team/assistant-load-check.settings.json and .mcp.json, so
#                 the live assistant's stay as they are. It is no assistant, so it takes no
#                 launch lock and none of the refusals above but a malformed command line
#                 (exit 2) and a <worktree> that is no directory, and writes no Discord state.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"
# shellcheck source=bin/lib/launch.sh
source "$TEAM_LIB/launch.sh"

usage="usage: claude-assistant [--prompt <text>] | claude-assistant --load-check <worktree> [--prompt <text>]"
prompt="You are the assistant. Daniel talks to you in #assistant on Discord. Wait for their messages."
load_check='' given=''
while (($#)); do
  [[ $# -ge 2 && -n $2 ]] || usage_error "$usage"
  case $1 in
    --prompt) [[ $given != *p* ]] || usage_error "$usage"; prompt=$2 given+=p ;;
    --load-check) [[ $given != *l* ]] || usage_error "$usage"; load_check=$2 given+=l ;;
    *) usage_error "$usage" ;;
  esac
  shift 2
done
# The role, the settings and the hooks are code: they come from this checkout, beside bin/.
code=$(dirname "$(dirname "$TEAM_LIB")")
state=$HOME/.claude/channels/discord-assistant

# The load check's assistant: the same settings and role prompt, the Discord plugin off and no
# --channels, so it hears and posts nothing, and neither the Stop hook nor the start digest, so
# it is never told to act on the live assistant's list or hand-offs; named T0-assistant, so it is
# no assistant to the singleton check, the fence or the heartbeat. Remote Control is off, outranking
# the user settings' true, so it leaves no row in Daniel's Remote Control list on claude.ai.
if [[ -n $load_check ]]; then
  [[ -d $load_check ]] || die "no worktree at $load_check for the load check's assistant"
  cd "$load_check"
  mcp=$LAUNCH_STATE/assistant-load-check.mcp.json
  settings=$LAUNCH_STATE/assistant-load-check.settings.json
  mkdir -p "$LAUNCH_STATE"
  template=$(mktemp "$LAUNCH_STATE/assistant-load-check.template.XXXXXX")
  trap 'rm -f -- "$template"' EXIT
  jq '.enabledPlugins["discord@claude-plugins-official"] = false | del(.hooks.Stop, .hooks.SessionStart)
    | .remoteControlAtStartup = false' \
    "$code/assistant.settings.json" >"$template"
  launch_settings "$template" "" "" "$settings" "$mcp" "@TEAM_HOME@=$TEAM_HOME" "@DISCORD_STATE_DIR@=$state"
  out=$(claude --bg --name T0-assistant \
    --autocompact 200k \
    --mcp-config "$mcp" \
    --dangerously-skip-permissions \
    --append-system-prompt-file "$code/roles/assistant.md" \
    --settings "$settings" \
    "$prompt")
  id=$(grep -oE '\b[0-9a-f]{8}\b' <<<"$out" | head -n 1) || die "could not read the session id from: $out"
  echo "$id"
  exit 0
fi
cd "$TEAM_HOME"

launch_lock assistant
launch_singleton assistant
launch_unlocked lease_gate "an assistant"
[[ -n $ASSISTANT_CHANNEL ]] ||
  die "no assistant channel is set (TEAM_ASSISTANT_CHANNEL is empty), so the assistant would hear nothing: unset it to use ASSISTANT_CHANNEL in bin/lib/team.sh"

# The coordinator's Discord state, whose token the assistant's links to and whose ids it hears.
discord=$HOME/.claude/channels/discord
discord_token >/dev/null ||
  die "no DISCORD_BOT_TOKEN in ~/.claude/channels/discord/.env, which the assistant's Discord state links to: run team-secrets check"
daniel=$(jq -ce '.allowFrom | select(type == "array") | map(tostring | select(test("^[0-9]+$"))) | select(length > 0)' \
  "$discord/access.json" 2>/dev/null) ||
  die "cannot read Daniel's Discord ids from the allowFrom of ~/.claude/channels/discord/access.json, so the assistant would hear nobody"
if jq -e --arg c "$ASSISTANT_CHANNEL" '(.groups // {}) | has($c)' "$discord/access.json" >/dev/null; then
  die "the coordinator would hear #assistant too: remove that group with /discord:access group rm $ASSISTANT_CHANNEL in the coordinator"
fi

mcp=$LAUNCH_STATE/assistant.mcp.json
settings=$LAUNCH_STATE/assistant.settings.json
# The settings before the Discord state, since their writer refuses a worker login that is not
# on this machine. No MCP template and no connectors: it runs no server of its own and keeps no
# connector.
launch_settings "$code/assistant.settings.json" "" "" "$settings" "$mcp" \
  "@TEAM_HOME@=$TEAM_HOME" "@DISCORD_STATE_DIR@=$state"

mkdir -p "$state"
chmod 700 "$state"
ln -sfn ../discord/.env "$state/.env"
jq -n --arg channel "$ASSISTANT_CHANNEL" --argjson daniel "$daniel" \
  '{dmPolicy: "allowlist", allowFrom: [],
    groups: {($channel): {requireMention: false, allowFrom: $daniel}},
    pending: {}, ackReaction: "👀", replyToMode: "first", textChunkLimit: 2000, chunkMode: "newline"}' \
  >"$state/access.json.$$"
chmod 600 "$state/access.json.$$"
mv -f "$state/access.json.$$" "$state/access.json"

# Not exec: this shell keeps the lock until claude returns, and the session it starts does not
# inherit the lock's file, so a running assistant never holds the next launch's lock.
claude --bg --name assistant \
  --autocompact 200k \
  --mcp-config "$mcp" \
  --channels plugin:discord@claude-plugins-official \
  --dangerously-skip-permissions \
  --append-system-prompt-file "$code/roles/assistant.md" \
  --settings "$settings" \
  "$prompt" \
  {LAUNCH_LOCK_FD}>&-
