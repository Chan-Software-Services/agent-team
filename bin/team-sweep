#!/usr/bin/env bash
# Find what the coordinator must not leave unattended, from the ledger, the live session list, the
# team's stow plan, the heartbeat's health view, the queue, the current items and the assistant's
# hand-offs.
#
# Usage: team-sweep [--json | --wait]
# Reads only ledger.jsonl, claude agents --json, team-capacity plan --json (from the stored
# readings), team-timers health --json (the health view, from the heartbeat's health record, the
# lease record and the fence file, asked for at most 10 s, and only on a machine with a team
# name), the registry and bin/lib/review-app while an open task awaits merge with its plan approved
# (which projects are the team's own and whether the reviewer App is on, for merge-due, below),
# team-queue list --json --plan <its plan> while tasks/queued/ exists (the queue, the registry and
# team-capacity costs --json), team-current check --json and team-current due --json --list
# coordinator while tasks/current.md exists, team-assistant list --open --to coordinator --json
# while assistant/handoffs.jsonl exists, and, through
# bin/lib/session-activity, the live sessions' transcripts: their modification times, and from a
# session's quiet past the default limit only its times, tool names, tool call ids, commands and
# background task marks (never GitHub, never a tool's output or a message's text, and never a new
# reading of the machine's load), so it runs in about a second.
# A task is open when it has events and no closed; it is parked when its phase is held, blocked
# or awaiting-merge, when it has an ask nothing settled (no answered or merge-preapproved with its
# id, no merge-approved whose url its text names; one that names tickets, team-ask --tickets', only
# while none of the task's work is unfinished, so the work it does not hold is watched, and never
# for ci-due), or when a park (held, blocked, waiting, paused)
# stands in the ledger's lifecycle fold; an ask a launch went past (team-worker --past-ask) and its
# wait park nothing, so that launch's worker is watched; a park of one ticket's builder in a
# parallel phase (one naming the session of a builder in a ticket worktree, T<n>-builder-NN, or
# team-worker's room refusal of its brief-build-NN, or of a relaunch's brief-resume-build-NN,
# while its ticket worktree is open) parks the task only while every running ticket's builder has
# one or a stowed after its launch, so the tickets building beside it are still watched; an
# awaiting-merge task that nothing else parks is merge-due instead while the default merge word,
# the approved plan, holds for one of its PRs and the checks of its pass have passed, and ci-due
# while no wait of those checks has ended, and none of them was rerun, for 100 minutes. Findings,
# one line each with the task, the session and the next step:
#   no-worker      an open task, not parked, with an opened or launch event and no live session
#                  among its launches at work: busy, waiting for input or silent (one idle with a
#                  ledger event since its launch, a denied aside, has handed the next step back;
#                  a ticket's builder is at work until a done of its session or its ticket's
#                  ticket-done), and no ticket-gone;
#                  merged is told to close, and merged-part (a merged naming phases_left, phases
#                  with a ticket not done) to launch the next phase's first ticket's builder
#   waiting-input  a live session of an open task, not parked, whose state is blocked; never a
#                  builder with no dialog open (its status idle, no waitingFor) that delivered: a
#                  pr since its launch, and since the latest one only launches of a reviewer,
#                  what another session logged of itself, an event that opens a park (held,
#                  blocked, waiting, paused) and does not name the builder's session, and a
#                  resumed with no brief after one (no review, ask, answer or builder's launch),
#                  which Claude Code calls blocked for a last summary that says it waits on the
#                  merge, and which is idle with a ledger event since its launch
#   silent         a live, idle session of an open task, not parked, with no ledger event for the
#                  task after that session's latest launch but denied ones (one waiting for input
#                  is not also silent); a ticket's builder by its own events: none since its
#                  launch naming its session or its ticket, and no park of its ticket standing
#   stalled        a live, busy session of an open task, not parked, not waiting for input, whose
#                  transcripts (its own and its subagents', under ~/.claude/projects) have not been
#                  written for longer than its limit (stall_limits in bin/lib/ledger.jq), the
#                  largest of its running calls', each read from its whole command: 180 minutes for
#                  a command with no-mistakes as a word (the gate), 110 for one that runs
#                  team-ci-wait (which ends by about 100), none for one that runs team-thread wait (an
#                  interview's wait on Daniel), else 50, and 50 when none runs. A running call is a
#                  tool call started since the session's startedAt with no result yet, or in the
#                  background with no task notification yet. "<name> <short id> has written nothing
#                  for <h>h<mm>m" (or <m>m under an hour), then ', waiting on "<command>" (Bash, in
#                  the background, running <h>h<mm>m)' for the newest foreground call (it holds the
#                  turn) or else the oldest, "Bash in a subagent" for a subagent's, a tool other
#                  than Bash by its name, and ", and <n> more running" when others run; or " with no
#                  tool call running". None for a session whose transcript cannot be found
#   stowing        an open task whose stowing (a stow under way: team-stow --begin, or a team-stow
#                  run, logged it) has stood 30 minutes with no stowed or stow-failed, whatever
#                  parks it, with session null: "stowing since <its time> (<cause>), with no
#                  stowed; next: run team-stow T<n>, which finishes the stow or logs stow-failed"
#   walk-stale     an open task, parked or not, with session null, whose walk is on with no message
#                  from Daniel for over 4 hours (walk_holds in bin/lib/ledger.jq: since the latest of
#                  its start and its walk-note events), so it no longer keeps its stack up or stows
#                  last: "T<n> walk-stale: its walk has had no message from Daniel since <time>, over
#                  4 hours, ...; next: ask Daniel whether it goes on: if not, team-ui T<n> --walk
#                  stop; if so, team-ui T<n> --walk stop, then team-ui T<n> --walk start", with the
#                  --in interview and --reseeded <a new message of Daniel's> that walk started with
#   merge-due      an open task in awaiting-merge, with no ask nothing settled, no paused or
#                  waiting standing, the checks of its latest pass passed (checks_wait in
#                  bin/lib/ledger.jq, read from the ledger alone: team-next T<n> --ci logged a ci
#                  of outcome passed for the head the pass waits on), no merge-base round in flight (its latest builder launch or
#                  resumed naming a merge-base brief, with no review, caught-up or merged since and
#                  a worker on it live with no done since) and a PR not merged whose default word
#                  holds on the ledger (merge_authority in bin/lib/ledger.jq, the derivation
#                  team-merge and team-state read too: the plan approved and not withdrawn, the
#                  PR's project, its latest pr event's or else the task's opened one's, not the
#                  team's own, by own_project in bin/lib/team.sh, or the team's own on a plan
#                  Daniel approved with the reviewer App on, the default not withdrawn for the
#                  task, its project or every project by the latest merge-default-withdrawn or
#                  merge-default-restored of any task covering it, the task's branch logged, and
#                  the latest review of the latest head the task logged for the PR a pass that
#                  found no guarded area, with no review of the task that counted a security or
#                  real-data finding or left its counts out), with session null:
#                  "awaiting the merge of <those PRs' URLs> on the default word, the approved
#                  plan, with no ask open; next: run team-merge T<n>; on a refusal, ask Daniel for
#                  the per-head word with team-ask", and no other finding of the task's. GitHub,
#                  Discord and the plan's files are not read: team-merge says when a changed path
#                  is guarded or outside the plan's scope, the plan changed since its approval, or
#                  a message does not read back. When the registry cannot be read, no task is
#                  merge-due and a line on stderr says why. A PR that stands in the merge queue
#                  (queue_state in bin/lib/ledger.jq: the task's latest queued, dequeued or merged
#                  of it is a queued, with no other head logged since, by a pr event of the PR
#                  or by any review of the task) is
#                  never named, nor one the queue dropped for a failure of its own, which
#                  trial-failed names, nor any PR of a task whose merge lock a process holds,
#                  which team-merge is landing
#   queue-wait     an open task's PR that stands in the merge queue while no process holds the
#                  task's merge lock, ~/.local/state/agent-team/merge/T<n>.lock, read without
#                  taking it (merge_lock_held in bin/lib/team.sh), with session null: "PR <url> is
#                  in the merge queue since <the queued's time> with no team-merge waiting on it;
#                  next: run team-merge T<n> with Bash run_in_background, which goes on waiting and
#                  logs how it ends", beside the task's other findings
#   trial-failed   an open task in awaiting-merge, with no ask open and nothing parking it and no
#                  merge-base round in flight, whose PR the merge queue dropped for a failure of
#                  its own on the trial merge (its latest queued, dequeued or merged is a dequeued
#                  whose failed holds one of class pr, with no pr event of it and no review since;
#                  queue_state's round_due in bin/lib/ledger.jq), with session null: "PR <url>
#                  failed <checks> on the merge queue's trial merge, which dropped it at <the
#                  dequeued's time>; next: run team-next T<n> --ci, which names the
#                  builder-merge-base step and who takes it, then a rereview; never team-merge
#                  T<n> on the same head", beside the task's other findings
#   ticket-gone    a running ticket of an open task, not parked (its latest launch in its ticket
#                  worktree with no done of its session and no ticket-done of its ticket since),
#                  whose builder's session is not live, with no stowed after that launch and no
#                  park of its ticket standing: "ticket <NN>: its builder T<n>-builder-<NN>
#                  <session> is gone with the ticket not done; next: recover it (the
#                  recover-worker skill)"
#   ticket-worktree-left  an open ticket worktree of an open task, not parked, whose ticket has a
#                  ticket-done since the worktree was added (or moved or rehomed), with no stowed
#                  after that ticket-done and no park of its ticket standing, with session null:
#                  "ticket <NN> is done, but its worktree <path> is still open; next: team-close
#                  T<n> --ticket <NN>"
#   ci-due         after the task's other findings, an open task in awaiting-merge, with no ask
#                  nothing settled and no park standing, whose latest pass's checks_wait is waiting
#                  (no ci logged for the head it waits on) or pending (its latest ci ended at
#                  team-ci-wait's deadline) since 100 minutes or more, counted from the pass,
#                  its catch-up, or the latest ci or ci-rerun of that head, since a rerun starts the
#                  wait again (ci_due_seconds: the deadline's 90, its 2-minute settle, then room),
#                  with session null: "the checks of <url> at <short>
#                  have had no wait end for <h>h<mm>m; next: arm team-next T<n> --ci with Bash
#                  run_in_background unless it is running". It is read from the ledger alone, no
#                  GitHub and no process, so a wait still running past it is the coordinator's to
#                  see in its background commands, and a second one armed beside it says so and
#                  ends (team-next's lock)
#   stray          a live session named like a team worker (T<n>-<role>, or T<n>-<role>-<NN> for
#                  a ticket's builder) whose task is closed or not in the ledger; never one of T0,
#                  the load check's task
#   coordinator-twin  after every task finding, with task null: one for each session named
#                  coordinator in the session list but the one the sweep runs in
#                  (CLAUDE_CODE_SESSION_ID's), when more than one is listed, with session its short
#                  id: "coordinator-twin: coordinator <id> (<kind>, <state or status>, started
#                  <time>) is a second session named coordinator on this machine; next: read claude
#                  logs <id> for anything left to log, then stop it with claude stop <id>" ("ask
#                  Daniel to end it, an interactive session, pid <pid>" for an interactive one, and
#                  "started at an unknown time" for one whose startedAt is not a number); when
#                  CLAUDE_CODE_SESSION_ID names none of them, each is "one of <n> sessions named
#                  coordinator" and its next starts "if it is not you, ". The list is this
#                  machine's: a Remote Control twin is the coordinator's own ListAgents check
#                  (bin/hooks/session-digest)
#   assistant-twin  after the coordinator-twin findings, with task null: when more than one session
#                  is named assistant in the session list, one for each but the one started first
#                  (a startedAt that is not a number counting as last), with session its short id:
#                  "assistant-twin: assistant <id> (<kind>, <state or status>, started <time>) is a
#                  second session named assistant on this machine, beside <first id>, started
#                  first; next: read claude logs <id> for anything left to hand off, then stop it
#                  with claude stop <id>" ("ask Daniel to end it, an interactive session, pid
#                  <pid>" for an interactive one)
#   activity       after the assistant-twin findings, with task and session null: session-activity
#                  failed (a Python older than 3.11, say, or a session with a transcript whose
#                  startedAt is not epoch milliseconds) or printed no JSON object, so no busy
#                  worker can be found stalled: "activity: <its last line on stderr>, so no busy
#                  worker is found stalled: fix what session-activity names"
#   level-stow     after the activity finding, with task and session null: team-capacity plan (from
#                  the stored readings) confirms the team over its budget at its level and names
#                  tasks to stow, newest first and a task whose walk counts after every other:
#                  "level: over budget at minor (30%): stow T174, then T171" (the coordinator sends
#                  their workers STOW, then runs team-stow)
#   level-resume   after it, with task and session null: the first task stowed, waiting to
#                  resume (for the level or a handoff), oldest stow first, whose roles' estimates
#                  fit the budget again and that nothing holds (Daniel's hold or an ask no launch
#                  went past, wherever logged, or a held, waiting or blocked logged after its stow
#                  standing, until it ends): "level: T171 fits again: relaunch its builder"
#   level-launch   after it, with task and session null: the first task whose launches were
#                  refused for room (a standing paused of cause room, which team-worker logs
#                  with its role on its exit 75, an old line's role read from its "no room for
#                  session:<role>" words, and which a launch of its role, a ticket's refusal
#                  only a launch of that ticket, or a resumed naming it or all=true ends), oldest
#                  refusal first, whose roles fit again and that nothing
#                  holds (as for level-resume, after its latest refusal): "level: T5
#                  has room again: launch its reviewer, refused for room at <time>"
#   level          in their place, with task and session null: team-capacity plan failed:
#                  "level: <its last line on stderr>: fix what team-capacity names"
#   retro-due      after the level findings, with task and session null: a retro is due, as
#                  team-retro status computes it (retros scheduled, no retro task open, the due
#                  time past): "retro due since <time> (every <n>h, last retro <T<n> or none>):
#                  run the retro skill"
#   checkpoint-stale  after retro-due, with task and session null: the health view's alerting
#                  problems whose sweep kind it is (checkpoint: failing two runs in a row or no
#                  good checkpoint for 15 minutes; heartbeat: no run for 15 minutes), in one
#                  finding: "checkpoint: <the problem's plain text>; next: fix what it names
#                  (heartbeat-failures.log has every line), then run team-checkpoint --force"
#   health         after it, with task and session null: the view's alerting problems whose sweep
#                  kind is health (login-refused, ledger, a step failing 12 runs in a row), joined
#                  by "; " in one finding: "health: <their plain texts>; next: fix what each names;
#                  team-timers health lists them"; or, when the view cannot be read (team-timers
#                  fails, times out or prints no team-health/1 view), "health: <its last line on
#                  stderr>: fix what team-timers names". The offline problem and the sessions' own
#                  (coordinator, assistant, unattended) raise none, and a machine that does not hold
#                  the lease has no problems
#   queue-ready    after the health findings, with task and session null: team-queue list's, while
#                  the level has room for one more task and an item is ready, the top one: "queue:
#                  <the room's line>: open <file> (<project>, priority <p>, <size>): <summary>;
#                  next: team-open --queued <file>" (team-queue --help has its words)
#   queue          after it, with task and session null: team-queue list's, while it names problems
#                  in tasks/queued/: "queue: <n> problem(s) in tasks/queued/: <the first two>; next:
#                  fix each file team-queue index --check names"; or, when team-queue fails or prints
#                  no team-queue/1 view, "queue: <its last line on stderr>: fix what team-queue names"
#   current-stale  after it, with task and session null: the current items whose task closed, as
#                  team-current check --json names them: "current: <n> item(s) name a closed task:
#                  <id> (T181, closed 2026-11-02), ...; next: team-current done <id> for each that is
#                  done, or add it again under an open task"
#   current        in its place, with task and session null: team-current check fails (an exit
#                  above 1) or prints no team-current-check/1 view: "current: <its last line on
#                  stderr>: fix what team-current names"; once only, when due fails too
#   current-due    after them, with task null: one for each item of the coordinator's list
#                  (tasks/current.md) whose review date has come, as team-current due --json names
#                  them, with session its item id: "current item <id> is due for review since
#                  <date>: done it, or renew it with a reason"; a due that fails is the current
#                  finding above, unless check failed too
#   assistant-handoff  after them, with task null: one for each hand-off to the coordinator not
#                  answered more than 30 minutes after it was sent, as team-assistant list --open
#                  --to coordinator --json lists them, with session its id (H<n>): "hand-off H<n>
#                  (<kind>) from the assistant has waited <m> min: read it with team-assistant
#                  show H<n>, act, and answer it"; or, when team-assistant fails or prints no list,
#                  one with session null: "assistant-handoff: <its last line on stderr>: fix what
#                  team-assistant names"
# With --json, the findings as a list of {task, kind, session, name, next, text}.
# Exit 0 with no findings (and nothing printed but --json's []), 1 with findings, and 1 with the
# reason on stderr and nothing on stdout when the session list cannot be read.
#
# --wait is the coordinator's sweep watch, run with Bash run_in_background, which has no expiry
# and wakes it once, when the command ends: it looks every 30 s and ends once a finding that was
# not there at its first look has stood for three minutes, printing every finding in the text
# form and exiting 0. A finding is its task, kind and session. One there at the first look (most
# often the one just acted on) ends it only once it has stood for 30 minutes, at every readable
# look since, so a worker that stays stuck is never left unwatched for long; one that clears
# within three minutes (a no-worker between a DONE and the next launch) never ends it; either
# one, once cleared, counts as new when it comes back. It exits 1 with the reason on stderr when
# its looks fail for five minutes running (the session list unreadable, say): the failing look's
# last "team-sweep: " line, else its last line on stderr, else "a look failed with exit <n> and
# nothing on stderr". It exits 1 at the first failing look once its own code (this script and the
# files of bin/lib, by their sums when it started) changed under it, since a merge leaves the
# running watch's old code reading the new library: "<that reason>, after its code changed under
# this watch (<the paths changed>): re-arm it to run the new code"; a change while its looks
# still pass leaves it looking. Time is counted in
# looks, WAIT_SECONDS apart (a test steps it with a stub sleep), and TEAM_SWEEP_BASELINE_SECONDS
# replaces the 30 minutes' seconds (BASELINE_SECONDS, the tests' seam). Re-arm it after acting on
# what it printed.
# TEAM_SWEEP_NOW (a UTC time, as 2026-11-15T10:00:00Z) stands for now where an assistant-handoff's
# wait is counted, and nowhere else, the tests' seam; a due item's day is team-current's own
# (TEAM_CURRENT_NOW).
# Every temporary file a run makes, a look's and its background views', is in one directory of the
# run under TMPDIR, which it removes at its end in every mode, by TERM, INT or HUP too, once it has
# sent TERM to what the views still running run and waited for them; only a KILL leaves it.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"
# shellcheck source=bin/lib/error-view.sh
source "$TEAM_LIB/error-view.sh"

# --wait: seconds between looks, how long a new finding must stand, how long one there at the
# first look must, and how long the session list may stay unreadable.
WAIT_SECONDS=30
STAND_SECONDS=180
BASELINE_SECONDS=${TEAM_SWEEP_BASELINE_SECONDS:-1800}
UNREADABLE_SECONDS=300

[[ $BASELINE_SECONDS =~ ^[0-9]+$ ]] || usage_error "TEAM_SWEEP_BASELINE_SECONDS must be a number of seconds"
# The time an assistant-handoff's wait is counted to, when the tests set it; else the clock's.
SWEEP_NOW=${TEAM_SWEEP_NOW:-}
[[ -z $SWEEP_NOW || $SWEEP_NOW =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
  usage_error "TEAM_SWEEP_NOW \"$SWEEP_NOW\" is not a UTC time as 2026-11-15T10:00:00Z"

usage="usage: team-sweep [--json | --wait]"
mode=text
case $# in
  0) ;;
  1)
    case $1 in
      --json) mode=json ;;
      --wait) mode=watch ;;
      *) usage_error "$usage" ;;
    esac
    ;;
  *) usage_error "$usage" ;;
esac

ledger=$TEAM_HOME/ledger.jsonl
[[ -e $ledger ]] || ledger=/dev/null

# The run's directory, as the header says. The views still running when the run ends are its own
# background jobs that bash has not yet reaped (jobs -r: an ended job bash has reaped is left out,
# since the kernel may have given its pid to another process), so none is another process's: the
# command each runs is sent TERM, so it ends by its own traps and removes its own scratch, and each
# view, which then ends in a moment, is waited for, so none writes into the directory while it is
# removed. A view that has ended needs neither, and its children are no longer its own.
run_tmp=$(mktemp -d)
end_run() {
  local -a views children
  mapfile -t views < <(jobs -rp)
  if ((${#views[@]})); then
    mapfile -t children < <(ps -A -o pid=,ppid= | awk -v views=" ${views[*]} " 'index(views, " " $2 " ") { print $1 }')
    ((${#children[@]} == 0)) || kill -TERM "${children[@]}" 2>/dev/null || true
    wait "${views[@]}" 2>/dev/null || true
  fi
  rm -rf "$run_tmp"
}
trap end_run EXIT

# A new temporary file of the run, named for what it holds: run_file <name>
run_file() {
  mktemp "$run_tmp/$1.XXXXXX"
}

# The quiet time from which session-activity may read a session's transcripts: the default stall
# limit, since no session quieter than that is stalled.
parse_after=$(ledger_jq 'stall_limits.default' -nr)

# session-activity's object for the session list (a JSON array), as {sessions: <its object>}:
# session_activity <sessions>
# When it fails, or prints no JSON object, {error: <its last line on stderr>} (~ for the home
# directory), which is the activity finding, so no session is stalled and the other findings
# still come.
session_activity() {
  local out errors status=0 reason
  errors=$(run_file activity.err)
  out=$("$TEAM_LIB/session-activity" --parse-after "$parse_after" <<<"$1" 2>"$errors") || status=$?
  if ((status)); then
    reason=$(grep . "$errors" | tail -n 1) || reason="session-activity failed with exit $status and no reason given"
  elif ! out=$(jq -ce 'select(type == "object")' <<<"$out" 2>/dev/null); then
    reason="session-activity printed no JSON object"
  fi
  rm -f "$errors"
  if [[ -n ${reason:-} ]]; then
    jq -cn --arg error "${reason//"$HOME/"/"~/"}" '{error: $error}'
  else
    printf '{"sessions":%s}\n' "$out"
  fi
}

# The stow plan as one compact line: team-capacity plan --json's object, from the stored readings
# only (it takes none, so it writes nothing) and the session list in <file>, the look's own, or
# {error} with the last line team-capacity said on stderr (~ for the home directory) when it
# fails: level_plan <file>
level_plan() {
  local out err line
  out=$(run_file plan.out) err=$(run_file plan.err)
  if TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-capacity" plan --json --sessions "$1" >"$out" 2>"$err" </dev/null; then
    jq -c . "$out"
  else
    line=$(grep . "$err" | tail -n 1) || line="team-capacity plan failed with no reason given"
    jq -cn --arg error "${line//"$HOME/"/"~/"}" '{error: $error}'
  fi
  rm -f "$out" "$err"
}

# The most team-timers health may take, in seconds; it reads three files.
HEALTH_TIMEOUT=10

# The health view as one compact line: team-timers health --json's object (exit 1 with problems is
# a view all the same), {} on a machine with no team name, which holds no lease and so is not
# asked, or {error} with the last line team-timers said on stderr (~ for the home directory) when
# it prints no view: health_view
health_view() {
  local out err rc=0 line
  if ! machine_name >/dev/null 2>&1; then echo '{}'; return; fi
  out=$(run_file health.out) err=$(run_file health.err)
  TEAM_HOME=$TEAM_HOME bounded "$HEALTH_TIMEOUT" "$(dirname "$TEAM_LIB")/team-timers" health --json >"$out" 2>"$err" </dev/null || rc=$?
  if ! jq -ce 'select(type == "object" and .schema == "team-health/1" and (.problems | type) == "array")' "$out" 2>/dev/null; then
    if ((rc == 124)); then
      line="team-timers health timed out after $HEALTH_TIMEOUT s"
    else
      line=$(grep . "$err" | tail -n 1) || line="team-timers health exited $rc with no view"
    fi
    jq -cn --arg error "${line//"$HOME/"/"~/"}" '{error: $error}'
  fi
  rm -f "$out" "$err"
}

# The view of one of the scripts whose findings follow health's, as one compact line: its JSON
# object when it prints one of <schema> (exit 1 with problems is a view all the same), or {error}
# with the last line it said on stderr (~ for the home directory): script_view <schema> <script>
# <args>...
script_view() {
  local schema=$1 script=$2 out err rc=0
  out=$(run_file "$script.out") err=$(run_file "$script.err")
  TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/$script" "${@:3}" >"$out" 2>"$err" </dev/null || rc=$?
  if ((rc > 1)) || ! jq -ce --arg schema "$schema" 'select(type == "object" and .schema == $schema)' "$out" 2>/dev/null; then
    error_view "$err" "$script $3 $(if ((rc)); then echo "exited $rc with no reason given"; else echo "printed no $schema view"; fi)"
  fi
  rm -f "$out" "$err"
}

# The hand-offs open to the coordinator as one compact line: team-assistant list --open --to
# coordinator --json's list, or {error} with the last line it said on stderr (~ for the home
# directory) when it fails or prints no list: handoffs_view
handoffs_view() {
  local out err rc=0
  out=$(run_file handoffs.out) err=$(run_file handoffs.err)
  TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-assistant" list --open --to coordinator --json >"$out" 2>"$err" </dev/null || rc=$?
  if ((rc)) || ! jq -ce 'select(type == "array")' "$out" 2>/dev/null; then
    error_view "$err" "team-assistant list $(if ((rc)); then echo "exited $rc with no reason given"; else echo "printed no list"; fi)"
  fi
  rm -f "$out" "$err"
}

# The registered projects that are the team's own and the reviewer App's id, own_projects' JSON in
# bin/lib/team.sh, read only while an open task awaits merge with its plan approved
# (default_may_hold), else no project and no App; null with a registry it cannot read, saying why
# on stderr.
own_covered() {
  local found err
  if ! ledger_jq 'ledger_events | default_may_hold' -nRe "$ledger" >/dev/null; then echo '{"projects": [], "app": null}'; return; fi
  err=$(run_file own.err)
  if found=$(own_projects 2>"$err"); then
    printf '%s\n' "$found"
  else
    echo "team-sweep: finds no task merge-due, since the registry cannot be read: $(grep -m 1 . "$err" || echo "team-project failed")" >&2
    echo null
  fi
  rm -f "$err"
}

# The findings now, as JSON in FINDINGS, from the ledger, a fresh read of the session list, the
# stow plan and the live sessions' transcripts; fails with the reason on stderr when the session
# list cannot be read, and with the sweep's exit code when its jq fails.
look() {
  local sessions plan activity plan_file own health plan_pid health_pid queue current due handoffs
  local queue_pid='' current_pid='' due_pid='' handoffs_pid='' found landing rc=0
  sessions=$(LIVE_SESSIONS='' && live_sessions && printf '%s' "$LIVE_SESSIONS") || return 1
  plan_file=$(run_file plan)
  printf '%s\n' "$sessions" >"$plan_file.sessions"
  echo null >"$plan_file.queue"
  echo null >"$plan_file.current"
  echo null >"$plan_file.due"
  echo null >"$plan_file.handoffs"
  level_plan "$plan_file.sessions" >"$plan_file" &
  plan_pid=$!
  health_view >"$plan_file.health" &
  health_pid=$!
  if [[ -f $TEAM_HOME/tasks/current.md ]]; then
    script_view team-current-check/1 team-current check --json >"$plan_file.current" &
    current_pid=$!
    script_view team-current-due/1 team-current due --json --list coordinator >"$plan_file.due" &
    due_pid=$!
  fi
  if [[ -f $TEAM_HOME/assistant/handoffs.jsonl ]]; then
    handoffs_view >"$plan_file.handoffs" &
    handoffs_pid=$!
  fi
  activity=$(session_activity "$sessions")
  wait "$plan_pid" || true
  # The queue reads the plan just written, beside the ledger pass below.
  if [[ -d $TEAM_HOME/tasks/queued ]]; then
    script_view team-queue/1 team-queue list --json --plan "$plan_file" >"$plan_file.queue" &
    queue_pid=$!
  fi
  wait "$health_pid" || true
  plan=$(cat "$plan_file")
  health=$(cat "$plan_file.health")
  [[ -n $plan ]] || plan='{"error": "team-capacity plan printed nothing"}'
  [[ -n $health ]] || health='{"error": "team-timers health printed nothing"}'
  own=$(own_covered)
  landing=$(merge_locks_held)
  found=$(ledger_jq 'ledger_events | sweep($sessions; $plan; $activity; $own; $health; $self; $landing)' -nRc \
    --argjson sessions "$sessions" --argjson plan "$plan" --argjson activity "$activity" --argjson own "$own" \
    --argjson health "$health" --arg self "${CLAUDE_CODE_SESSION_ID:-}" --argjson landing "$landing" "$ledger") || rc=$?
  [[ -z $queue_pid ]] || wait "$queue_pid" || true
  [[ -z $current_pid ]] || wait "$current_pid" || true
  [[ -z $due_pid ]] || wait "$due_pid" || true
  [[ -z $handoffs_pid ]] || wait "$handoffs_pid" || true
  queue=$(cat "$plan_file.queue")
  current=$(cat "$plan_file.current")
  due=$(cat "$plan_file.due")
  handoffs=$(cat "$plan_file.handoffs")
  rm -f "$plan_file" "$plan_file.sessions" "$plan_file.health" "$plan_file.queue" "$plan_file.current" \
    "$plan_file.due" "$plan_file.handoffs"
  # A failed sweep fails the look with its exit code, once its scripts are waited for and its
  # files gone: --wait calls it as a condition, where set -e stops nothing.
  ((rc == 0)) || return "$rc"
  [[ -n $queue ]] || queue='{"error": "team-queue list printed nothing"}'
  [[ -n $current ]] || current='{"error": "team-current check printed nothing"}'
  [[ -n $due ]] || due='{"error": "team-current due printed nothing"}'
  [[ -n $handoffs ]] || handoffs='{"error": "team-assistant list printed nothing"}'
  FINDINGS=$(ledger_jq '. + sweep_views($queue; $current; $due; $handoffs; $at | if . == "" then now else fromdate end)' \
    -c --argjson queue "$queue" --argjson current "$current" --argjson due "$due" --argjson handoffs "$handoffs" \
    --arg at "$SWEEP_NOW" <<<"$found")
}

# The watch's own code, read into memory when it starts: this script and the library's files, one
# "<crc> <bytes> <path>" line each (cksum's).
code_sums() {
  local file files=("$(dirname "$TEAM_LIB")/team-sweep")
  for file in "$TEAM_LIB"/*; do
    [[ ! -f $file ]] || files+=("$file")
  done
  cksum -- "${files[@]}" 2>/dev/null || true
}

# The paths, from the code checkout's root, whose sums differ between the lists $1 and $2 (one
# missing from either among them), joined by ", ": changed_code <sums> <sums>
changed_code() {
  awk -v root="$(dirname "$(dirname "$TEAM_LIB")")/" '
    NR == FNR { was[$3] = $1 " " $2; next }
    { if (was[$3] != $1 " " $2) out[$3] = 1; delete was[$3] }
    END { for (p in was) out[p] = 1; for (p in out) print substr(p, length(root) + 1) }' \
    <(printf '%s\n' "$1") <(printf '%s\n' "$2") | sort | paste -sd , - | sed 's/,/, /g'
}

# Why the latest look failed, from what it said on stderr ($err): its last "team-sweep: " line,
# else its last line, else its exit code $1, with ~ for the home directory: look_failure <status>
look_failure() {
  local line
  line=$(sed -n 's/^team-sweep: //p' "$err" | tail -n 1)
  [[ -n $line ]] || line=$(grep . "$err" | tail -n 1) || line="a look failed with exit $1 and nothing on stderr"
  printf '%s\n' "${line//"$HOME/"/"~/"}"
}

# The sweep watch: see --wait in the header.
wait_for_finding() {
  local look_n=0 failing_since='' key first=1 status started changed
  local -A initial=() since=() now=()
  err=$(run_file look.err)
  started=$(code_sums)
  while :; do
    if look 2>"$err"; then
      failing_since=''
      now=()
      while IFS= read -r key; do
        now[$key]=1
        if ((first)); then
          initial[$key]=1
        elif [[ -z ${initial[$key]:-} && -z ${since[$key]:-} ]]; then
          since[$key]=$look_n
        fi
      done < <(jq -r '.[] | "\(.task)/\(.kind)/\(.session)"' <<<"$FINDINGS")
      first=0
      for key in "${!initial[@]}"; do
        if [[ -z ${now[$key]:-} ]]; then
          unset "initial[$key]"
        elif ((look_n * WAIT_SECONDS >= BASELINE_SECONDS)); then
          jq -r '.[].text' <<<"$FINDINGS"
          return 0
        fi
      done
      for key in "${!since[@]}"; do
        if [[ -z ${now[$key]:-} ]]; then
          unset "since[$key]"
        elif (((look_n - since[$key]) * WAIT_SECONDS >= STAND_SECONDS)); then
          jq -r '.[].text' <<<"$FINDINGS"
          return 0
        fi
      done
    else
      status=$?
      changed=$(changed_code "$started" "$(code_sums)")
      if [[ -n $changed ]]; then
        echo "team-sweep: $(look_failure "$status"), after its code changed under this watch ($changed): re-arm it to run the new code" >&2
        return 1
      fi
      [[ -n $failing_since ]] || failing_since=$look_n
      if (((look_n - failing_since) * WAIT_SECONDS >= UNREADABLE_SECONDS)); then
        echo "team-sweep: $(look_failure "$status"), for $((UNREADABLE_SECONDS / 60)) minutes running" >&2
        return 1
      fi
    fi
    sleep "$WAIT_SECONDS"
    look_n=$((look_n + 1))
  done
}

case $mode in
  watch) wait_for_finding ;;
  json)
    look
    jq . <<<"$FINDINGS"
    [[ $FINDINGS == '[]' ]]
    ;;
  text)
    look
    jq -r '.[].text' <<<"$FINDINGS"
    [[ $FINDINGS == '[]' ]]
    ;;
esac
