#!/usr/bin/env bash
# Land one pull request through its base's merge queue: enqueue it, post agent-review on each trial
# commit the queue builds for it, wait on that commit's checks, and end once the queue merged it,
# dropped it, or the deadline came. It is the landing alone, with no merge word and no ledger
# event but trial-unmarked and trial-marked (below): team-merge is how the coordinator merges, and
# runs this on a base with a queue.
#
# Usage: team-land [--task T<n>] <pr url> <head>
#   pr url  https://github.com/<owner>/<name>/pull/<n>, in a registered project's repo
#   head    the full 40-hex sha of the PR's head to land, the reviewed one
#   --task  the task whose merge word the landing stands on, which team-merge gives: before
#           agent-review goes on a trial commit, team-merge T<n> --pr <pr url> --holds <head> must
#           say the word and the checks still hold
# Refused, exit 1, before it reads or changes anything, with no JSON: a worker session (an
# AGENT_TEAM_ROLE but coordinator; worker_refusal in bin/lib/team.sh), a PR in no registered
# project's repo (registered_pr there), and a project whose bar cannot be read (own_bar there);
# --help still answers.
# Every 30 seconds (WAIT_SECONDS) it reads the PR from GitHub with one GraphQL query (gh api
# graphql: its state, head, merge commit, queue entry and latest removal from the queue), and:
#   at the first look, a PR that cannot be read, is closed, or whose head is not <head> is
#   refused, nothing enqueued;
#   a PR in no queue that it has not enqueued yet is enqueued with GraphQL's enqueuePullRequest
#   and expectedHeadOid <head>, which errors where gh pr merge would turn auto-merge on; a PR
#   already in the queue is not enqueued again; an enqueue GitHub refuses ends it, refused;
#   on each trial commit the entry names (its headCommit), once per sha, with --task it first
#   holds the merge again (team-merge --holds): a merge that no longer holds (exit 1: the word
#   withdrawn, a later review with findings, a check gone) has the PR taken out of the queue
#   (GraphQL's dequeuePullRequest; dequeue_pr in bin/lib/team.sh) and ends it, dequeued, and one
#   that cannot be told now (exit 75, or any other exit but 0 and 1, a team-merge that could not
#   run) is said and held again at each look, nothing posted;
#   then it posts agent-review there: team-review-check --merge-group, the reviewer App's check
#   run, on a project whose agent-review the App posts (own_bar in bin/lib/team.sh), else
#   team-review-status --merge-group, the commit status; either posts only once the trial commit
#   is proved to be the reviewed head merged cleanly onto what is ahead of it. A post that could
#   not be made now (the poster's exit 75) is said, and tried again at each look while the entry
#   stays on that commit; one that is refused (its exit 1), the entry read again and still on
#   that commit, has the PR taken out of the queue and ends it, dequeued, so a commit that will
#   never get agent-review does not hold the queue until its timeout. A PR GitHub does not let
#   out of the queue is said, and tried again at each look;
#   each look that did not end in a post (a hold or a post that failed, whatever its exit) is one
#   line of the PR's look log, ~/.local/state/agent-team/merge/land/<owner>/<name>/<n>.log, beside
#   the merge lock: "<UTC time>\t<trial sha>\t<hold or post>\t<exit>\t<reason line>", the reason
#   team-merge --holds or the poster gave; a log that cannot be written is passed over;
#   once the same trial commit has stood unmarked with the same step, exit and reason for 10
#   minutes of looks (UNMARKED_SECONDS, counted as 20 looks WAIT_SECONDS apart, the first such
#   look at 0), it says so once for that trial commit: it takes one look at the trial commit's
#   other checks (team-ci-wait --merge-group <trial sha> --look --no-agent-review --json <pr url>),
#   checks passed (outcome passed or none), pending, failed, or unknown (any other end), and says
#   "PR <url> has had no agent-review on its merge queue trial commit <short> for 10 minutes, since
#   <time>: <reason>", then what that look said; with --task it posts that in the task's thread
#   (team-post T<n> --file), a post that fails said on its own line, and logs trial-unmarked (url,
#   head, trial, reason, since, checks), which team-sweep's trial-unmarked finding reads; while the
#   checks it logged are pending or unknown, each later unmarked look of that trial commit looks
#   again, and logs trial-unmarked once more, with no post, the first time they show passed. The
#   next post on any trial commit after this run logged trial-unmarked (the queue may have rebuilt
#   the entry meanwhile) logs trial-marked (url, head, trial: the one posted on);
#   without --task neither is logged and nothing posted;
#   once posted, it waits on the trial commit's checks with team-ci-wait --merge-group <trial sha>
#   --json <pr url>, once per sha, which classes a failure as the PR's own or infrastructure as
#   on a head, or as rules: a check the base's rules or the registry require that never reported
#   on the trial commit; it ends when the entry leaves that commit; team-ci-wait's deadline is
#   what is left of this script's, at most its own 90 minutes;
#   a wait that ends with any rules failure, whatever else failed, has the PR taken out of the
#   queue at once, rather than left to the check's timeout, since no trial commit will make that
#   check, and ends it, dequeued, its reason "<names> never reported on the trial commit, which
#   <base>'s rules require", or for the checks the project's required_checks alone require
#   (team-ci-wait's source) "..., which the project's required_checks require", a clause for each
#   (rules_reason in bin/lib/ledger.jq); while GitHub does not let it out, it is tried again at
#   each look, and a drop by the queue meanwhile ends it the same way, that reason after GitHub's;
#   a merged PR ends it, merged, when its head is still <head>; merged at another head, it ends
#   refused, naming both;
#   a PR that left the queue unmerged was dropped: its latest removal (RemovedFromMergeQueueEvent)
#   is not the one of the first look, or, when GitHub shows no new removal within 2 minutes of
#   looks, it is taken as dropped with no reason given. When team-ci-wait classed failures on the
#   trial commit and none is the PR's own or rules (infrastructure, and the roll-ups of such), it
#   enqueues the same head once more, once per run; else it ends, dequeued. A rules drop is never
#   enqueued again: the next step is the base's rules, the project's required_checks or the
#   workflow's merge_group trigger, which team-merge names.
# It prints what it does as it goes, each line starting "team-land: " with the text of a
# team-ci-wait end indented under its line, then each line that wait printed on stderr (as that
# the base's rules could not be read), and on its last line one JSON object, {schema:
# "team-land/1", outcome, url, head, merge, reason, failed}:
#   outcome  merged, dequeued, waiting or refused
#   url      the PR's, its repo at the end of its moves
#   head     <head>
#   merge    the PR's merge commit when merged, else null
#   reason   null when merged; when dequeued, GitHub's reason for the removal (or that the PR
#            was closed), then a rules drop's reason, an enqueue once more that failed and an
#            agent-review that could not be posted on the last trial commit, or why this run took
#            the PR out of the queue; when waiting or refused, why
#   failed   the failures team-ci-wait classed on the dropped trial commit, each {name, class,
#            kind, link, step, and source on a rules failure}, as the ledger's ci event carries
#            them; [] on any other end
# Exit 0 merged; 1 dequeued or refused; 2 a malformed command line; 75 waiting: the deadline, 4
# hours from its start (TEAM_LAND_DEADLINE_SECONDS replaces its seconds), came with the PR left in
# the queue (or, as its reason then says, not shown in it, or GitHub unread at the last look), or
# the team holds offline (offline_hold): run it again to go on waiting, which enqueues nothing
# while the PR is in the queue.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"
why=$(worker_refusal "" "lands no PR") && die "$why"

# Seconds between looks, how long a PR may be out of the queue with no removal shown before it is
# taken as dropped, team-ci-wait's own deadline, and this script's.
WAIT_SECONDS=30
GONE_SECONDS=120
CI_WAIT_SECONDS=5400
DEADLINE_SECONDS=${TEAM_LAND_DEADLINE_SECONDS:-14400}
# How long a trial commit may stand unmarked with one reason before it is said, in looks' seconds.
UNMARKED_SECONDS=600

[[ $DEADLINE_SECONDS =~ ^[0-9]+$ ]] || usage_error "TEAM_LAND_DEADLINE_SECONDS must be a number of seconds"
usage="usage: team-land [--task T<n>] <pr url> <head>"
task=''
if [[ ${1:-} == --task ]]; then
  [[ ${2:-} =~ ^T[1-9][0-9]*$ ]] || usage_error "$usage"
  task=$2
  shift 2
fi
[[ $# -eq 2 ]] || usage_error "$usage"
[[ $2 =~ ^[0-9a-f]{40}$ ]] || usage_error "the head is a full 40-hex commit sha, got '$2'"
land_head=$2
pr=$(registered_pr "$1")
{ read -r project && read -r repo && read -r number; } <<<"$pr"
url=https://github.com/$repo/pull/$number
poster=team-review-status
bar=$(own_bar "$project") || exit 1
if [[ $(jq -r '.app? // empty' <<<"$bar") ]]; then poster=team-review-check; fi
bin=$(dirname "$TEAM_LIB")
base=$(team_project "$project" base)

dir=$(team_mktemp -d)
echo '[]' >"$dir/failed"
# The PR's look log, beside the merge lock.
look_log=$HOME/.local/state/agent-team/merge/land/$repo/$number.log

note() {
  printf 'team-land: %s\n' "$1"
}

# finish <outcome> <exit code> <reason or ""> [<merge commit>]: print the end's JSON, its failed
# the failures kept in $dir/failed, and exit with <exit code>.
finish() {
  jq -cn --arg outcome "$1" --arg url "$url" --arg head "$land_head" --arg reason "$3" --arg merge "${4:-}" \
    --slurpfile failed "$dir/failed" '{schema: "team-land/1", outcome: $outcome, url: $url, head: $head,
      merge: (if $merge == "" then null else $merge end), reason: (if $reason == "" then null else $reason end),
      failed: (if $outcome == "dequeued" then $failed[0] else [] end)}'
  exit "$2"
}

# Read the PR into pr_id, state, head, merge, entry (its queue entry's state, "" with none), trial
# (the entry's head commit, "" with none yet), removal (the id of its latest removal from the
# queue, "" with none) and removal_reason; fails with gh's reason in $dir/error.
read_pr() {
  # shellcheck disable=SC2016 # the query's variables are GraphQL's
  github "$dir" pr api graphql -f query='query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) { pullRequest(number: $number) {
    id state headRefOid mergeCommit { oid } mergeQueueEntry { state headCommit { oid } }
    timelineItems(last: 1, itemTypes: [REMOVED_FROM_MERGE_QUEUE_EVENT]) {
      nodes { ... on RemovedFromMergeQueueEvent { id reason } } } } } }' \
    -f owner="${repo%%/*}" -f name="${repo#*/}" -F number="$number" || return 1
  if ! jq -e '.data.repository.pullRequest | objects' "$dir/pr" >/dev/null 2>&1; then
    echo "gh api graphql: no such pull request" >"$dir/error"
    return 1
  fi
  {
    read -r pr_id && read -r state && read -r head && read -r merge && read -r entry && read -r trial &&
      read -r removal && read -r removal_reason
  } < <(jq -r '.data.repository.pullRequest | .id // "", .state // "", .headRefOid // "", .mergeCommit.oid // "",
    .mergeQueueEntry.state // "", .mergeQueueEntry.headCommit.oid // "",
    (.timelineItems.nodes[0] | .id // "", (.reason // "" | gsub("[[:cntrl:]]+"; " ")))' "$dir/pr")
}

# Enqueue the PR at <head>, or fail with GitHub's reason in enqueue_error.
enqueue() {
  local rc=0
  # shellcheck disable=SC2016 # the mutation's variables are GraphQL's
  gh api graphql -f query='mutation($pr: ID!, $head: GitObjectID!) {
  enqueuePullRequest(input: {pullRequestId: $pr, expectedHeadOid: $head}) { mergeQueueEntry { id } } }' \
    -f pr="$pr_id" -f head="$land_head" >"$dir/enqueue" 2>"$dir/enqueue.stderr" </dev/null || rc=$?
  ((rc != 0)) || return 0
  enqueue_error=$(grep -m1 . "$dir/enqueue.stderr") || enqueue_error="gh api graphql: exit $rc"
  enqueue_error=${enqueue_error#gh: }
  return 1
}

# said <text>: note <text> unless it is what was said last, so a look that finds what the look
# before found adds no line.
said() {
  [[ $1 == "$said_last" ]] || note "$1"
  said_last=$1
}

# Take the PR out of the queue and end, dequeued with <reason>; where GitHub does not let it out,
# say so and fail, to try again at the next look: take_out <reason>
take_out() {
  local error
  if error=$(dequeue_pr "$pr_id"); then
    note "took $url out of the merge queue: $1"
    finish dequeued 1 "$1"
  fi
  said "$url could not be taken out of the merge queue ($error); trying again at each look"
  return 1
}

# missed <sha> <step> <exit> <reason>: a look that did not end in a post on the trial commit <sha>,
# one line of the look log, and what unmarked counts by, in miss_at and miss_key.
missed() {
  miss_at=$(date -u +%Y-%m-%dT%H:%M:%SZ) miss_key="$2 $3 $4" miss_reason=$4
  { mkdir -p "${look_log%/*}" && printf '%s\t%s\t%s\t%s\t%s\n' "$miss_at" "$1" "$2" "$3" "$4" >>"$look_log"; } 2>/dev/null || true
}

# trial_look <sha>: one look at the trial commit's checks but agent-review, its checks (passed,
# pending, failed or unknown) in look_checks and what it said in look_text.
trial_look() {
  local out outcome
  out=$(TEAM_HOME=$TEAM_HOME "$bin/team-ci-wait" --merge-group "$1" --look --no-agent-review --json "$url" 2>"$dir/look.stderr" | tail -n 1) || true
  outcome=$(jq -er '.outcome | strings' <<<"$out" 2>/dev/null) || outcome=''
  case $outcome in
    passed | none) look_checks=passed ;;
    pending | failed) look_checks=$outcome ;;
    *) look_checks=unknown ;;
  esac
  look_text=$(jq -er '.text | strings' <<<"$out" 2>/dev/null) ||
    look_text="team-ci-wait gave no result: $(grep . "$dir/look.stderr" | tail -n 1 || echo "no output")"
}

# log_trial <kind> <sha> [<checks>]: with --task, log trial-unmarked of the trial commit <sha>, with
# the reason and time it has stood unmarked since and <checks>, or trial-marked; unmarked_open says
# a trial-unmarked of this run stands, with no trial-marked since.
log_trial() {
  local event
  [[ -n $task ]] || return 0
  if [[ $1 == trial-unmarked ]]; then
    unmarked_open=1
    event=$(jq -cn --arg task "$task" --arg url "$url" --arg head "$land_head" --arg trial "$2" \
      --arg reason "$unmarked_reason" --arg since "$unmarked_since" --arg checks "$3" \
      '{ts: (now | todate), task: $task, event: "trial-unmarked", url: $url, head: $head, trial: $trial,
        reason: $reason, since: $since, checks: $checks}')
  else
    unmarked_open=''
    event=$(jq -cn --arg task "$task" --arg url "$url" --arg head "$land_head" --arg trial "$2" \
      '{ts: (now | todate), task: $task, event: "trial-marked", url: $url, head: $head, trial: $trial}')
  fi
  # In a subshell, so a ledger that refuses it (its lock held too long, say) does not end the
  # landing; neither kind is pushed or changes the inbox.
  (ledger_append "$event" 30) 2>"$dir/ledger.stderr" ||
    note "$1 of the trial commit ${2:0:7} could not be logged: $(grep . "$dir/ledger.stderr" | tail -n 1 || echo "ledger_append failed")"
}

# unmarked <sha>: after a look that did not post on the trial commit <sha> (missed), count it, and
# once that trial commit has stood unmarked with one step, exit and reason for UNMARKED_SECONDS of
# looks, say so once, as the header says; once said, look again while its checks were not seen
# passed.
unmarked() {
  local text
  if [[ $1 != "$unmarked_trial" || $miss_key != "$unmarked_key" ]]; then
    unmarked_trial=$1 unmarked_key=$miss_key unmarked_reason=$miss_reason unmarked_since=$miss_at unmarked_n=0
  else
    unmarked_n=$((unmarked_n + 1))
  fi
  if [[ -z ${alerted[$1]:-} ]]; then
    ((unmarked_n * WAIT_SECONDS >= UNMARKED_SECONDS)) || return 0
    trial_look "$1"
    alerted[$1]=$look_checks
    text="PR $url has had no agent-review on its merge queue trial commit ${1:0:7} for $((unmarked_n * WAIT_SECONDS / 60)) minutes, since $unmarked_since: $unmarked_reason"
    note "$text"
    note "the other checks of the trial commit ${1:0:7}: $look_checks"
    printf '%s\n' "$look_text" | sed 's/^/  /'
    [[ -n $task ]] || return 0
    printf '%s\n\n%s\n\n%s\n' "$text." "Its other checks: $(printf '%s\n' "${look_text#team-ci-wait: }" | sed 's/^ *//' | paste -sd ' ' -)" \
      "team-land tries again at each look, and logs each in ${look_log/#"$HOME"/\~}." >"$dir/alert"
    TEAM_HOME=$TEAM_HOME "$bin/team-post" "$task" --file "$dir/alert" >/dev/null 2>"$dir/alert.stderr" ||
      note "the post of that to the thread of $task failed: $(grep . "$dir/alert.stderr" | tail -n 1 || echo "team-post failed")"
    log_trial trial-unmarked "$1" "$look_checks"
  elif [[ -n $task && ${alerted[$1]} == @(pending|unknown) ]]; then
    trial_look "$1"
    [[ $look_checks == passed ]] || return 0
    alerted[$1]=passed
    note "the other checks of the trial commit ${1:0:7} have passed, with still no agent-review there"
    log_trial trial-unmarked "$1" passed
  fi
}

# With --task, hold the merge again before agent-review goes on the trial commit <sha>, once per
# sha once it holds: team-merge --holds, which changes nothing. A merge that does not hold takes
# the PR out of the queue (exit 1); one that cannot be told now (any other exit) fails, with why
# in unposted.
hold() {
  [[ -n $task && -z ${held[$1]:-} ]] || return 0
  local rc=0 why
  TEAM_HOME=$TEAM_HOME "$bin/team-merge" "$task" --pr "$url" --holds "$land_head" >/dev/null 2>"$dir/hold.stderr" || rc=$?
  if ((rc == 0)); then
    held[$1]=1
    return 0
  fi
  why=$(sed -n '/^  (/d; s/^  //p' "$dir/hold.stderr" | paste -sd '|' | sed 's/|/; /g')
  [[ -n $why ]] || why=$(grep . "$dir/hold.stderr" | tail -n 1) || why="team-merge --holds failed (exit $rc)"
  missed "$1" hold "$rc" "$why"
  if ((rc == 1)); then
    take_out "the merge of $task does not hold now, so agent-review is not posted on the trial commit ${1:0:7}: $why" || true
  else
    unposted="agent-review was not posted on the trial commit ${1:0:7}: whether the merge of $task still holds cannot be told now: $why"
    said "$unposted; trying again at each look"
  fi
  return 1
}

# Post agent-review on the trial commit <sha>, through the project's poster; fails with why in
# unposted, said once per reason. A poster that refuses the commit (its exit 1) while the entry,
# read again, is still on it takes the PR out of the queue.
post() {
  local out rc=0 warn
  if [[ $poster == team-review-check ]]; then
    out=$(TEAM_HOME=$TEAM_HOME "$bin/team-review-check" --merge-group "$url" "$1" 2>"$dir/post.stderr") || rc=$?
    if ((rc == 0)); then
      note "posted agent-review success on the trial commit ${1:0:7} as the reviewer App's check run $out"
      return 0
    elif [[ $out =~ ^[1-9][0-9]*$ ]]; then
      # A check run's id on stdout: the check was posted, and only its token's revoke failed.
      warn=$(grep . "$dir/post.stderr" | tail -n 1) || warn=''
      note "posted agent-review success on the trial commit ${1:0:7} as the reviewer App's check run $out, but ${warn#team-review-check: }"
      return 0
    fi
  else
    TEAM_HOME=$TEAM_HOME "$bin/team-review-status" --merge-group "$url" "$1" >/dev/null 2>"$dir/post.stderr" || rc=$?
    if ((rc == 0)); then
      note "set agent-review success on the trial commit ${1:0:7}"
      return 0
    fi
  fi
  out=$(grep . "$dir/post.stderr" | tail -n 1) || out="$poster failed"
  missed "$1" post "$rc" "${out#"$poster": }"
  out="agent-review was not posted on the trial commit ${1:0:7}: ${out#"$poster": }"
  if ((rc == 1)) && read_pr && [[ $state == OPEN && $trial == "$1" ]]; then
    take_out "$out" || true
  else
    said "$out; trying again at each look"
  fi
  unposted=$out
  return 1
}

# Wait on the checks of the trial commit <sha> with team-ci-wait, for what is left of the
# deadline; sets ci_outcome, and keeps a failed end's failures in $dir/failed.
ci_wait() {
  local left=$((DEADLINE_SECONDS - SECONDS)) out
  ((left > 0)) || left=0
  ((left < CI_WAIT_SECONDS)) || left=$CI_WAIT_SECONDS
  out=$(TEAM_HOME=$TEAM_HOME TEAM_CI_WAIT_DEADLINE_SECONDS=$left "$bin/team-ci-wait" --merge-group "$1" --json "$url" 2>"$dir/ci.stderr" | tail -n 1) || true
  if ! ci_outcome=$(jq -er '.outcome | strings' <<<"$out" 2>/dev/null); then
    ci_outcome=unreadable
    note "team-ci-wait gave no result on the trial commit ${1:0:7}: $(grep . "$dir/ci.stderr" | tail -n 1 || echo "no output")"
    return 0
  fi
  if [[ $ci_outcome == failed ]]; then
    jq -c '.failures | map({name, class, kind, link, step} + if .source then {source} else {} end)' <<<"$out" >"$dir/failed"
  fi
  note "the checks of the trial commit ${1:0:7}: $ci_outcome"
  jq -r '.text' <<<"$out" | sed 's/^/  /'
  # What the wait said on stderr beside its result, as that the base's rules could not be read.
  grep . "$dir/ci.stderr" | sed 's/^/  /' || true
  # A required check no workflow makes on a trial commit: the PR comes out of the queue at once.
  rules_drop=$(ledger_jq 'rules_reason($base; "the trial commit")' -r --arg base "$base" "$dir/failed") || rules_drop=''
}

# The end of a drop, with GitHub's reason and what this run adds to it.
dropped() {
  local reason=$1
  [[ -z ${2:-} ]] || reason+="; $2"
  [[ -z $unposted ]] || reason+="; $unposted"
  finish dequeued 1 "$reason"
}

first=true enqueued=false retried=false start_removal='' gone_n='' on_trial='' unposted='' enqueue_error='' ci_outcome=''
rules_drop=''
said_last='' seen=''
miss_at='' miss_key='' miss_reason='' unmarked_trial='' unmarked_key='' unmarked_reason='' unmarked_since='' unmarked_n=0 unmarked_open=''
declare -A posted=() waited=() held=() alerted=()
while :; do
  if offline=$(offline_hold); then
    finish waiting 75 "$offline"
  fi
  # seen is what the look showed, for the deadline's text: queued, out (the PR in no queue) or
  # unread.
  seen=unread
  if read_pr; then
    seen=out
    if $first; then
      if [[ $head != "$land_head" ]]; then
        finish refused 1 "the head of $url is ${head:0:7}, not ${land_head:0:7}: nothing enqueued"
      elif [[ $state == CLOSED ]]; then
        finish refused 1 "$url is closed: nothing enqueued"
      fi
      first=false start_removal=$removal
      if [[ -n $entry ]]; then
        enqueued=true
        note "$url is already in the merge queue: waiting on it, with no second enqueue"
      fi
    fi
    if [[ $state == MERGED && $head != "$land_head" ]]; then
      finish refused 1 "$url was merged at ${head:0:7}, not at the head ${land_head:0:7} this run lands: check it on GitHub"
    elif [[ $state == MERGED ]]; then
      note "$url merged as ${merge:0:7}"
      finish merged 0 "" "$merge"
    elif [[ $state != OPEN ]]; then
      dropped "$url is ${state,,}"
    fi
    if [[ -n $entry ]]; then
      gone_n='' seen=queued
      if [[ -n $rules_drop ]]; then
        # Out at once, on whatever trial commit the entry is on now: none will make the check.
        take_out "$rules_drop" || true
      elif [[ -n $trial ]]; then
        if [[ $trial != "$on_trial" ]]; then
          # A new trial commit: what failed or could not be posted on an earlier one is not its.
          on_trial=$trial unposted=''
          echo '[]' >"$dir/failed"
        fi
        if [[ -z ${posted[$on_trial]:-} ]]; then
          if hold "$on_trial" && post "$on_trial"; then
            posted[$on_trial]=1 unposted=''
            [[ -z $unmarked_open ]] || log_trial trial-marked "$on_trial"
          else
            unmarked "$on_trial"
          fi
        fi
        if [[ -n ${posted[$on_trial]:-} && -z ${waited[$on_trial]:-} ]]; then
          trial=$on_trial
          ci_wait "$trial"
          if [[ -n $rules_drop ]]; then
            # Out now; where GitHub does not let it out, tried again at the next look's.
            waited[$trial]=1
            take_out "$rules_drop" || true
          else
            case $ci_outcome in
              passed | none | failed | other-head | closed)
                waited[$trial]=1
                # The queue acts on these at once: look again with no wait, but for the deadline.
                ((SECONDS >= DEADLINE_SECONDS)) || continue
                ;;
            esac
          fi
        fi
      fi
    elif ! $enqueued; then
      if ! enqueue; then
        finish refused 1 "GitHub refused to enqueue $url at ${land_head:0:7}: $enqueue_error"
      fi
      enqueued=true
      note "enqueued $url at ${land_head:0:7}"
    else
      [[ -n $gone_n ]] || gone_n=0
      if [[ $removal != "$start_removal" ]] || ((gone_n * WAIT_SECONDS >= GONE_SECONDS)); then
        if [[ $removal != "$start_removal" ]]; then
          reason=${removal_reason:-GitHub gives no reason}
        else
          reason="GitHub shows no removal and no reason"
        fi
        note "the merge queue dropped $url: $reason"
        if [[ -n $rules_drop ]]; then
          dropped "$reason" "$rules_drop"
        elif ! $retried && jq -e 'any(.[]; .class == "infrastructure") and all(.[]; .class != "pr" and .class != "rules")' "$dir/failed" >/dev/null; then
          retried=true
          if ! enqueue; then
            dropped "$reason" "enqueuing ${land_head:0:7} once more failed: $enqueue_error"
          fi
          note "only infrastructure failed on the trial commit: enqueued $url at ${land_head:0:7} once more"
          echo '[]' >"$dir/failed"
          start_removal=$removal gone_n='' on_trial='' unposted=''
        else
          dropped "$reason"
        fi
      else
        gone_n=$((gone_n + 1))
      fi
    fi
  elif $first; then
    finish refused 1 "GitHub cannot be read: $(cat "$dir/error"): nothing enqueued"
  fi
  if ((SECONDS >= DEADLINE_SECONDS)); then
    case $seen in
      queued) seen="$url is still in the merge queue" ;;
      out) seen="$url is not shown in the merge queue" ;;
      *) seen="GitHub could not be read at the last look, so whether $url is in the merge queue is not known," ;;
    esac
    finish waiting 75 "$seen after $((DEADLINE_SECONDS / 60)) minutes: run team-land again to go on waiting"
  fi
  sleep "$WAIT_SECONDS"
done
