#!/usr/bin/env bash
# Start the one session that owns #coordinator and the tasks' threads: the team's coordinator.
#
# The Discord plugin logs in to Discord from every session that loads it, so it is off in user
# settings and on here and in claude-assistant alone, each through its session's own --settings and
# Discord state. Bypass mode, by Daniel's choice; workers run in auto mode, which holds a
# bypass-mode sender's message for an approval nobody gives unless the receiver's settings accept
# it, so the workers' own settings (settings/worker.json, crossSessionInbound: accept) take this
# session's messages, whatever a machine's user settings say. With the safety classifier off here,
# its settings' deny rules stop the plain spelling of a force push, a push to dev or main, git
# reset --hard, git clean, git branch -D, a Docker prune and a merge outside team-merge, by the
# workers' own rules (tests/repo.bats holds the two together), a speed bump another spelling gets
# past; GitHub's protection of agent-team's dev refuses a direct push and a merge with a red check.
#
# The manual, roles/coordinator.md, is appended to the system prompt, and the coordinator's own
# skills (handoff, level, recover-worker, resume, retro, status-report, stow, ui-intake) load
# from plugins/coordinator-skills; no worker loads either. Its settings are coordinator.settings.json with @TEAM_CODE@ (in its hook
# commands) naming this checkout, written to ~/.local/state/agent-team/coordinator.settings.json;
# the manual, the skills, the settings and the hooks all come from this script's checkout.
# Its session runs on the worker login when bin/lib/worker-login names one, by its settings' env
# (launch_settings in bin/lib/launch.sh), and the launch refuses (exit 1) while that login is not
# on this machine; since the session runs no command-guard, its settings deny a command naming
# GH_CONFIG_DIR, GH_TOKEN or GITHUB_TOKEN, or holding env -i, env --i (--ignore-environment and its
# prefixes), env - or exec -c, which empty the environment.
#
# Its MCP servers are toolkits/coordinator's alone (its README), passed with --mcp-config after
# @TEAM_CODE@ is replaced, as ~/.local/state/agent-team/coordinator.mcp.json. --strict-mcp-config
# connects no plugin server, the Discord channel's included, so it is not used: instead the
# launch runs `claude mcp list` in the working directory and its settings deny
# (deniedMcpServers) every server the list names but the toolkit's, those of a plugin they
# enable, and the claude.ai connectors the toolkit's connectors.json keeps, by exact name. A
# failed list refuses the launch (exit 1), and so does one that printed a line but named no
# server in its format, naming its first line, since a changed format would deny nothing; an
# empty list, or Claude Code's "No MCP servers configured." line, denies none.
#
# It compacts at 200k tokens, by the launch's --autocompact flag rather than autoCompactWindow in
# its settings: the flag is not preempted by a higher-priority settings scope, so a /autocompact
# Daniel once ran in their own session (saved in user settings) cannot widen the coordinator's
# window; CLAUDE_CODE_AUTO_COMPACT_WINDOW, which would override the flag, stays unset. Its
# settings add idle compaction from 100k tokens, so a long idle does not rewrite a large cache,
# and bin/hooks/compact-hold, which holds each automatic compaction until the coordinator has
# stowed (team-stowed), for at most 15 minutes after telling it, and below 300k tokens.
#
# It runs on the coordinator line of the team home's models.toml (bin/team-models, sops/models.md):
# the line's model and effort as --model and --effort, its subagent fields as
# CLAUDE_CODE_SUBAGENT_MODEL and CLAUDE_CODE_SUBAGENT_EFFORT in its settings' env, and an axis no
# line names on the settings' word; a file that does not read is a warning, and it launches on the
# settings' word, since it is the session that fixes the file (launch_models in
# bin/lib/launch.sh). Once claude --bg has started it, the launch appends what it runs on to the
# team home's sessions.jsonl, {ts, machine, name, category, model, model_from, effort,
# effort_from} with the session's id, which team-checkpoint commits; a failed write is a warning
# (launch_log).
#
# Its starting context, which every reply carries and every compaction starts from, holds only
# what it uses. Its settings deny, by bare name, the tools it never calls (Artifact and its two
# readers, Workflow, ScheduleWakeup, ReportFindings and the task list's TaskCreate, TaskGet,
# TaskList and TaskUpdate), and a denied tool's definition is left out of the session. With no
# TaskUpdate Claude Code sends no "task tools haven't been used recently" reminder, which
# CLAUDE_CODE_TODO_REMINDER_MODE=off in its settings' env turns off by itself too. Its skill
# listing is kept to its own plugin's skills: its settings turn off the skills synced from
# claude.ai (syncClaudeAiSkills) and the ones bundled with Claude Code (disableBundledSkills) and
# keep the Discord plugin's two for Daniel to type, and the launch turns off every personal skill
# in ${CLAUDE_CONFIG_DIR:-~/.claude}/skills but one with the name of a skill of its own
# (launch_skills_off in bin/lib/launch.sh), so one Daniel adds later is off at the next launch.
#
# Only on the lease holder: it refuses (exit 1) unless `team-lease check` confirms against origin
# that this machine holds the lease, naming the holder, or saying a coordinator never starts
# offline when GitHub is unreachable.
#
# Only one coordinator: it refuses (exit 1, naming the session id) while `claude agents --json
# --all` lists a session named coordinator in any state but stopped, so the ledger keeps one
# writer and #coordinator one listener: a background one whose turn is done (or that failed) counts,
# though the daemon has settled its process and the list without --all leaves it out, since a
# message or a finished shell of its wakes it. A non-blocking flock on
# ~/.local/state/agent-team/coordinator-launch.lock, held from that check through the launch,
# makes a second launch at the same moment exit 1 at once. The list is this machine's alone:
# claude agents --json lists no Remote Control session, so a twin over Remote Control (another
# machine's coordinator, or this session's own row left from before its machine went down) is
# the coordinator's ListAgents check at each start (bin/hooks/session-digest), and team-sweep's
# coordinator-twin finds a second one on this machine.
#
# Usage: claude-coordinator [--prompt <text>] [working-directory]   (default: the team home)
#   --prompt  the session's first prompt, in place of "You are the coordinator. Daniel talks to
#             you on Discord. Wait for their messages." (team-resume names its report and the
#             resume skill in it)
# An assistant session is refused it, one of the coordinator's acts (assistant_refusal in
# bin/lib/team.sh, beside command-guard's assistant-acts row); its --help still answers.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"
why=$(assistant_refusal "runs no claude-coordinator") && die "$why"
# shellcheck source=bin/lib/launch.sh
source "$TEAM_LIB/launch.sh"

usage="usage: claude-coordinator [--prompt <text>] [working-directory]"
prompt="You are the coordinator. Daniel talks to you on Discord. Wait for their messages."
if [[ ${1:-} == --prompt ]]; then
  [[ $# -ge 2 && -n $2 ]] || usage_error "$usage"
  prompt=$2
  shift 2
fi
(($# <= 1)) || usage_error "$usage"
[[ ${1:-} != -* ]] || usage_error "$usage"
# The manual, the skills, the settings and the hooks are code: they come from this checkout,
# beside bin/.
code=$(dirname "$(dirname "$TEAM_LIB")")
cd "${1:-$TEAM_HOME}"

# The lock, the session list and the settings are the launchers' shared library's.
launch_lock coordinator
launch_singleton coordinator
launch_unlocked lease_gate "a coordinator"
mcp=$LAUNCH_STATE/coordinator.mcp.json
settings=$LAUNCH_STATE/coordinator.settings.json
launch_settings "$code/coordinator.settings.json" "$code/toolkits/coordinator/.mcp.json" \
  "$code/toolkits/coordinator/connectors.json" "$settings" "$mcp"
launch_skills_off "$settings" "$code/plugins/coordinator-skills"
launch_models coordinator "$settings"

# Not exec: this shell keeps the lock until claude returns, and the session it starts does not
# inherit the lock's file, so a running coordinator never holds the next launch's lock.
status=0
out=$(claude --bg --name coordinator \
  ${LAUNCH_MODEL_ARGS[@]+"${LAUNCH_MODEL_ARGS[@]}"} \
  --autocompact 200k \
  --mcp-config "$mcp" \
  --channels plugin:discord@claude-plugins-official \
  --dangerously-skip-permissions \
  --append-system-prompt-file "$code/roles/coordinator.md" \
  --plugin-dir "$code/plugins/coordinator-skills" \
  --settings "$settings" \
  "$prompt" \
  {LAUNCH_LOCK_FD}>&-) || status=$?
[[ -z $out ]] || printf '%s\n' "$out"
((status != 0)) || launch_log coordinator "$out"
exit "$status"
