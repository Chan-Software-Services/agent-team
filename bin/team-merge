#!/usr/bin/env bash
# Merge a task's PR on Daniel's recorded word, only with every required check green on its head.
#
# Usage: team-merge T<n> [--pr <url>] [--holds <head>]
# The PR is the task's latest pr event, or --pr, which must be one of the task's pr events (a URL
# under a moved repo's old owner or its new one, bin/lib/repo-moves.json, naming the same PR); its
# repo must be a project in projects.toml. Checks first, changing nothing, each failure a reason.
# Two words may merge it, read from the ledger by merge_authority in bin/lib/ledger.jq (the
# derivation every reader shares) and tried in this order, the first that holds merging it:
#   Daniel's per-head word, when a merge-approved event names the PR's url (the latest counts; a
#   trailing slash aside): its discord_message is a message sent no earlier than the first event
#   that logged its head (a pr event of the url, or a review of the task since the url's first pr
#   event; by the time in its id), in the task's thread or in #coordinator, read with the bot
#   token through the Discord API, whose author is in allowFrom of
#   ~/.claude/channels/discord/access.json; Daniel's word holds for the PR's head when it is the
#   approval's head, or when every commit since that head not on origin's base is a merge commit
#   (read in the primary checkout, after fetching the PR's branch and the base) and a review with
#   verdict pass on the head now is logged after the approval, or on the head a caught-up event
#   says team-catch-up made it from (reviewed_head), the latest review of that one a pass logged
#   after the approval and git showing the head adds only clean merges of the base to it, or,
#   when each such merge is clean (a merge of the base whose tree is git merge-tree's of its
#   parents), with no review made in the PR's project (project_reviews in bin/lib/ledger.jq) after
#   the word that found anything; a merge that is none of these is
#   refused naming why (the first merge not clean, or the review that found something); a head
#   that does not hold the approval's, or holds a commit of its own since it (the first is
#   named), is refused, to ask again; the approval's head must be one such an event logged; a
#   legacy approval with no head holds for any head, its message sent no earlier than the PR's
#   latest pr event; it holds the PR to the checks every merge gets below and nothing more;
#   then, when no merge-approved names the PR or the per-head word does not hold for a reason of its
#   own (never one of the checks every merge gets), the default word, the task's approved plan: its
#   latest plan-approved or plan-approval-withdrawn is an approval (plan_approval; none is refused
#   as no approved plan, a withdrawal naming when and in which message); on the team's own project
#   (own_project: agent-team by name, by path or by repo) with the reviewer App off (no
#   bin/lib/review-app) its one reason is that it merges unattended only behind the reviewer App's
#   check, which is not set up, nothing more read; with the App on, the approval is Daniel's (the
#   coordinator's or a legacy one is refused, naming that it needs Daniel's) and the base's rules
#   (base_rules in bin/lib/team.sh: its classic protection and its rulesets) require agent-review
#   from the App's id, with classic protection enforcing its required checks for everyone and no
#   ruleset read with a bypass actor, each refused naming what is missing, and the rest holds as
#   for any project; then the default is not withdrawn for the PR: the latest
#   merge-default-withdrawn or merge-default-restored of the whole ledger whose scope covers it
#   (task, logged under the PR's task; the PR's project; or all) is not a withdrawal, which is
#   refused naming its scope, time and message, never read, and one that is a giving back holds only
#   when Discord shows its message from an allowFrom author in #coordinator or the thread of the
#   task it was logged under, else it is refused naming why; the plan's files now (plan_files in
#   bin/lib/team.sh: tasks/T<n>/plan.md, and spec.md and scope.txt in the task directory of its
#   first project's worktree) hash as the approval recorded, each one that differs, is new or is
#   gone named, to approve it again, and files that cannot be read are refused (a legacy approval,
#   logged before T276 with no plan, has none to compare and no scope, and reads as the
#   coordinator's); an approval of Daniel's has its discord_message sent no earlier than the latest
#   asked of the id it answers logged before it, and read back from Discord as a merge-approved's
#   is; the PR's head branch is the task's branch for the project (its latest opened, worktree-added
#   or branch-renamed event's, so a branch the gate made the builder move to counts once the
#   coordinator logs it); the latest review of the head (by the shorter prefix) has verdict pass and
#   logged guarded as an empty list (one that left it out, or named one of the six areas, is
#   refused, naming them; a retired area a review logged before names is not one), where a head
#   team-catch-up made (a caught-up event names it) and no review names stands on the latest review
#   of the head it was made from, followed back through each such event to a head with a review of
#   its own, once git (after fetching the branch and the base into the primary checkout) shows it
#   adds only clean merges of the base to that head, else it is refused naming the first merge that
#   is not; no review of the task counted a security or real-data finding, fixed or not, or left out
#   its findings, each such review named by its head and time; the PR's changed files, read from
#   GitHub's paged list of its files (each filename, and each rename's previous filename), number
#   the PR's changedFiles, else the list is refused as not read in full; each changed path is within
#   the approval's scope when it has one (an entry ending in / covers every path under it, any other
#   that path only), each one outside named; and no changed path matches a guarded pattern of
#   bin/lib/guarded that applies to the PR's project (CI, migrations, the deploy, permissions and
#   secrets), as it is or with its camelCase humps split off by underscores, each one named with its
#   areas; a per-head word that holds never reads it; a refusal on it lists the per-head word's
#   reasons too when a merge-approved names the PR (or the task logged no plan approval either),
#   each reason once, and ends with a line saying to ask Daniel for the per-head word on the head;
#   and every check every merge gets: the PR is open, not a draft, does not conflict, and targets
#   the project's base; every required check (the base's rules, its protection's and its rulesets'
#   required checks, gh pr checks --required and the project's required_checks; rules that cannot be
#   read are refused as GitHub unreadable) is present on the head and passed (a skipped one passes),
#   a missing one naming the step on a base with a merge queue when the head is behind its base
#   (pr_part's behind_by) and a required agent-review is not missing on it: run team-catch-up T<n>,
#   which merges the base into the PR so the check runs on it; no check on the head is failing or
#   pending; agent-review is success on the head: on the team's own project with the reviewer App
#   on, the App's latest agent-review check run whose head_sha is the head (review_check in pr_part,
#   bin/lib/team.sh), a commit status or another App's check run of that name refused as not the
#   App's check, on every word, else the check or status gh pr checks shows; no commit of the PR
#   carries an agent attribution line, and the list read ends at the head.
# Then, for a project with local_checks, team-checks runs them on the PR's head (fetched from
# origin) from the primary checkout, labelled "team-merge T<n>" under the heavy-run lock, and each
# must pass (exit 75: the lock stayed held, try again later), a refusal giving each other one's
# result as team-checks prints it, with where its whole log is kept, the lines that name a failure
# and its last lines; the head read again after must not have moved.
# Any failure is exit 1 with every reason, and gh pr merge is never called.
# On a base with a merge queue (base_rules' queue), run it with Bash run_in_background, since it
# ends only when the queue does. The checks above are the same, a PR behind its base still no reason
# to refuse, with two more: the project's merge_method is merge, the only one the team proves a
# trial commit for, and the PR's queue entry can be read. For a PR in the queue, a conflict GitHub
# has not worked out is no reason, since GitHub does not work it out again for a PR that stands in
# the queue when its base moves: the queue is the proof there, a trial commit built only from a
# clean merge and proved before agent-review goes on it (queue_commit_problems in bin/lib/team.sh),
# unless its entry is UNMERGEABLE, which is refused naming the queue; a conflict GitHub did work
# out is refused in the queue as out of it. A refusal there reaches the queue: a PR in
# the queue is taken out of it (GraphQL's dequeuePullRequest; dequeue_pr in bin/lib/team.sh) and
# dequeued logged with the reasons, since a trial commit that carries agent-review lands whatever
# this run says, unless every reason is one that cannot be told now, which leaves it queued and says
# so: GitHub unread, a conflict GitHub has not worked out yet for a PR in no queue or whose queue
# entry could not be read, the plan's files unread, the head not fetched for the local checks, and
# local checks that could not run (team-checks exit 75), each
# classed where it is made; every other reason is a refusal that stands, a Discord message that
# cannot be read back and a head not fetched to check a word among them, which fails closed at the
# cost of a second enqueue. A PR GitHub does not let out is said, nothing logged; and a queued that
# stands for a PR read in no queue, or merged at another head than it names, is ended by a dequeued
# of the head it names, since it left the queue while no team-merge waited. The task's lock,
# ~/.local/state/agent-team/merge/T<n>.lock, whose file holds the pid of the run that took it, is
# taken after the local checks, so no process one of them leaves behind holds it, and let go once
# merged or dequeued is logged: while another team-merge holds it, read before the local checks and
# again where it is taken, this one prints "team-merge is already landing <url> (pid <n>)" and exits
# 0, changing nothing; and when the task's events, read again under it, show a merged of the PR
# another run logged meanwhile, it says so and exits 0, with no second merged, and a queued stands
# only when it is still the latest of them. It logs queued (url, head, project) and runs team-land
# --task T<n> <url> <head>, never gh pr merge, showing team-land's lines on stderr; team-land
# enqueues the PR, holds the word and the checks again before each trial commit's agent-review
# (--holds below), posts it and waits, and on its outcome:
#   merged    the PR's merge commit is the one team-land names, and everything below follows as
#             after gh pr merge;
#   dequeued  the queue dropped it, or team-land took it out: dequeued is logged (url, head,
#             reason, and failed, the failures on the trial commit, when there are any), unless
#             another team-merge logged one meanwhile and team-land names no failures, and it is
#             exit 1 naming the reason, each failure and the next step: with a failure of the
#             PR's own, the builder-merge-base brief, since the trial merge failed what the head
#             passed, even beside a rules failure, since the queue cancels the rest of a trial
#             commit it gives up, so a roll-up whose shards it cancelled reads as the rules' once
#             no run is open, and a rules gap that is real shows alone on the round's new head;
#             else with a rules failure (a check the base's rules or the project's
#             required_checks require that never reported on the trial commit, each said as
#             "<name> was not reported on the trial merge, which <base>'s rules require", or
#             "which the project's required_checks require" for one they alone require), to run
#             team-doctor (its merge queue line), fix the workflow's merge_group trigger or ask
#             Daniel to change the repository's ruleset, then run team-merge again, the project's
#             required_checks named among what requires it and what to fix for such a check, and
#             team-doctor and the ruleset left out with no check the rules require (rules_step in
#             bin/lib/ledger.jq), since the trial merge cannot be judged until every required
#             check runs there; a required check not reported while a workflow run of the trial
#             commit was still open (team-ci-wait's infrastructure, as a roll-up whose shards
#             waited for a runner) is said as "<name> was not reported on the trial merge while a
#             workflow run there was still open, as infrastructure", with no rules step; else,
#             when GitHub's reason is checks_timed_out (the queue's check timeout) or at least
#             one failure is infrastructure of kind queued or missing and every other is one
#             too or a roll-up, so the checks waited on runners and a plain run again meets the
#             same wait, "the runners are behind, with nothing of the PR's to fix: tell Daniel,
#             who may raise the check timeout of <repo>'s merge queue while the backlog stands,
#             and run team-merge T<n> again once they say the runners are back", ending as
#             team-next --ci's infrastructure end does; else to run team-merge again once what
#             dropped it is fixed;
#   waiting   team-land's deadline came, or the team holds offline: it is exit 75, saying to run
#             team-merge again with run_in_background, and whether the PR, read again, is still
#             in the queue, merged, or unread; nothing more is logged for those, and a PR in no
#             queue is logged dequeued, so no queued stands for it;
#   refused   team-land enqueued nothing, or found the PR merged at another head: a queued this
#             run logged is ended by a dequeued with why, as is one that stood before it once
#             the PR, read again, is in no queue and not merged, or merged at another head than
#             this run lands, and it is exit 1.
# A team-land that ends with no result is exit 1, the queued left standing while the PR, read again,
# is in the queue, merged or unread, and ended by a dequeued when it is in no queue. Run again on a
# PR already in the queue, it holds the word and the checks again, logs no second queued while the
# task's latest queued, with no dequeued or merged of the PR since, names the head (else it logs
# one), and goes on waiting. Run on a PR GitHub shows merged at the head such a standing queued
# names, which the queue landed while no team-merge waited, it refuses nothing: it says what does
# not hold now and logs merged, with no local checks run; when the word does not hold now, merged
# carries no approval or Discord message, its by names the queued event it stood on, and nothing is
# posted.
# On a base with no queue: gh pr merge <number> --repo <repo> --<merge_method> --match-head-commit
# <head>, never --auto or --admin; the PR is read again and must be merged (if gh left it open with
# auto-merge on, auto-merge is turned off and it is exit 1); then merged is appended with pr, merge,
# head, by (naming the Discord message and its author, or "the plan the coordinator approved at
# <ts>"), project, branch, discord_message and discord_channel (Daniel's message, left out on a plan
# the coordinator approved), url (the PR's), approval (head for the per-head word, default for the
# default one), local_checks (the commands that passed on head) when there were any, check_run (the
# reviewer App's agent-review check run's id, on the team's own project with the App on), and
# phases_left, the phases of the task with a ticket not done, as team-tickets T<n> --json read them
# just before gh pr merge ([] when every ticket is done, so the task reads merged, else
# merged-part); a task with no tickets logs none, and a team-tickets that fails logs none and says
# so on stderr, the merge going on. Prints {task, pr, merge, head, by}, then commits the ledger and
# pushes it to the team home's origin at once, before any later step (ledger_push in
# bin/lib/team.sh, which says on stderr when it is not on origin yet, the exit staying 0). Then,
# when the task's opened event names a story (team-open --story) and the PR is of the project it
# opened in, that story's backlog file in the team home (story_file in bin/lib/team.sh) is marked:
# its front matter's status becomes done and the PR's number joins its pr: list (in the list's
# style, #5 beside #-numbers, else 5), and a line on stderr names the file, which the next
# checkpoint commits with the records; a story that reads so already is said and left. A story that
# cannot be marked (no such file, no front matter, a pr: line that is no [...] list) is said on
# stderr with why; the merge stands and the exit stays 0. Then, on the default word
# only, team-post posts one message to the task's thread and one to #coordinator: the task, the PR's
# URL, the approval it merged on ("on the plan you approved," Daniel's message as a link, its guild
# the one team-inbox keeps in inbox.json, else #coordinator's channel's, its channel the one the
# message was read in, with none the message named and a line on stderr saying why; or "on the plan
# the coordinator approved at <ts>"), the merge commit, and how to revert: the PR page's Revert
# button, or on the base git revert -m 1 <merge> for a merge, git revert <merge> for a squash, and
# for a rebase git revert <merge>~<n>..<merge>, the PR's n commits less its merges; with no thread,
# it posts to #coordinator alone, saying so on stderr. A post that fails (Discord refuses it, or
# team-post refuses on a fenced machine) is said on stderr, naming where, with its full text, for
# the coordinator to post with team-post; the merge stands and the exit stays 0. A per-head merge
# posts nothing.
# Then, when the project's primary checkout is the code checkout this runs from, that checkout
# follows the base, so merged code reaches the scripts: on the base branch and clean (untracked
# files aside), it is fast-forwarded to origin's, said on one line; on another branch or a
# detached HEAD, with local changes, ahead or diverged, with untracked files in the way, or with
# origin out of reach, it is left as it is, with the reason and the command to run, and the exit
# stays 0.
# Last, team-inbox takes the PR out of the team home's waiting.md; when that fails, a line on
# stderr says so, and the exit stays 0.
# It runs on the owner login throughout, every gh and git call and the scripts it runs, whatever
# GitHub login its session names (use_owner_login in bin/lib/github-login.sh).
# Refused, exit 1, before it reads or changes anything: a worker session (an AGENT_TEAM_ROLE but
# coordinator; worker_refusal in bin/lib/team.sh), in every form; --help still answers.
# --holds <head> merges nothing and changes nothing: it says whether the word and the checks every
# merge gets still hold for the PR at <head>, the full sha, but for the local checks, which it
# does not run. Exit 0 they hold; 1 they do not, every reason on stderr as a refusal's, a PR whose
# head is not <head> among them, and so is a run that ends before it judged (a die: the task's
# events, the registry or jq failing); 75 every reason is one that cannot be told now, as above.
# team-land runs it before it posts agent-review on a trial commit, and takes the PR out of the
# queue on exit 1.
# Exit 0 merged, another team-merge is landing the PR or logged it merged; 1 refused, the merge
# failed, or the queue dropped the PR; 2 a malformed command line; 75 the PR is still in the
# queue, or in none with nothing merged: run it again.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/team.sh" "$@"
use_owner_login
why=$(worker_refusal "" "merges no PR") && die "$why"

usage="usage: team-merge T<n> [--pr <url>] [--holds <head>]"

task='' url='' holds=''
while (($#)); do
  case $1 in
    --holds)
      [[ $# -ge 2 && $2 =~ ^[0-9a-f]{40}$ ]] || usage_error "--holds takes the full 40-hex sha of the head: $usage"
      holds=$2
      shift
      ;;
    --pr)
      [[ $# -ge 2 && -n $2 ]] || usage_error "$usage"
      url=${2%/}
      shift
      ;;
    -*) usage_error "$usage" ;;
    *)
      [[ -z $task ]] || usage_error "$usage"
      task=$1
      ;;
  esac
  shift
done
[[ -n $task ]] || usage_error "$usage"
[[ $task =~ ^T[1-9][0-9]*$ ]] || usage_error "task must look like T<n>, got '$task'"

events=$(known_task_events "$task")
jq -e 'any(.[]; .event == "pr")' <<<"$events" >/dev/null || die "$task has no pr event, so there is no PR to merge"
if [[ -z $url ]]; then
  pr=$(jq -c 'map(select(.event == "pr")) | last' <<<"$events")
else
  # The task's events carry each url under its repo's new owner, so the URL given is read so too.
  url=$(canonical_url "$url") || exit 1
  pr=$(jq -c --arg url "$url" 'map(select(.event == "pr" and (.url | rtrimstr("/")) == $url)) | last' <<<"$events")
  [[ $pr != null ]] ||
    die "$url is not one of $task's pr events:"$'\n'"$(jq -r '.[] | select(.event == "pr") | "  \(.url)"' <<<"$events")"
fi

scratch=$(team_mktemp -d)

# The PR as team-state sees it: the repo, the project, the head and the checks by bucket.
facts=$(pr_part "$events" "$pr" "$scratch") || exit 1
url=$(jq -r .url <<<"$facts")
[[ $(jq -r '.number // empty' <<<"$facts") ]] || die "$(jq -r .error <<<"$facts")"
number=$(jq -r .number <<<"$facts") repo=$(jq -r .repo <<<"$facts") project=$(jq -r '.project // empty' <<<"$facts")
[[ -n $project ]] || die "PR #$number is in $repo, which is not a project in projects.toml, so it has no base or merge method"
base=$(team_project "$project" base)
method=$(team_project "$project" merge_method)

# The reasons a merge is refused, each word's apart from the checks every merge gets, so a word can
# be tried, judged and set aside: head_reasons, why Daniel's per-head word does not hold (or that
# none is recorded); default_reasons, why the default word, the approved plan, does not;
# merge_reasons, the checks every merge gets, whatever the word.
head_reasons=() default_reasons=() merge_reasons=()
# The reasons that cannot be told now, a set keyed by each such reason, which later puts it in
# where it is made, never by reading its text: GitHub unread, a conflict GitHub has not worked out
# for a PR in no queue or whose queue entry could not be read, the plan's files unread, a head that cannot be fetched for the local checks, and local checks
# that could not start (team-checks exit 75). A run again may find each gone, so a refusal on these
# alone leaves a queued PR in the queue; every other reason is a refusal that stands.
declare -A untold_reasons=()
# One reason more of the list <name> that cannot be told now: later <name> <reason>
later() {
  local -n later_to=$1
  later_to+=("$2")
  untold_reasons[$2]=1
}
# A jq that fails ends the run, nothing merged: jq_failed [<its exit>]
jq_failed() {
  die "PR #$number cannot be checked: jq failed${1:+ (exit $1)}, so nothing changed"
}
# Each line jq prints is one reason more of the list <name>: add_reasons <name> <jq arguments>...
add_reasons() {
  local -n add_to=$1
  local out line
  out=$(jq -r "${@:2}") || jq_failed $?
  while IFS= read -r line; do if [[ -n $line ]]; then add_to+=("$line"); fi; done <<<"$out"
}

# GitHub's facts: the checks and the base's rules (in $scratch/rules, for an open PR) from pr_part,
# the rest from one more view and the commit list.
# queue is the base's merge queue rule, when it has one; entry the state of the PR's entry in it,
# when it is in the queue, entry_read set once that was read, and pr_id the PR's GraphQL node id,
# which takes it out of the queue; standing the task's queued event of the PR that no later dequeued or
# merged of it ended; landed is set for a PR GitHub shows merged at the head that event names,
# which the queue landed while no team-merge waited.
head='' branch='' rules_read='' queue='' entry='' entry_read='' pr_id='' standing='' landed=''
if jq -e 'has("error")' <<<"$facts" >/dev/null; then
  later merge_reasons "GitHub cannot be read: $(jq -r .error <<<"$facts")"
elif ! github "$scratch" pr pr view "$number" --repo "$repo" --json isDraft,mergeable,headRefName,headRefOid,changedFiles ||
  ! github "$scratch" commits api "repos/$repo/pulls/$number/commits" --paginate; then
  later merge_reasons "GitHub cannot be read: $(<"$scratch/error")"
else
  head=$(jq -r .head <<<"$facts") branch=$(jq -r .headRefName "$scratch/pr")
  state=$(jq -r .state <<<"$facts")
  standing=$(jq -c --arg url "${url%/}" '[.[] | select(.event | IN("queued", "dequeued", "merged"))
    | select((.url | strings | rtrimstr("/")) == $url)] | last | select(.event == "queued")' <<<"$events") || jq_failed $?
  if [[ $state == merged && -n $standing && $(jq -r .head <<<"$standing") == "$head" ]]; then landed=1; fi
  if [[ -z $landed ]]; then
    [[ $state == open ]] || merge_reasons+=("PR #$number is $state, not open")
    [[ $(jq -r .isDraft "$scratch/pr") != true ]] || merge_reasons+=("PR #$number is a draft")
  fi
  # A base with a merge queue lands the PR through it: the team proves a trial commit only as a
  # merge commit, and a PR already in the queue is waited on, never enqueued twice.
  queue=$(jq -c '.queue // empty' <<<"$facts")
  if [[ -n $queue ]]; then
    [[ $method == merge ]] ||
      merge_reasons+=("$base merges through its merge queue, which the team lands only with merge_method merge, not $project's $method")
    rm -f "$scratch/error"
    # shellcheck disable=SC2016 # the query's variables are GraphQL's
    if github "$scratch" entry api graphql -f query='query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) { pullRequest(number: $number) { id state mergeQueueEntry { state } } } }' \
      -f owner="${repo%%/*}" -f name="${repo#*/}" -F number="$number" &&
      jq -e '.data.repository.pullRequest | objects' "$scratch/entry" >/dev/null 2>&1; then
      entry=$(jq -r '.data.repository.pullRequest.mergeQueueEntry.state // empty' "$scratch/entry")
      pr_id=$(jq -r '.data.repository.pullRequest.id // empty' "$scratch/entry") entry_read=1
    else
      later merge_reasons "GitHub cannot be read: PR #$number's merge queue entry ($(grep -m1 . "$scratch/error" 2>/dev/null || echo "gh api graphql gave no pull request"))"
    fi
  fi
  # Whether the PR conflicts with its base, as GitHub worked it out. GitHub does not work it out
  # again for a PR that stands in the queue when its base moves, so there the queue is the proof:
  # it builds a trial commit only from a merge that is clean onto what is ahead of the PR, which
  # queue_commit_problems (bin/lib/team.sh) proves before agent-review goes on it, and an entry
  # GitHub marks UNMERGEABLE is one it could not merge.
  if [[ -z $landed ]]; then
    case $(jq -r .mergeable "$scratch/pr") in
      MERGEABLE) ;;
      CONFLICTING) merge_reasons+=("PR #$number conflicts with its base") ;;
      *)
        if [[ $entry == UNMERGEABLE ]]; then
          merge_reasons+=("PR #$number's entry in $base's merge queue is UNMERGEABLE, and GitHub has not worked out whether PR #$number conflicts with its base")
        elif [[ -z $entry ]]; then
          later merge_reasons "GitHub has not worked out yet whether PR #$number conflicts with its base; try again in a minute"
        fi
        ;;
    esac
  fi
  [[ $(jq -r .base <<<"$facts") == "$base" ]] || merge_reasons+=("PR #$number targets $(jq -r .base <<<"$facts"), not $project's base $base")
  [[ -z $holds || $holds == "$head" ]] || merge_reasons+=("PR #$number's head is ${head:0:7}, not ${holds:0:7}, the head --holds names")
  [[ $(jq -r .headRefOid "$scratch/pr") == "$head" ]] || merge_reasons+=("the head moved while it was read (${head:0:7}, then $(jq -r '.headRefOid[:7]' "$scratch/pr")); run team-merge again")
  # agent-review is the reviewer App's check run on the team's own project with the App on
  # (review_check, from pr_part), else the check or status of that name gh pr checks shows.
  # A PR not open has no rules read, and is refused as not open; rules that cannot be read are a
  # reason of their own, the other checks still made.
  if [[ -f $scratch/rules ]]; then
    rules_read=1
  else
    if [[ -f $scratch/rules.error ]]; then
      later merge_reasons "GitHub cannot be read: $(grep -m1 . "$scratch/rules.error" || echo "the base's rules failed")"
    fi
    echo '{"required": []}' >"$scratch/rules"
  fi
  # A required check missing on a head behind a queued base is one the base newly requires, which
  # runs only on a commit pushed since: team-catch-up merges the base for it (the queue needs no
  # other catch-up), but not while agent-review is missing, which no merge's run brings and for
  # which team-catch-up refuses the head.
  while IFS= read -r line; do merge_reasons+=("$line"); done < <(jq -r --slurpfile rules "$scratch/rules" --arg task "$task" '
    ((.required + [$rules[0].required[].context]) | unique) as $required
    | (.checks.passed + .checks.failing + .checks.pending) as $present
    | [$required[] | select(IN($present[]) | not)] as $missing
    | (if .queue != null and (.behind_by // 0) > 0 and (any($missing[]; . == "agent-review") | not) then
        ", which is \(.behind_by) commit\(if .behind_by == 1 then "" else "s" end) behind \(.base): run team-catch-up \($task), which merges \(.base) into the PR so the check runs on it"
       else "" end) as $catch_up
    | ($missing[] | "required check \(.) is missing on the head\($catch_up)"),
      ([$required[] | select(IN($present[]))] - .checks.passed | .[] | "required check \(.) has not passed on the head"),
      (.checks.failing | select(length > 0) | "checks failing on the head: \(join(", "))"),
      (.checks.pending | select(length > 0) | "checks pending on the head: \(join(", "))"),
      (if .review_check == null then .agent_review | select(. != "success") | "agent-review is \(.) on the head, not success"
       elif .review_check == "success" then empty
       elif .review_check == "foreign" then "agent-review on the head is \(.review_check_by), not the reviewer App'"'"'s check"
       elif .review_check == "missing" then "the reviewer App'"'"'s agent-review check is missing on the head \(.head[:7])"
       else "the reviewer App'"'"'s agent-review check is \(.review_check) on the head \(.head[:7]), not success" end)' <<<"$facts")
  commits=$(jq -cs 'add // []' "$scratch/commits")
  last=$(jq -r 'last.sha // ""' <<<"$commits")
  [[ $last == "$head" ]] || merge_reasons+=("the PR's commit list ends at ${last:0:7}, not at the head ${head:0:7}, so not every commit could be checked")
  attributed=''
  while IFS= read -r sha; do
    msg=$(jq -r --arg s "$sha" '.[] | select(.sha == $s) | .commit.message' <<<"$commits")
    while IFS= read -r line; do
      merge_reasons+=("commit ${sha:0:7} ($(head -n 1 <<<"$msg")) carries an attribution line: $line")
      attributed=1
    done < <(attribution_lines <<<"$msg")
  done < <(jq -r '.[].sha' <<<"$commits")
fi

# The words, read from the ledger alone by merge_authority in bin/lib/ledger.jq, the one
# derivation every reader shares, on the head GitHub shows (or, when GitHub cannot be read, the
# PR's latest logged head); what the ledger cannot show is checked below, word by word.
# The default word's withdrawals and givings back, every task's, each giving back with thread, the
# latest thread of the task it was logged under, where its message may be read back.
withdrawals=$(default_events_json) || jq_failed $?
# The bar the PR's project is held to (own_bar): false, or the team's own with the reviewer App's
# id, null while it is off; own_off is set for the team's own project with the App off, own_app to
# the App's id for the team's own project with it on.
own=$(own_bar "$project") || exit 1
own_off='' own_app=''
if [[ $own != false ]]; then
  own_app=$(jq -r '.app // empty' <<<"$own")
  if [[ -z $own_app ]]; then own_off=1; fi
fi
authority=$(ledger_jq 'merge_authority($url; $head; $project; $own; $withdrawals)' -c --arg url "${url%/}" \
  --arg head "${head:-$(jq -r '.head // ""' <<<"$pr")}" --arg project "$project" --argjson own "$own" \
  --argjson withdrawals "$withdrawals" <<<"$events") || jq_failed $?
head_word=$(jq -c '.words[] | select(.word == "head")' <<<"$authority")
default_word=$(jq -c '.words[] | select(.word == "default")' <<<"$authority")

# Daniel's word, per head or on the plan. A <kind> event names Daniel's Discord message, which
# holds when it is an id sent no earlier than <since> (the time of <what>; no <since>, no such
# check) and Discord shows it in one of <places> (by default the task's thread or #coordinator,
# each "<name> <channel id>") from an allowFrom author; then by and channel name it, else its
# reason joins the list <name>: word_from <name> <kind> <message> <since> <what> [<place>...]
thread=$(jq -r 'map(select(.event == "thread")) | last | .discord_thread // empty' <<<"$events")
by='' channel=''
word_from() {
  local -n word_to=$1
  local kind=$2 message=$3 since=$4 what=$5 sent places=("${@:6}") reply
  if [[ ! $message =~ ^[1-9][0-9]{0,18}$ ]]; then
    word_to+=("$kind names discord_message '$message', which is not a Discord message id")
    return
  fi
  # A Discord id holds the milliseconds since 2015-01-01 above its low 22 bits.
  sent=$(((10#$message >> 22) / 1000 + 1420070400))
  if [[ -n $since ]] && ((sent < $(date -ud "$since" +%s))); then
    word_to+=("Discord message $message was sent at $(date -ud "@$sent" +%FT%TZ), before $what at $since, so it is not Daniel's word on this PR")
    return
  fi
  if ((${#places[@]} == 0)); then
    if [[ -n $thread ]]; then places+=("the task's thread $thread"); fi
    places+=("#coordinator $COORDINATOR_CHANNEL")
  fi
  if reply=$(daniel_message "$message" "the approval" "${places[@]}" 2>"$scratch/word"); then
    by="Discord message $message in $(jq -r .place <<<"$reply"), from $(jq -r .who <<<"$reply")"
    channel=$(jq -r .channel <<<"$reply")
  else
    word_to+=("$(<"$scratch/word")")
  fi
}

# The PR's branch and the base fetched from origin into the project's primary checkout, once, for
# the git checks of the heads; fails with fetch_error saying why: fetch_pr
primary=$(team_project "$project" path) fetched='' fetch_error=''
fetch_pr() {
  if [[ -z $fetched ]]; then
    if git -C "$primary" fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" \
      "+refs/heads/$base:refs/remotes/origin/$base" 2>"$scratch/fetch-error"; then
      fetched=ok
    else
      fetched=failed fetch_error=$(grep -m1 . "$scratch/fetch-error" || echo "git fetch failed")
    fi
  fi
  [[ $fetched == ok ]]
}

# The per-head word, when a merge-approved names the PR: its message sent since the first pr or
# review event that logged the head it names (a legacy one names none: the PR's latest pr event).
# A number alone names a PR in any repo, so it never counts.
word=head message=''
approval=$(jq -c .facts.approval <<<"$head_word")
approved=$(jq -r '.facts.head // empty' <<<"$head_word")
pr_ts=$(jq -r '.facts.logged.ts // empty' <<<"$head_word")
add_reasons head_reasons '.reasons[]' <<<"$head_word"
if jq -e .applies <<<"$head_word" >/dev/null; then
  if [[ -n $pr_ts ]]; then
    message=$(jq -r '.discord_message | tostring' <<<"$approval")
    word_from head_reasons merge-approved "$message" "$pr_ts" "the $(jq -r .facts.logged.event <<<"$head_word") event of $url${approved:+ at ${approved:0:7}}"
  fi
fi
# Daniel's word on a head the PR has since moved past holds only through merges of the base, read
# in the primary checkout once the PR's branch and the base are fetched from origin: merges that
# are clean (clean_base_merges) with no review made in the PR's project logged after the word
# that found something, merges
# whose passing review was logged after the word, or a head team-catch-up made from such a head,
# the latest review of the head it was made from (reviewed_head) a pass logged after the word and
# git showing it adds only clean merges of the base to that head.
if [[ -n $approved && -n $pr_ts && -n $head ]] &&
  ! ledger_jq 'same_head($a; $b)' -ne --arg a "$approved" --arg b "$head" >/dev/null; then
  if ! fetch_pr; then
    head_reasons+=("the head ${head:0:7} cannot be fetched into $primary to check it against Daniel's word on ${approved:0:7}: $fetch_error")
  elif ! git -C "$primary" merge-base --is-ancestor "$approved" "$head" 2>/dev/null; then
    head_reasons+=("the head ${head:0:7} does not hold ${approved:0:7}, the head Daniel's word named: ask again")
  else
    own=$(git -C "$primary" rev-list --reverse --no-merges "$head" "^$approved" "^origin/$base")
    if [[ -n $own ]]; then
      head_reasons+=("the head moved past Daniel's word with ${own:0:7}: ask again")
    elif ! ledger_jq 'any(.[$approval.i + 1:][]; .event == "review" and .verdict == "pass" and same_head(.head; $head))' \
      -e --argjson approval "$approval" --arg head "$head" <<<"$events" >/dev/null && ! {
      reviewed=$(ledger_jq 'reviewed_head($head)' -r --arg head "$head" <<<"$events") || jq_failed $?
      ! ledger_jq 'same_head($a; $b)' -ne --arg a "$reviewed" --arg b "$head" >/dev/null &&
        ledger_jq '[.[$approval.i + 1:][] | select(.event == "review" and same_head(.head; $reviewed))] | last | .verdict == "pass"' \
          -e --argjson approval "$approval" --arg reviewed "$reviewed" <<<"$events" >/dev/null &&
        git -C "$primary" merge-base --is-ancestor "$approved" "$reviewed" 2>/dev/null &&
        clean_base_merges "$primary" "$reviewed" "$head" "origin/$base" >/dev/null
    }; then
      # The first review made in the PR's project (project_reviews in bin/lib/ledger.jq) after
      # the word that found something: another repository's findings are none of this PR's.
      found=$(ledger_jq '. as $events | [project_reviews($project)[] | select(. > $approval.i) | $events[.]
          | select(.verdict == "findings")] | first
        | if . == null then empty else "the review of the head \(.head[:7]) at \(.ts)" end' \
        -r --argjson approval "$approval" --arg project "$project" <<<"$events") || jq_failed $?
      unclean=''
      clean_base_merges "$primary" "$approved" "$head" "origin/$base" >"$scratch/clean" || unclean=$(<"$scratch/clean")
      if [[ -n $unclean ]]; then
        head_reasons+=("the merges of the base since Daniel's word on ${approved:0:7} are not clean: $unclean")
      elif [[ -n $found ]]; then
        head_reasons+=("$found, logged after Daniel's word, found something, so the merges of the base since it need a passing review")
      fi
      if [[ -n $unclean || -n $found ]]; then
        head_reasons+=("the head ${head:0:7} is ${approved:0:7}, Daniel's word, with merges of the base, but no passing review of ${head:0:7} is logged after the word: review it, or ask again")
      fi
    fi
  fi
fi


# The default word, the approved plan, tried when no merge-approved names the PR or the per-head
# word does not hold for a reason of its own (never one of the checks every merge gets): the
# ledger's reasons, then, while the approval stands, unless on the team's own project with the
# reviewer App off, the plan's files now against the approval's, a giving back of the default read
# back, Daniel's message read back for an approval of theirs, and on a head GitHub showed, the PR's
# branch, a caught-up head against git, and the PR's files read in full, each within the approval's
# scope when it has one and none on the short list, and on the team's own project the base's
# rules pinning agent-review to the reviewer App, with no way past them.
# files_read is set once GitHub's list of the PR's files is read in full, PR_CHANGED then holding
# its paths.
files_read=''
if ! jq -e .applies <<<"$head_word" >/dev/null || ((${#head_reasons[@]})); then
  word=default message='' by='' channel=''
  add_reasons default_reasons '.reasons[]' <<<"$default_word"
  if jq -e .applies <<<"$default_word" >/dev/null && [[ -z $own_off ]]; then
    # The plan's files now, hashed as team-log hashed them at the approval (plan_files).
    if plan_now=$(plan_files "$task" 2>"$scratch/plan"); then
      add_reasons default_reasons --argjson now "$plan_now" '.facts | . as $f | select(.plan != null) | .plan as $then
        | reduce (($then | keys_unsorted[]), ($now | keys_unsorted[])) as $k ([]; if IN(.[]; $k) then . else . + [$k] end)
        | map(select($then[.] != $now[.])) | select(length > 0)
        | "the plan changed since its approval at \($f.ts) (\(join(", "))): approve it again"' <<<"$default_word"
    else
      later default_reasons "the plan's files cannot be read ($(grep -m 1 . "$scratch/plan" || echo "plan_files failed")), so whether the plan changed since its approval at $(jq -r .facts.ts <<<"$default_word") is not known"
    fi
    # A giving back of the default word holds only when Discord shows its message, from an allowFrom
    # author, in #coordinator or the thread of the task it was logged under; a withdrawal is never
    # read.
    restored=$(jq -c '.facts.restored // empty' <<<"$default_word")
    if [[ -n $restored ]]; then
      given=$(ledger_jq '"the default word was given back for \(default_scope_text) at \(.ts) in Discord message \(.discord_message)"' -r <<<"$restored")
      said_in=$(jq -r '.discord_channel | tostring' <<<"$restored")
      said_by=$(jq -r .task <<<"$restored")
      place=''
      if [[ $said_in == "$COORDINATOR_CHANNEL" ]]; then
        place="#coordinator $said_in"
      elif [[ $said_in == "$(jq -r '.thread // ""' <<<"$restored")" ]]; then
        if [[ $said_by == "$task" ]]; then place="the task's thread $said_in"; else place="$said_by's thread $said_in"; fi
      else
        default_reasons+=("$given, in channel $said_in, which is neither #coordinator nor $said_by's thread")
      fi
      if [[ -n $place ]] &&
        ! daniel_message "$(jq -r '.discord_message | tostring' <<<"$restored")" "the giving back" "$place" >/dev/null 2>"$scratch/restored"; then
        default_reasons+=("$given, which does not read back: $(<"$scratch/restored")")
      fi
    fi
    if [[ $(jq -r .facts.by <<<"$default_word") == Daniel ]]; then
      ask=$(jq -r .facts.ask <<<"$default_word")
      message=$(jq -r '.facts.discord_message | tostring' <<<"$default_word")
      asked_ts=$(jq -r '.facts.asked.ts // empty' <<<"$default_word")
      if [[ -z $asked_ts ]]; then
        default_reasons+=("plan-approved answers the ask $ask, which $task did not log before it")
      else
        word_from default_reasons plan-approved "$message" "$asked_ts" "the asked $ask"
      fi
    else
      by="the plan the coordinator approved at $(jq -r .facts.ts <<<"$default_word")"
    fi
    if [[ -n $head ]]; then
      # GitHub holds the App's check only once the base's rules require agent-review from the App's
      # id, with no way past them; pr_part read the rules.
      if [[ -n $own_app && -n $rules_read ]]; then
        pin=$(ledger_jq 'review_app_pin_problems($app)
          | if .kind == "pin" then
              "\($base)'"'"'s protection and rulesets do not require agent-review from the reviewer App \($app), so GitHub does not hold its check: the team'"'"'s own project merges unattended only once it does"
            elif .kind == "admins" then "\($base)'"'"'s protection enforces its required checks for \(.level), not everyone, so an administrator could merge past them"
            else "\($base)'"'"'s \(bypass_text(""))" end' \
          -r --argjson app "$own_app" --arg base "$base" "$scratch/rules") || jq_failed $?
        while IFS= read -r line; do if [[ -n $line ]]; then default_reasons+=("$line"); fi; done <<<"$pin"
      fi
      task_branch=$(jq -r '.facts.branch // empty' <<<"$default_word")
      if [[ -n $task_branch && $branch != "$task_branch" ]]; then
        default_reasons+=("PR #$number comes from $branch, not $task_branch, $task's branch for $project")
      fi
      # A head team-catch-up made stands on the review of the head it was made from only while git
      # shows it adds clean merges of the base alone: the ledger's word is checked, never trusted.
      reviewed=$(ledger_jq 'reviewed_head($head)' -r --arg head "$head" <<<"$events") || jq_failed $?
      if ! ledger_jq 'same_head($a; $b)' -ne --arg a "$reviewed" --arg b "$head" >/dev/null; then
        if ! fetch_pr; then
          default_reasons+=("the head ${head:0:7} cannot be fetched into $primary to check it against the review of ${reviewed:0:7}, which team-catch-up made it from: $fetch_error")
        elif ! clean_base_merges "$primary" "$reviewed" "$head" "origin/$base" >"$scratch/clean"; then
          default_reasons+=("the head ${head:0:7} does not stand on the review of ${reviewed:0:7}, which team-catch-up made it from: $(<"$scratch/clean")")
        fi
      fi
      rc=0
      pr_file_reasons "$scratch" "$project" "$repo" "$number" "$(jq -r '.changedFiles // "unknown number of"' "$scratch/pr")" || rc=$?
      ((rc != 2)) || jq_failed
      # Its one reason when the list cannot be read (1) is that GitHub cannot be read.
      if ((rc == 1)); then
        for line in "${PR_FILE_REASONS[@]}"; do later default_reasons "$line"; done
      else
        default_reasons+=("${PR_FILE_REASONS[@]}")
      fi
      if ((rc == 0)); then files_read=1; fi
      if [[ -n $files_read ]]; then
        outside=$(ledger_jq 'scope_reasons($scope)' -r --argjson scope "$(jq -c .facts.scope <<<"$default_word")" <<<"$PR_CHANGED") ||
          jq_failed $?
        while IFS= read -r line; do if [[ -n $line ]]; then default_reasons+=("$line"); fi; done <<<"$outside"
      fi
    fi
  fi
fi

# Refuse, with every reason, when there is any: when the default word was tried and does not hold,
# the per-head word's reasons (when a merge-approved names the PR, or the task logged no plan
# approval either), the default word's and then the checks every merge gets, each reason once,
# and a line saying to ask Daniel for the per-head word; else, on a word that holds, the checks
# alone. A PR the queue landed already is never refused, since it is merged: what does not hold now
# is said, and when that is its word, the merged event names the queued event it stood on in place
# of a word, and nothing is posted.
# A refusal reaches the queue too, but with --holds, which changes nothing: a PR in the queue is
# taken out of it (dequeue_pr) and its dequeued logged with the reasons, since a trial commit that
# carries agent-review lands whatever this run says, unless every reason is one that cannot be
# told now (untold_reasons, each classed where it is made), which leaves it there; and a queued
# that stands for a PR read in no queue, or merged at another head than it names, is ended by a
# dequeued of the head it names, since the PR left the queue while no team-merge waited.
refuse_on_problems() {
  local all=() reasons=() reason unheld='' untold=1 why
  local -A seen=()
  if [[ $word == default ]] && ((${#default_reasons[@]})); then
    unheld=1
    if jq -e .applies <<<"$head_word" >/dev/null || ledger_jq 'plan_approval == null' -e <<<"$events" >/dev/null; then
      all=("${head_reasons[@]}")
    fi
    all+=("${default_reasons[@]}")
  fi
  all+=("${merge_reasons[@]}")
  for reason in "${all[@]}"; do
    if [[ -z ${seen[$reason]:-} ]]; then
      seen[$reason]=1
      reasons+=("$reason")
    fi
  done
  if [[ -n $landed ]]; then
    local queued_at
    queued_at=$(jq -r .ts <<<"$standing")
    echo "team-merge: PR #$number is merged, and $task's queued event of its head ${head:0:7} at $queued_at stands: the queue landed it with no team-merge waiting" >&2
    if ((${#reasons[@]})); then
      echo "team-merge: what does not hold now, the merge standing:" >&2
      printf '  %s\n' "${reasons[@]}" >&2
    fi
    if [[ -n $unheld || -z $by ]]; then
      word='' message='' channel='' by="the word team-merge queued it on at $queued_at, which does not hold now"
    fi
    return 0
  fi
  ((${#reasons[@]})) || return 0
  {
    echo "team-merge: $task cannot merge PR #$number, so nothing changed:"
    printf '  %s\n' "${reasons[@]}"
    if [[ -n ${attributed:-} ]]; then echo "  (team-clean-messages <worktree> strips them; push its rewrite and wait for the checks again)"; fi
    if [[ -n $unheld ]]; then
      local on="the PR's head"
      if [[ -n $head ]]; then on="the head ${head:0:7}"; fi
      echo "  (Daniel's default word does not hold: ask them for the per-head word on $on with team-ask, naming $url)"
    fi
  } >&2
  for reason in "${reasons[@]}"; do
    [[ -n ${untold_reasons[$reason]:-} ]] || untold=''
  done
  if [[ -n $holds ]]; then
    [[ -z $untold ]] || exit 75
    exit 1
  fi
  if [[ -n $entry && -n $untold ]]; then
    echo "team-merge: PR #$number is left in the merge queue, since whether its merge holds cannot be told now: run team-merge $task again" >&2
  elif [[ -n $entry ]]; then
    if why=$(dequeue_pr "$pr_id"); then
      why=$(printf '%s; ' "${reasons[@]}" | tr '\n' ' ' | tr -s ' ')
      log_dequeued "team-merge refused the merge and took PR #$number out of the merge queue: ${why%; }"
      echo "team-merge: took PR #$number out of the merge queue, since its merge does not hold" >&2
    else
      echo "team-merge: PR #$number could not be taken out of the merge queue ($why): remove it from the queue on GitHub, or it lands once its trial commit passes" >&2
    fi
  elif [[ -n $standing && ${state:-} == merged ]]; then
    # Merged at another head than the queued names (at that head it is landed, above): the queued
    # stands for nothing, in a queue or out of it.
    local queued_head
    queued_head=$(jq -r .head <<<"$standing")
    log_dequeued "PR #$number was merged at ${head:0:7}, not at ${queued_head:0:7}, the head its queued names, with no team-merge landing it" '[]' "$queued_head"
  elif [[ -n $entry_read && -n $standing ]]; then
    log_dequeued "PR #$number left the merge queue while no team-merge waited on it" '[]' "$(jq -r .head <<<"$standing")"
  fi
  exit 1
}
# The dequeued event of the PR, with <reason>, the failures of team-land's result when given (a
# JSON list), and the head that was enqueued, the PR's head as read unless <head> names another,
# the one a standing queued names: log_dequeued <reason> [<failed> [<head>]]
log_dequeued() {
  ledger_append "$(jq -cn --arg task "$task" --arg url "$url" --arg head "${3:-$head}" --arg reason "$1" --argjson failed "${2:-[]}" \
    '{ts: (now | todate), task: $task, event: "dequeued", url: $url, head: $head, reason: $reason}
      + if $failed == [] then {} else {failed: $failed} end')"
  refresh_inbox
}
refuse_on_problems
# --holds ends here: the word and the checks hold, and nothing was changed.
[[ -z $holds ]] || exit 0

# Through the queue, one team-merge lands a task's PR at a time, under the task's lock, whose file
# holds the pid of the run that took it. A run that finds it held says who holds it and ends, so
# two waits never post on the same trial commit: here, before the local checks, read without
# taking it (merge_lock_held), so a second run does not run them only to find it held, and again
# where the lock is taken, after them.
landing='' lock=$HOME/.local/state/agent-team/merge/$task.lock
already_landing() {
  echo "team-merge is already landing $url (pid $(grep -m1 -E '^[0-9]+$' "$lock" || echo unknown))"
  exit 0
}
if [[ -n $queue || -n $landed ]]; then
  landing=1
  ! merge_lock_held "$task" || already_landing
fi

# The project's local checks, last since they are the slowest: team-checks runs them in a detached
# worktree of the primary checkout at the PR's exact head, then the head is read again. A PR the
# queue landed already has none run.
local_checks=()
if [[ -z $landed ]]; then mapfile -t local_checks < <(team_project "$project" local_checks | jq -r '.[]'); fi
if ((${#local_checks[@]})); then
  primary=$(team_project "$project" path)
  if ! git -C "$primary" fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>"$scratch/fetch-error" ||
    ! git -C "$primary" cat-file -e "$head^{commit}" 2>/dev/null; then
    later merge_reasons "the head ${head:0:7} cannot be fetched into $primary for the local checks: $(grep -m1 . "$scratch/fetch-error" || echo "origin's $branch is elsewhere")"
    refuse_on_problems
  fi
  rc=0
  "$(dirname "$TEAM_LIB")/team-checks" "$project" "$head" --from "$primary" --label "team-merge $task" >"$scratch/checks" || rc=$?
  if ((rc)); then
    why="the local checks did not pass on the head ${head:0:7} (team-checks exit $rc):"$'\n'"$({ grep -v "' passed on the head " "$scratch/checks" || true; } | sed 's/^/    /')"
    # Exit 75: team-checks could not run them now (the heavy-run lock stayed held), and nothing failed.
    if ((rc == 75)); then later merge_reasons "$why"; else merge_reasons+=("$why"); fi
  fi
  if github "$scratch" again pr view "$number" --repo "$repo" --json headRefOid; then
    moved=$(jq -r .headRefOid "$scratch/again")
    [[ $moved == "$head" ]] ||
      merge_reasons+=("the head moved while the local checks ran (${head:0:7}, then ${moved:0:7}); run team-merge again")
  else
    later merge_reasons "GitHub cannot be read after the local checks: $(<"$scratch/error")"
  fi
  refuse_on_problems
fi

# The task's phases with a ticket not done, read before the merge so the merged event says whether
# a part of the task is still to build: a JSON list, or empty when the task has no tickets or they
# cannot be read, which never stops the merge.
phases_left=''
if "$(dirname "$TEAM_LIB")/team-tickets" "$task" --json >"$scratch/tickets" 2>"$scratch/tickets-error"; then
  phases_left=$(jq -c 'if . == [] then empty else map(select(.state != "done") | .phase) | unique end' "$scratch/tickets")
else
  echo "team-merge: cannot read $task's tickets ($(grep -m 1 . "$scratch/tickets-error" || echo "team-tickets failed")), so its merged names no phases left" >&2
fi

if [[ -n $landing ]]; then
  # The lock, held until the PR's merged or dequeued is logged and by the team-land this run
  # starts: taken only now, after the local checks, so no process one of them leaves behind
  # inherits its descriptor and holds the lock past this run.
  mkdir -p "${lock%/*}"
  exec {lock_fd}>>"$lock"
  flock -n "$lock_fd" || already_landing
  echo $$ >"$lock"
  # The task's latest queued, dequeued or merged of the PR, read from the ledger now, or nothing.
  latest_queue_event() {
    task_event_array "$task" | jq -c --arg url "${url%/}" '[.[] | select(.event | IN("queued", "dequeued", "merged"))
      | select((.url | strings | rtrimstr("/")) == $url)] | last // empty'
  }
  # What was read before the lock may be another run's by now: a merged of the PR that run logged
  # since ends this one, with no second merged, and a queued stands only when it is still the
  # latest, so a dequeued that run logged since is followed by this run's queued before it lands.
  latest=$(latest_queue_event) || jq_failed $?
  if [[ $(jq -r '.event // empty' <<<"$latest") == merged ]]; then
    echo "team-merge: another team-merge logged PR #$number merged while this one read it: nothing more to do"
    exit 0
  fi
  if [[ -z $landed ]]; then standing=$(jq -c 'select(.event == "queued")' <<<"$latest"); fi
  # Through the queue: queued is logged unless one stands for the head that is in the queue now (a
  # run before this one logged it, and this one goes on waiting) or the queue landed it already;
  # then team-land enqueues it, posts agent-review on each trial commit and waits, its lines shown
  # on stderr as it goes and its last the result.
  logged_queued=''
  if [[ -z $landed ]] && ! [[ -n $entry && -n $standing && $(jq -r .head <<<"$standing") == "$head" ]]; then
    ledger_append "$(jq -cn --arg task "$task" --arg url "$url" --arg head "$head" --arg project "$project" \
      '{ts: (now | todate), task: $task, event: "queued", url: $url, head: $head, project: $project}')"
    logged_queued=1
    refresh_inbox
  fi
  # team-land holds the word and the checks again (--holds) before each trial commit's
  # agent-review, by the task it is given.
  rc=0
  TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-land" --task "$task" "$url" "$head" | tee "$scratch/land" >&2 || rc=${PIPESTATUS[0]}
  landed_as=$(tail -n 1 "$scratch/land")
  # Whether the PR is in no queue now, and not merged, read again from GitHub: an end of team-land
  # that is neither merged nor dequeued leaves a queued standing only for a PR that may be in the
  # queue, so the readers never show one that is in none as queued. Fails when it is in the queue,
  # merged, or cannot be read, and after says which the read found: out, queued, merged (at the
  # head this run lands), elsewhere (merged at another head) or unread.
  after=unread
  out_of_queue() {
    after=unread
    # shellcheck disable=SC2016 # the query's variables are GraphQL's
    if github "$scratch" entry-after api graphql -f query='query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) { pullRequest(number: $number) { id state headRefOid mergeQueueEntry { state } } } }' \
      -f owner="${repo%%/*}" -f name="${repo#*/}" -F number="$number"; then
      after=$(jq -r --arg head "$head" '.data.repository.pullRequest | objects
        | if .state == "MERGED" then (if (.headRefOid // $head) == $head then "merged" else "elsewhere" end)
          elif .mergeQueueEntry == null then "out" else "queued" end' "$scratch/entry-after" 2>/dev/null) || after=unread
    fi
    [[ $after == out ]]
  }
  if ! outcome=$(jq -er 'select(.schema == "team-land/1") | .outcome | strings' <<<"$landed_as" 2>/dev/null); then
    if out_of_queue; then
      log_dequeued "team-land ended with no result (exit $rc); PR #$number is in no merge queue"
      die "team-land ended with no result (exit $rc), and PR #$number is in no merge queue: run team-merge $task again"
    fi
    die "team-land ended with no result (exit $rc), so whether PR #$number is in the queue is not known: run team-merge $task again"
  fi
  reason=$(jq -r '.reason // "team-land gave no reason"' <<<"$landed_as")
  case $outcome in
    merged)
      merge=$(jq -r '.merge // empty' <<<"$landed_as")
      [[ -n $merge ]] || die "PR #$number is merged but GitHub names no merge commit; log it by hand with what GitHub shows"
      ;;
    dequeued)
      # Another team-merge logged a dequeued meanwhile, with no lock: the one that refused the merge
      # and took the PR out, or one that found it out of the queue. That one stands for this
      # leaving of the queue, and no second is logged, unless team-land's result has failures,
      # which the readers need on the latest dequeued to send the PR back to the builder.
      latest=$(latest_queue_event) || jq_failed $?
      if [[ $(jq -r '.event // empty' <<<"$latest") == dequeued ]] && jq -e '(.failed // []) == []' <<<"$landed_as" >/dev/null; then
        echo "team-merge: PR #$number's dequeued is logged already, by another team-merge" >&2
      else
        log_dequeued "$reason" "$(jq -c '.failed // []' <<<"$landed_as")"
      fi
      {
        echo "team-merge: the merge queue dropped PR #$number, which is not merged: $reason"
        jq -r --arg base "$base" '.failed // [] | .[] | if .class == "rules" then "  \(.name) was not reported on the trial merge, which "
            + (if (.source // "rules") == "rules" then "\($base)\u0027s rules require" else "the project\u0027s required_checks require" end)
          elif .kind == "missing" then "  \(.name) was not reported on the trial merge while a workflow run there was still open, as \(.class)"
          else "  \(.name) failed on the trial merge"
            + (if .class == "pr" then "" else " as \(.class)" end)
            + (if (.step // "") == "" then "" else " (\(.step))" end)
            + (if (.link // "") == "" then "" else ": \(.link)" end) end' <<<"$landed_as"
        # A failure of the PR's own comes first, even beside a rules failure: the queue cancels the
        # rest of a trial commit it gives up, so a roll-up whose shards it cancelled reads as the
        # rules' once no run is open, and a rules gap that is real shows alone on the round's head.
        if jq -e 'any(.failed // [] | .[]; .class == "pr")' <<<"$landed_as" >/dev/null; then
          echo "  the trial merge failed what the head ${head:0:7} passed: render team-brief $task builder-merge-base for the builder, then a rereview"
        elif jq -e 'any(.failed // [] | .[]; .class == "rules")' <<<"$landed_as" >/dev/null; then
          echo "  $(ledger_jq '.failed // [] | rules_step($repo; $task)' -r --arg repo "$repo" --arg task "$task" <<<"$landed_as")"
        elif [[ ${reason%%;*} == checks_timed_out ]] || jq -e '(.failed // []) as $f
          | any($f[]; .class == "infrastructure" and (.kind | IN("queued", "missing")))
            and all($f[]; .class == "rollup" or (.class == "infrastructure" and (.kind | IN("queued", "missing"))))' <<<"$landed_as" >/dev/null; then
          # Runners behind: the queue's check timeout, or checks that waited on a runner (team-land
          # enqueued once more for those already), so a plain run again meets the same wait.
          echo "  the runners are behind, with nothing of the PR's to fix: tell Daniel, who may raise the check timeout of $repo's merge queue while the backlog stands, and run team-merge $task again once they say the runners are back"
        else
          echo "  run team-merge $task again once what dropped it is fixed"
        fi
      } >&2
      exit 1
      ;;
    waiting)
      echo "team-merge: $reason" >&2
      if out_of_queue; then
        log_dequeued "$reason; PR #$number is in no merge queue"
        echo "team-merge: PR #$number is in no merge queue: run team-merge $task again with run_in_background to enqueue it" >&2
      elif [[ $after == queued ]]; then
        echo "team-merge: the PR is still in the queue: run team-merge $task again with run_in_background to go on waiting" >&2
      elif [[ $after == unread ]]; then
        echo "team-merge: whether PR #$number is still in the queue is not known, GitHub unread: run team-merge $task again with run_in_background to go on waiting" >&2
      else
        echo "team-merge: PR #$number is merged by now: run team-merge $task again, which logs how it ended" >&2
      fi
      exit 75
      ;;
    refused)
      # team-land enqueued nothing, or found the PR merged at another head than this run lands: a
      # queued this run logged is ended, so none stands for a PR in no queue, and one that stood
      # before it is ended once the PR is read in no queue, or merged at another head.
      if out_of_queue; then why="$reason; PR #$number is in no merge queue"; else why=$reason; fi
      if [[ -n $logged_queued ]]; then
        log_dequeued "$reason"
        [[ $after == merged || $after == elsewhere ]] || die "PR #$number did not join the merge queue: $reason"
      elif [[ $after == out || $after == elsewhere ]]; then
        log_dequeued "$why"
      fi
      die "team-land refused PR #$number: $reason"
      ;;
    *) die "team-land ended $outcome, which is no outcome of its: check PR #$number on GitHub, then run team-merge $task again" ;;
  esac
else
  gh pr merge "$number" --repo "$repo" "--$method" --match-head-commit "$head" >&2 ||
    die "gh pr merge did not merge PR #$number (exit $?); nothing was logged"

  github "$scratch" after pr view "$number" --repo "$repo" --json state,mergeCommit,headRefOid,autoMergeRequest ||
    die "PR #$number's state cannot be read after gh pr merge ($(<"$scratch/error")); check it on GitHub before logging anything"
  if [[ $(jq -r .state "$scratch/after") != MERGED ]]; then
    if [[ $(jq -r .autoMergeRequest "$scratch/after") != null ]]; then
      gh pr merge "$number" --repo "$repo" --disable-auto >&2 ||
        die "PR #$number is still open after gh pr merge, with auto-merge on, and turning it off failed: turn it off on GitHub"
      die "PR #$number is still open after gh pr merge, with auto-merge on; turned auto-merge off, so nothing merges unseen"
    fi
    die "PR #$number is $(jq -r '.state | ascii_downcase' "$scratch/after") after gh pr merge, not merged; nothing was logged"
  fi
  merge=$(jq -r '.mergeCommit.oid // empty' "$scratch/after")
  [[ -n $merge ]] || die "PR #$number is merged but GitHub names no merge commit; log it by hand with what GitHub shows"
  [[ $(jq -r .headRefOid "$scratch/after") == "$head" ]] ||
    die "PR #$number was merged at $(jq -r '.headRefOid[:7]' "$scratch/after"), not at the checked head ${head:0:7}; check it on GitHub"
fi

team_exit_trap 'status=$?; ((status == 0)) || echo "team-merge: PR #$number is merged (merge $merge), but its merged event was not logged" >&2'
ledger_append "$(jq -cn --arg task "$task" --argjson pr "$number" --arg merge "$merge" --arg head "$head" \
  --arg by "$by" --arg project "$project" --arg branch "$branch" --arg message "$message" --arg channel "$channel" \
  --arg url "$url" --arg approval "$word" --argjson checks "$(printf '%s\n' "${local_checks[@]}" | jq -R . | jq -cs 'map(select(. != ""))')" \
  --argjson left "${phases_left:-null}" --argjson check_run "$(jq '.review_check_run // null' <<<"$facts")" \
  '{ts: (now | todate), task: $task, event: "merged", pr: $pr, merge: $merge, head: $head, by: $by,
    project: $project, branch: $branch}
    + if $message == "" then {} else {discord_message: $message, discord_channel: $channel} end
    + {url: $url} + if $approval == "" then {} else {approval: $approval} end
    + if $check_run == null then {} else {check_run: $check_run} end
    + if $checks == [] then {} else {local_checks: $checks} end
    + if $left == null then {} else {phases_left: $left} end')"
team_exit_trap -
jq -n --arg task "$task" --arg url "$url" --arg merge "$merge" --arg head "$head" --arg by "$by" \
  '{task: $task, pr: $url, merge: $merge, head: $head, by: $by}'
# Pushed now, before the steps that follow, so none of them failing can keep it off origin.
ledger_push
# The merge is logged: the task's lock is let go, so nothing the steps below start holds it.
if [[ -n $landing ]]; then exec {lock_fd}>&-; fi

# Mark the backlog file <file> done with PR <number> in its front matter, in place: status: done,
# and the number added to pr: unless there; prints changed or unchanged, or fails saying why on
# stderr, changing nothing: mark_story <file> <number>
mark_story() {
  local next=$1.$$
  if ! awk -v n="$2" '
    NR == 1 {
      if ($0 != "---") { print "it has no front matter" >"/dev/stderr"; bad = 1; exit 1 }
      fm = 1; print; next
    }
    fm && $0 == "---" {
      if (!status) print "status: done"
      if (!pr) print "pr: [" n "]"
      fm = 0; print; next
    }
    fm && /^status:/ { status = 1; print "status: done"; next }
    fm && /^pr:/ {
      pr = 1
      if ($0 !~ /^pr: *\[.*\] *$/) { print "its pr: line is no [...] list: " $0 >"/dev/stderr"; bad = 1; exit 1 }
      inner = $0; sub(/^pr: *\[/, "", inner); sub(/\] *$/, "", inner)
      if (inner ~ /^ *$/) { print "pr: [" n "]"; next }
      k = split(inner, items, /,/); has = 0; hash = 0
      for (i = 1; i <= k; i++) {
        item = items[i]; gsub(/^ +| +$/, "", item)
        if (item == n || item == "#" n) has = 1
        if (i == 1 && item ~ /^#/) hash = 1
      }
      if (has) print; else print "pr: [" inner ", " (hash ? "#" : "") n "]"
      next
    }
    { print }
    END {
      if (bad) exit 1
      if (NR == 0) { print "it is empty" >"/dev/stderr"; exit 1 }
      if (fm) { print "its front matter never ends" >"/dev/stderr"; exit 1 }
    }' "$1" >"$next"; then
    rm -f "$next"
    return 1
  fi
  if cmp -s "$1" "$next"; then
    rm -f "$next"
    echo unchanged
  else
    mv -f "$next" "$1"
    echo changed
  fi
}

# The task's story, when this PR is of the project it opened in, marked done with the PR in its
# backlog file; one that cannot be is said, and the merge stands.
story=$(jq -r --arg p "$project" 'map(select(.event == "opened")) | first | select(.project == $p) | .story // empty' <<<"$events")
if [[ -n $story ]]; then
  if story_path=$(story_file "$project" "$story" 2>"$scratch/story") &&
    marked=$(mark_story "$story_path" "$number" 2>"$scratch/story"); then
    if [[ $marked == changed ]]; then
      echo "team-merge: marked $story done with PR $number in ${story_path#"$TEAM_HOME/"}; the next checkpoint commits it" >&2
    else
      echo "team-merge: $story reads done with PR $number already in ${story_path#"$TEAM_HOME/"}" >&2
    fi
  else
    reason=$(grep -m 1 . "$scratch/story" || echo "it cannot be read")
    echo "team-merge: PR #$number is merged, but its story $story is not marked done: ${reason#team-merge: }" >&2
  fi
fi

# On the default word, Daniel hears of the merge at once, with how to revert it: one post in the
# task's thread and one in #coordinator, through team-post. A post that fails is said on stderr
# with its text, for the coordinator to post; the merge stands and the exit stays 0.
if [[ $word == default ]]; then
  if [[ -n $message ]]; then
    # Daniel's message as a link, which needs the guild: the one team-inbox keeps in inbox.json,
    # else Discord's.
    guild=$(jq -r --arg c "$COORDINATOR_CHANNEL" 'select((.channel | tostring) == $c) | .guild | tostring | select(test("^[0-9]+$"))' \
      "$HOME/.local/state/agent-team/inbox.json" 2>/dev/null) || guild=''
    if [[ -z $guild ]] && reply=$(discord_api "channels/$COORDINATOR_CHANNEL" --max-time 20 2>"$scratch/guild"); then
      guild=$(jq -r '.guild_id | strings | select(test("^[0-9]+$"))' <<<"$reply" 2>/dev/null) || guild=''
    fi
    if [[ -n $guild ]]; then
      on="the plan you approved, https://discord.com/channels/$guild/$channel/$message"
    else
      on="the plan you approved, $by"
      echo "team-merge: the posts name Daniel's message without a link: Discord named no guild for #coordinator: $(grep -m 1 . "$scratch/guild" 2>/dev/null || echo "its channel names none")" >&2
    fi
  else
    on=$by
  fi
  case $method in
    merge) revert="\`git revert -m 1 $merge\`" ;;
    squash) revert="\`git revert $merge\`" ;;
    # A rebase puts each of the PR's commits on the base, its merges of the base left out, the
    # last of them the merge commit GitHub names.
    rebase)
      rebased=$(jq '[.[] | select((.parents // []) | length < 2)] | length' <<<"$commits")
      revert="\`git revert $merge~$rebased..$merge\`, the $rebased rebased commits"
      ;;
  esac
  title=$(jq -r 'map(select(.event == "opened")) | first | .title // empty' <<<"$events")
  printf '%s\n' "$task${title:+ $title}: merged $url on $on" \
    "Merge commit: $merge on $base." \
    "To revert: the Revert button on the PR's page opens a revert PR; or, on $base, $revert." >"$scratch/post"
  # post <where> <team-post's arguments before --file>...
  post() {
    TEAM_HOME=$TEAM_HOME "$(dirname "$TEAM_LIB")/team-post" "${@:2}" --file "$scratch/post" >/dev/null 2>"$scratch/post-error" && return 0
    echo "team-merge: PR #$number is merged, but its post to $1 failed ($(grep -m 1 . "$scratch/post-error" || echo "team-post failed")); post this text with team-post ${*:2} --file <its file>:" >&2
    cat "$scratch/post" >&2
  }
  if [[ -n $thread ]]; then
    post "the task's thread $thread" "$task"
  else
    echo "team-merge: $task has no Discord thread, so Daniel hears of the merge in #coordinator alone" >&2
  fi
  post "#coordinator $COORDINATOR_CHANNEL" --coordinator
fi

# The code checkout this runs from, when it is the merged project's primary checkout, follows the
# base: fast-forwarded to origin's when it is on the base and clean, otherwise left as it is,
# saying why and how. git replaces each file it changes, so a script running from it reads on.
code=$(cd "$(dirname "$TEAM_LIB")/.." && pwd -P)
primary=$(team_project "$project" path)
if same_path "$primary" "$code"; then
  bring="to bring in the merged code: git -C $code switch $base && git -C $code pull --ff-only origin $base"
  NET_ERR=$scratch/net-err
  if follow_base "$code" "$base"; then
    echo "team-merge: the code checkout $code: $FF_RESULT" >&2
  else
    echo "team-merge: the code checkout $code is left as it is: $FOLLOW_REASON; $bring" >&2
  fi
fi
refresh_inbox
