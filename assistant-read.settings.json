{
  "remoteControlAtStartup": false,
  "disableBundledSkills": true,
  "disableSkillShellExecution": true,
  "enabledPlugins": {
    "discord@claude-plugins-official": false,
    "mongodb-atlas@claude-plugins-official": false,
    "cc-plugin-plugin-authoring@builtin": false,
    "cc-plugin-easel@builtin": false
  },
  "permissions": {
    "allow": ["mcp__prod-read__*", "mcp__vercel-read__*", "Edit(./.scratch/answer.md)"],
    "deny": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent",
      "NotebookEdit",
      "Read(//proc/**)",
      "Read(**/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/scratch-only-edits", "args": [".scratch/answer.md"], "onFailure": "block", "timeout": 30 }]
      },
      {
        "matcher": "^mcp__.*(prod-read|vercel-read).*__",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/ops-log", "args": ["@LOG_DIR@"], "onFailure": "block", "timeout": 30 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*(prod-read|vercel-read).*__",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/ops-log", "args": ["@LOG_DIR@"] }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__.*(prod-read|vercel-read).*__",
        "hooks": [{ "type": "command", "command": "@TEAM_CODE@/bin/hooks/ops-log", "args": ["@LOG_DIR@"] }]
      }
    ]
  },
  "env": {
    "MCP_TIMEOUT": "120000",
    "AGENT_TEAM_ROLE": "assistant-read"
  }
}
