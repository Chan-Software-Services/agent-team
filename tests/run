#!/usr/bin/env bash
# Run the code's checks: shellcheck on every shell script in bin/, tests/ (not the
# vendored bats), servers/ and toolkits/, then the whole bats suite on the vendored bats-core,
# then the toolkit tests (node --test on tests/toolkits/, after servers/install), which need
# Docker for their throwaway MongoDB, then the Rust check (below). Each toolkit test and hook
# has a 5-minute limit (node --test's --test-timeout), so a stuck one fails with its name long
# before CI's job limit, and each file's process ends once its tests have (--test-force-exit),
# whatever a failed test left running, so node --test never waits on it.
# The bats files run as many at once as the team's CPU budget allows, each in a bats of its own
# (every test is sandboxed, so files share nothing), the slowest first by tests/shards' weights:
# one line per file as it ends, then the whole output of each file that failed, each skipped
# test's line as "tests/<file>.bats: ok <n> <name> # skip <reason>" (a skip counts as passed),
# and the count of tests passed. Each test has a time limit, TESTS_TEST_SECONDS (default 600, as
# bats' BATS_TEST_TIMEOUT), past which bats fails it as "not ok <n> <name> # timeout after <s>s";
# each file one, TESTS_FILE_MINUTES (default 40), past which it is stopped (timeout -k 30) as
# "not ok tests/<name>.bats (<n>s): stopped at its <m>-minute limit", its output so far printed as a
# failed file's, with a line saying the test after its last line was still running or a process
# it left held its output open; each a whole number above 0, else refused.
# How many at once is TEAM_JOBS when set (a whole number above 0, else refused), else, when a
# team home is found, team-capacity jobs (the floor of the level's CPU budget, at
# least 1: 3 at minor on 12 cores), else nproc (CI, a fresh clone).
# Every part but shellcheck alone, rust alone and a --list (a shard's, --changed's or
# --clock-ahead's) runs under the machine's heavy-run lock (team-heavy run, whose cost sample is
# heavy:tests-run), so a suite waits for another suite or a gate's end-to-end run instead of
# overlapping it; under a heavy run already (TEAM_HEAVY_HELD set, as a local check team-checks
# runs), it runs at once.
#
# Usage: tests/run [shellcheck [--changed [<base>] [--list]]|bats [--shard <k>/<n> [--list]|--changed [<base>] [--list]|--clock-ahead <days> --touched <base> [--list]]|toolkits|rust [--changed [<base>] [--list]]]
#        (default: all four)
# With --changed, shellcheck checks only the shell scripts a change touches, in seconds, as a
# builder does on its machine while CI checks every script: each shell script among the paths
# changed since <base> and in the working tree (the paths bats --changed starts from, below), and
# each shell script that sources a changed path, by its file name, where a line runs source or .
# (first or after another command) or in a "# shellcheck source=" directive, the file read past
# its command substitutions, and each that sources one of those in turn, so a
# changed library is checked where it is read; a deleted path is never checked itself, only its
# sourcers. A changed .shellcheckrc checks every script. It prints the scripts first, checks
# nothing, and says so, when the change reaches no shell script, and --list prints them, one path
# per line, and checks none.
# With --shard, bats runs shard k of n of the files as tests/shards splits them, by each file's
# seconds in CI (TESTS_TIMINGS' file, else tests/timings.tsv), as CI's shard jobs do; --list
# prints that shard's files and runs none. A shard with no file (n above the file count) passes,
# running nothing.
# With --changed, bats runs the files a change reaches, by the repository's naming, from the paths
# changed since <base> (default origin/dev: git diff --name-only --no-renames <base>...HEAD) and in
# the working tree (git status --porcelain, untracked files included), both sides of a rename and
# a deleted path among them, printing them first; it runs nothing, and says so, when no path
# changed, and --list prints them, one tests/<name>.bats per line, and runs none. Every changed
# path reaches tests/repo.bats; one under bin/, roles/, templates/, settings/ or plugins/ also
# tests/coordinator-manual.bats; a script (bin/team-<x>, bin/claude-coordinator, a hook under
# bin/hooks/) its own tests/<script>.bats and tests/<script>-*.bats, every bats file that names it
# as a word, and those of each script under bin/ that names it (a doctor check that names it, what
# a doctor check reaches); bin/lib/doctor.d/* the tests/team-doctor*, team-bootstrap*,
# team-load-check and team-resume files and what bin/team-doctor reaches, which runs every check;
# any other file of bin/lib/ the bats files named after it or naming lib/<it>, and those of each
# file under bin/ that names lib/<it> or, for a .jq module, includes or imports it (a bin/lib file
# through its own users in turn); tests/helpers/<h> the bats files naming helpers/<h> outside a
# comment (a .bash helper without .bash, as load names it), and those of each helper naming it so;
# tests/<f>.bats itself; any other file under tests/ the bats files named after it or naming its
# path; any other path (roles/, templates/, sops/, a root file such as CLAUDE.md) the bats files
# naming it or one of its directories as <dir>/; and every file, bin/lib/team.sh,
# bin/lib/platform.sh, bin/lib/ledger.jq, bin/lib/ledger-contract.json, tests/helpers/common.bash,
# tests/run, tests/shards, tests/fixtures/ or tests/vendor/, and each file under bin/ that team.sh
# or platform.sh reads or runs in its code ($TEAM_LIB/<file>, a bin/ script, a jq include:
# tools.jq, tools.lock, records, guarded, team-project, team-lease and others), which every test
# runs through. The library's and the harness's own files listed above are never followed as a
# caller or user of a changed file, or most of bin/lib would reach the whole suite; a file the
# library reads or runs is, like any other. A named base that is no commit is a usage error; a
# missing origin/dev is refused.
# With --clock-ahead <days> --touched <base>, bats runs the files a change touches with the wall
# clock <days> days ahead (a whole number from 1 to 99999), as CI's future-clock job does, so a test
# that will fail on a later date fails in the change that writes it: each tests/<name>.bats file the
# diff from <base> to the working tree adds or changes (git diff --name-only --no-renames <from>,
# untracked files included, <from> being the merge base of <base> and HEAD when <base> is a commit,
# else <base> itself, a tree such as the empty tree's, for every file), and each tests/*.bats file
# that names a path under tests/fixtures/ the diff changes, or one of that path's directories
# there, as fixtures/<path> with no name character on either side, itself or through a
# tests/helpers/*.bash it loads (as bats --changed follows a helper). It prints the files first;
# when there is none it prints "clock-ahead: no bats file touched since <base>" and passes, and
# --list prints them, one tests/<name>.bats per line, and runs none, on any platform. Otherwise it
# runs only on Linux, refusing macOS, which has no LD_PRELOAD, and any other system, and refuses
# when cc is not on PATH, naming it, before it takes the heavy-run lock; it builds
# tests/helpers/clockshift.c with cc -shared -fPIC -O2 -ldl into its temporary directory, fails
# naming the shim when date +%s or jq's now under it does not read the clock moved ahead (a static
# jq, as the jq release binary is, never loads it, so a dynamically linked one must be first on
# PATH, as CI's future-clock job builds it), and runs each file
# with LD_PRELOAD the shim (before any LD_PRELOAD already set) and CLOCKSHIFT_SECONDS the days'
# seconds, and with bats' --filter-tags '!wall-clock', so a test tagged "# bats
# test_tags=wall-clock" (one whose result rests on a clock the shim does not move, such as the
# times the kernel writes on files) is not run; it names each such test of the files it runs, as
# "tests/<name>.bats: <test> # not run: tagged wall-clock", after the file lines. What the shim
# moves and what it does not, its header says.
# The rust part checks the Cargo workspace at the root in six steps, each printed first as
# "rust: <step>", stopping at the first that fails with "rust: <step> failed": cargo fmt --all
# --check; cargo clippy --workspace --all-targets --locked -- -D warnings; cargo nextest run
# --workspace --locked --no-tests=pass; cargo test --doc --workspace --locked (nextest runs no doc
# test); cargo-deny --locked --config deny.toml check, which fetches the advisory database; and the
# policy's refusal, cargo-deny --offline on tests/fixtures/rust-deny with the root's deny.toml,
# which passes only when it fails naming refused-license and GPL-3.0-only. It first names each of
# cargo, cargo-nextest and cargo-deny missing from PATH, and team-doctor, and fails. It sets
# CARGO_BUILD_JOBS and NEXTEST_TEST_THREADS to TEAM_JOBS, else team-capacity jobs when a team home is
# found, else neither (cargo's default, the CPU count: CI, a fresh clone), and RUSTC_WRAPPER to
# sccache when it is unset and sccache is on PATH. Alone, it takes no heavy-run lock: the skeleton
# builds in seconds; once it passes 5 minutes or 4 GiB of peak memory on home-pc, the task that sees
# it puts it under team-heavy. With --changed, it runs only when a Rust path changed since <base>
# (the paths bats --changed starts from): Cargo.toml, Cargo.lock, clippy.toml, deny.toml,
# rust-toolchain.toml, tests/run, .github/workflows/ci.yml, .github/workflows/rust-macos.yml, or
# anything under crates/, tests/fixtures/rust-deny/, toolkits/rust/ or
# tests/toolkits/fixtures/rust-crate/, printing them first, and otherwise prints "rust: no Rust
# path changed, nothing to check" and passes; --list prints those paths, one per line, and runs
# nothing.
# After the bats, it names each file that took over 1.5 times and 60 seconds more than its seconds
# in the timings for this platform, as a warning annotation under GitHub Actions, advising to find
# what slowed it. TESTS_TIMINGS names the timings file it and tests/shards read (default
# tests/timings.tsv), and TESTS_SLOWER_BY the margin in seconds (a whole number, default 60, else
# refused); neither changes the exit code. On CI, TESTS_TIMINGS names shard-plan's timings, the
# latest successful run's seconds (a copy of the committed tests/timings.tsv only when that job
# cannot read a run, which it warns of), so refreshing the committed file changes only that there; a
# run without TESTS_TIMINGS, a local one, reads the committed file, which goes stale, so only then
# does the advice add refreshing it with tests/shards update if its seconds are stale.
# Exit 0 when every check passes; CI runs each part as its own job. The last line is the wall
# time, so a slower suite shows, and when the bats ran, how many files at once.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# The suite needs no team home (every test makes its own), as on CI or a fresh clone.
# shellcheck disable=SC2034 # read by bin/lib/team.sh
team_home_report=1
# shellcheck source=bin/lib/team.sh
source "$root/bin/lib/team.sh" "$@"

usage="usage: tests/run [shellcheck [--changed [<base>] [--list]]|bats [--shard <k>/<n> [--list]|--changed [<base>] [--list]|--clock-ahead <days> --touched <base> [--list]]|toolkits|rust [--changed [<base>] [--list]]]"
what=${1:-all} shard='' changed='' base='' list='' clock=''
if [[ ($what == bats || $what == shellcheck || $what == rust) && $# -gt 1 && $2 == --changed ]]; then
  changed=1 base=origin/dev
  rest=("${@:3}")
  if [[ ${#rest[@]} -gt 0 && ${rest[0]} != -* ]]; then base=${rest[0]} rest=("${rest[@]:1}"); fi
  if [[ ${#rest[@]} -gt 0 ]]; then
    [[ ${#rest[@]} -eq 1 && ${rest[0]} == --list ]] || usage_error "$usage"
    list=1
  fi
  if ! git -C "${root:?}" rev-parse --verify --quiet "$base^{commit}" >/dev/null; then
    [[ $# -gt 2 && $3 == "$base" ]] || die "no $base to compare with in $root: fetch it, or name a base (tests/run $what --changed <base>)"
    usage_error "--changed: no commit $base; $usage"
  fi
elif [[ $what == bats && $# -gt 1 && $2 == --clock-ahead ]]; then
  [[ ($# -eq 5 || ($# -eq 6 && $6 == --list)) && $3 =~ ^[1-9][0-9]{0,4}$ && $4 == --touched ]] || usage_error "$usage"
  clock=$3 base=$5
  [[ $# -eq 5 ]] || list=1
  git -C "${root:?}" rev-parse --verify --quiet "$base^{tree}" >/dev/null || usage_error "--touched: no commit or tree $base; $usage"
  if [[ -z $list ]]; then
    case $(uname -s) in
      Linux) ;;
      Darwin) die "--clock-ahead runs only on Linux: macOS has no LD_PRELOAD to load tests/helpers/clockshift.c into every process" ;;
      *) die "--clock-ahead runs only on Linux, whose LD_PRELOAD loads tests/helpers/clockshift.c into every process, not on $(uname -s)" ;;
    esac
    command -v cc >/dev/null || die "--clock-ahead builds tests/helpers/clockshift.c with cc, and no cc is on PATH: install a C compiler"
  fi
elif [[ $what == bats && $# -gt 1 ]]; then
  if ! [[ $# -le 4 && $2 == --shard && ${3:-} =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] ||
    ((BASH_REMATCH[1] > BASH_REMATCH[2])); then
    usage_error "$usage"
  fi
  shard=$3
  if [[ $# -eq 4 ]]; then [[ $4 == --list ]] || usage_error "$usage"; list=1; fi
else
  [[ $# -le 1 && $what =~ ^(all|shellcheck|bats|toolkits|rust)$ ]] || usage_error "$usage"
fi

if [[ -n ${TEAM_JOBS:-} && ! $TEAM_JOBS =~ ^[1-9][0-9]*$ ]]; then
  die "TEAM_JOBS is the count of bats files or cargo jobs to run at once, a whole number above 0, not '$TEAM_JOBS'"
fi
if [[ -n ${TESTS_SLOWER_BY+set} && ! $TESTS_SLOWER_BY =~ ^[0-9]+$ ]]; then
  die "TESTS_SLOWER_BY is the seconds a bats file may take over its timing, a whole number, not '$TESTS_SLOWER_BY'"
fi
if [[ -n ${TESTS_TEST_SECONDS+set} && ! $TESTS_TEST_SECONDS =~ ^[1-9][0-9]*$ ]]; then
  die "TESTS_TEST_SECONDS is the seconds a bats test may run, a whole number above 0, not '$TESTS_TEST_SECONDS'"
fi
if [[ -n ${TESTS_FILE_MINUTES+set} && ! $TESTS_FILE_MINUTES =~ ^[1-9][0-9]*$ ]]; then
  die "TESTS_FILE_MINUTES is the minutes a bats file may run, a whole number above 0, not '$TESTS_FILE_MINUTES'"
fi
test_seconds=${TESTS_TEST_SECONDS:-600} file_minutes=${TESTS_FILE_MINUTES:-40}

# Every part but shellcheck alone, rust alone and a --list runs under the machine's heavy-run
# lock (bin/team-heavy).
if [[ $what != shellcheck && $what != rust && -z $list && -z ${TEAM_HEAVY_HELD:-} ]]; then
  exec "$root/bin/team-heavy" run --label "tests/run ${*:-all} in ${root/#"$HOME"/\~}" --kind tests-run -- "$0" "$@"
fi

# Every file under bin/, tests/, servers/ and toolkits/ that is a shell script by its shebang or
# extension.
shell_scripts() {
  local file
  while IFS= read -r file; do
    if [[ $file == *.sh || $file == *.bash || $file == *.bats ]] ||
      head -n 1 "$root/$file" | grep -Eq '^#!.*\b(ba)?sh\b'; then
      echo "$file"
    fi
  done < <(cd "$root" && find bin tests servers toolkits \( -path tests/vendor -o -path servers/node_modules -o -path 'servers/.*' \) -prune -o -type f -print | sort)
}

# The tests/*.bats files to run, the slowest first (so none of them starts last), one path per
# line: every one, with --shard k/n only shard k's (tests/shards), with --changed or --clock-ahead
# only the selection's ($selected).
bats_files() {
  local k=1 n=1
  if [[ -n $shard ]]; then k=${shard%/*} n=${shard#*/}; fi
  "$root/tests/shards" "$n" | awk -F'\t' -v k="$k" -v root="$root" -v changed="$changed$clock" -v selected="$selected" '
    BEGIN { n = split(selected, list, "\n"); for (i = 1; i <= n; i++) chosen[list[i]] = 1 }
    $1 == k && (changed == "" || $3 in chosen) { print root "/" $3 }'
}

# The shell scripts shellcheck --changed checks (see the header), one path per line, sorted.
changed_scripts() {
  local paths scripts checked lines status=0
  paths=$(changed_paths | sort -u) || return 1
  scripts=$(shell_scripts)
  mapfile -t checked <<<"$scripts"
  if grep -qxF .shellcheckrc <<<"$paths"; then
    echo "$scripts"
    return
  fi
  # Each script's lines that may source a file, as "<script>:<line>", then the changed paths, then
  # the scripts: a script is checked when it changed, or when a file such a line sources has the
  # file name of a changed path or of a script checked for that.
  lines=$(cd "$root" && grep -HE '(^|[^[:alnum:]_.-])source[[:space:]]|(^|[;&|[:space:]])\.[[:space:]]|#[[:space:]]*shellcheck[[:space:]]+source=' -- "${checked[@]}") ||
    status=$?
  ((status <= 1)) || return 1
  {
    [[ -z $lines ]] || echo "$lines"
    echo
    echo "$paths"
    echo
    echo "$scripts"
  } | awk '
    function name(path) { sub(/.*[\/=]/, "", path); return path }
    $0 == "" { part++; next }
    part == 0 {
      script = $0; sub(/:.*/, "", script)
      line = substr($0, length(script) + 2)
      # A comment sources nothing but by its directive; any other line wherever it runs source or
      # ., after another command or a # as well as first.
      runs = "#[[:space:]]*shellcheck[[:space:]]+source="
      if (line !~ /^[[:space:]]*#/) runs = runs "|(^|[^[:alnum:]_.-])source[[:space:]]+|(^|[;&|[:space:]])\\.[[:space:]]+"
      while (match(line, runs)) {
        line = substr(line, RSTART + RLENGTH)
        # The file is the first word, past its command substitutions, nested ones from the inside
        # out, such as $(dirname "$0") or $(cd "$(dirname "$0")" && pwd).
        file = line
        while (gsub(/\$\([^()]*\)/, "", file)) {}
        sub(/[[:space:];].*/, "", file)
        gsub(/["\047\\]/, "", file)
        if (file != "") sourcers[name(file)] = sourcers[name(file)] "\n" script
      }
      next
    }
    part == 1 { changed[$0] = 1; queue[++last] = name($0); next }
    { scripts[$0] = 1; if ($0 in changed) pick[$0] = 1 }
    END {
      for (at = 1; at <= last; at++) {
        if (queue[at] in followed) continue
        followed[queue[at]] = 1
        n = split(sourcers[queue[at]], users, "\n")
        for (i = 2; i <= n; i++) if (!(users[i] in pick)) { pick[users[i]] = 1; queue[++last] = name(users[i]) }
      }
      for (script in pick) if (script in scripts) print script
    }' | LC_ALL=C sort
}

# The paths --changed starts from (see the header), one per line, relative to the checkout.
changed_paths() {
  local entry
  git -C "${root:?}" diff --name-only --no-renames "$base...HEAD"
  while IFS= read -r -d '' entry; do
    echo "${entry:3}"
    # A rename or copy's entry is followed by its source's path.
    if [[ ${entry:0:2} == *[RC]* ]]; then IFS= read -r -d '' entry && echo "$entry"; fi
  done < <(git -C "${root:?}" status --porcelain=v1 -z --untracked-files=all)
}

# The files the selection reads, from the checkout's root: the bats files that grep "$@" matches,
# the matches of an existing glob, and the files under bin/ a change can reach a script through.
naming() { grep -l "$@" tests/*.bats || (($? == 1)); }
glob() { compgen -G "$1" || true; }
own_files() { glob "tests/$1.bats"; glob "tests/$1-*.bats"; }
bin_files() { find bin -path bin/lib/vendor -prune -o -type f -print; }
doctor_files() {
  glob 'tests/team-doctor*.bats'
  glob 'tests/team-bootstrap*.bats'
  glob 'tests/team-load-check.bats'
  glob 'tests/team-resume.bats'
}
# The files under bin/ that bin/lib/team.sh and platform.sh read or run in their code (not in a
# comment), as $TEAM_LIB/<file>, $TEAM_LIB/../<script>, $(dirname "$TEAM_LIB")/<script> or a jq
# include or import, one path per line: every script that sources the library runs them.
library_reads() {
  grep -hv '^[[:space:]]*#' bin/lib/team.sh bin/lib/platform.sh |
    grep -oE '\$TEAM_LIB/(\.\./)?[A-Za-z0-9._-]+|\$\(dirname "\$TEAM_LIB"\)/[A-Za-z0-9._-]+|(include|import) "[A-Za-z0-9_-]+"' |
    sed -E -e 's#^\$TEAM_LIB/\.\./#bin/#' -e 's#^\$TEAM_LIB/#bin/lib/#' -e 's#^\$\(dirname "\$TEAM_LIB"\)/#bin/#' \
      -e 's#^(include|import) "(.*)"$#bin/lib/\2.jq#' || true
}
# The library and the test harness, which every test runs through, and whose mentions of other
# files are never followed (team.sh's would take most of bin/lib to the whole suite).
fixed_whole_suite() {
  case $1 in
    bin/lib/team.sh | bin/lib/platform.sh | bin/lib/ledger.jq | bin/lib/ledger-contract.json) ;;
    tests/helpers/common.bash | tests/run | tests/shards | tests/fixtures/* | tests/vendor/*) ;;
    *) return 1 ;;
  esac
}
# The paths whose change reaches every file: those, and what the library reads or runs. A file the
# library reads or runs is still followed as a caller or user like any other.
declare -A library_read=()
whole_suite() { fixed_whole_suite "$1" || [[ -n ${library_read[$1]:-} ]]; }

# A doctor check's: the doctor's, bootstrap's, load check's and resume's bats files, and what
# bin/team-doctor reaches, since every check runs inside it.
doctor_reach() {
  doctor_files
  script_reach bin/team-doctor
}

# A script's bats files: its own and those naming it as a word.
script_files() { own_files "$1" && naming -wF -- "$1"; }

# A script's (bin/team-<x>, bin/claude-coordinator, a hook): its own, and its callers' under bin/.
declare -A script_seen=()
script_reach() {
  local name=${1##*/} caller
  [[ -z ${script_seen[$1]:-} ]] || return 0
  script_seen[$1]=1
  script_files "$name"
  while IFS= read -r caller; do
    if [[ $caller == "$1" ]] || fixed_whole_suite "$caller"; then continue; fi
    case $caller in
      bin/lib/doctor.d/*) doctor_reach ;;
      bin/team-* | bin/claude-coordinator | bin/hooks/*) script_files "${caller##*/}" ;;
    esac
  done < <(bin_files | xargs grep -lwF -- "$name" || true)
}

# A bin/lib file's (or directory's, by its first part under bin/lib/): the files named after it
# or naming lib/<it>, and its users' under bin/, each bin/lib one once.
declare -A lib_seen=()
lib_reach() {
  local key=${1#bin/lib/} pattern user
  key=${key%%/*}
  [[ -z ${lib_seen[$key]:-} ]] || return 0
  lib_seen[$key]=1
  pattern="lib/${key//./\\.}([^A-Za-z0-9_-]|\$)"
  own_files "${key%.*}"
  naming -E -- "$pattern"
  [[ $key != *.jq ]] || pattern+="|(include|import) \"${key%.jq}\""
  while IFS= read -r user; do
    if [[ $user == bin/lib/"$key" || $user == bin/lib/"$key"/* ]] || fixed_whole_suite "$user"; then continue; fi
    case $user in
      bin/lib/doctor.d/*) doctor_reach ;;
      bin/lib/*) lib_reach "$user" ;;
      *) script_reach "$user" ;;
    esac
  done < <(bin_files | xargs grep -lE -- "$pattern" || true)
}

# A tests/helpers file's: the bats files naming helpers/<it> outside a comment (as `load
# helpers/<it>` does), and those of each helper naming it so.
declare -A helper_seen=()
helper_reach() {
  local key=${1#tests/helpers/} pattern helper
  key=${key%.bash}
  [[ -z ${helper_seen[$key]:-} ]] || return 0
  helper_seen[$key]=1
  pattern="^[^#]*helpers/${key//./\\.}([^A-Za-z0-9_-]|\$)"
  naming -E -- "$pattern"
  while IFS= read -r helper; do
    [[ $helper != "$1" ]] || continue
    if fixed_whole_suite "$helper"; then glob 'tests/*.bats'; else helper_reach "$helper"; fi
  done < <(grep -lE -- "$pattern" tests/helpers/*.bash || true)
}

# The bats files one changed path reaches (see the header), one per line, repeats and all.
reach() {
  local dir
  echo tests/repo.bats
  case $1 in
    bin/* | roles/* | templates/* | settings/* | plugins/*) echo tests/coordinator-manual.bats ;;
  esac
  case $1 in
    bin/lib/doctor.d/*) doctor_reach ;;
    bin/lib/*) lib_reach "$1" ;;
    bin/team-* | bin/claude-coordinator | bin/hooks/*) script_reach "$1" ;;
    tests/helpers/*) helper_reach "$1" ;;
    tests/*/*) own_files "$(basename "${1%.*}")"; naming -F -- "$1" ;;
    tests/*.bats) echo "$1" ;;
    tests/*) own_files "$(basename "${1%.*}")"; naming -F -- "$1" ;;
    *)
      naming -F -- "$1"
      dir=$1
      while [[ $dir == */* ]]; do
        dir=${dir%/*}
        naming -F -- "$dir/"
      done ;;
  esac
}

# The bats files --changed runs (see the header), one tests/<name>.bats per line, sorted: every
# one when a changed path is a whole-suite one, none when no path changed.
changed_selection() {
  local paths path
  paths=$(changed_paths | sort -u) || return 1
  cd "$root"
  while IFS= read -r path; do [[ -z $path ]] || library_read[$path]=1; done < <(library_reads)
  while IFS= read -r path; do
    if [[ -n $path ]] && whole_suite "$path"; then
      glob 'tests/*.bats'
      return
    fi
  done <<<"$paths"
  while IFS= read -r path; do
    [[ -z $path ]] || reach "$path"
  done <<<"$paths" | while IFS= read -r path; do
    [[ ! -f $path ]] || echo "$path"
  done
}

# The paths --clock-ahead starts from (see the header), one per line, relative to the checkout:
# the diff from <base>, or from its merge base with HEAD when it is a commit, to the working tree,
# and the untracked files.
clock_paths() {
  local from=$base
  if git -C "${root:?}" rev-parse --verify --quiet "$base^{commit}" >/dev/null; then
    from=$(git -C "${root:?}" merge-base "$base" HEAD) || return 1
  fi
  git -C "${root:?}" diff --name-only --no-renames "$from" || return 1
  git -C "${root:?}" ls-files --others --exclude-standard
}

# <text> as an extended regular expression matching it literally.
literal_ere() {
  local text=${1//\\/\\\\} c
  for c in . '[' ']' '*' '^' '$' '+' '?' '(' ')' '{' '}' '|'; do text=${text//"$c"/\\$c}; done
  echo "$text"
}

# The bats files --clock-ahead runs (see the header), one tests/<name>.bats per line, repeats and
# all: the changed ones, and those naming a changed fixture or one of its directories, directly or
# through a helper they load.
clock_selection() {
  local paths path rel pattern helper fixture_names=()
  paths=$(clock_paths | LC_ALL=C sort -u) || return 1
  cd "$root"
  while IFS= read -r path; do
    case $path in
      tests/*/*) ;;
      tests/*.bats) [[ ! -f $path ]] || echo "$path" ;;
    esac
    [[ $path == tests/fixtures/?* ]] || continue
    rel=${path#tests/}
    while [[ $rel == fixtures/?* ]]; do
      fixture_names+=("$(literal_ere "$rel")")
      rel=${rel%/*}
    done
  done <<<"$paths"
  ((${#fixture_names[@]})) || return 0
  pattern="(^|[^A-Za-z0-9._-])($(IFS='|' && echo "${fixture_names[*]}"))([^A-Za-z0-9._-]|\$)"
  naming -E -- "$pattern"
  while IFS= read -r helper; do
    helper_reach "$helper"
  done < <(grep -lE -- "$pattern" tests/helpers/*.bash || (($? == 1)))
}

# The team's count of jobs at once (see the header): TEAM_JOBS when set, else team-capacity jobs
# when a team home is found, else nothing.
budget_jobs() {
  if [[ -n ${TEAM_JOBS:-} ]]; then
    echo "$TEAM_JOBS"
  elif [[ -z $TEAM_HOME_PROBLEM && -n $TEAM_HOME && -d $TEAM_HOME ]]; then
    TEAM_HOME=$TEAM_HOME "$root/bin/team-capacity" jobs
  fi
}

# How many bats files run at once (see the header), read once the heavy-run lock is held: the
# team's count, else nproc.
parallelism() {
  local count
  count=$(budget_jobs)
  if [[ -n $count ]]; then echo "$count"; else nproc; fi
}

# The Rust paths (see the header), as an extended regular expression on a path from the root.
rust_paths='^(Cargo\.toml|Cargo\.lock|clippy\.toml|deny\.toml|rust-toolchain\.toml|tests/run|\.github/workflows/(ci|rust-macos)\.yml|(crates|tests/fixtures/rust-deny|toolkits/rust|tests/toolkits/fixtures/rust-crate)/.+)$'

# The changed Rust paths, one per line, sorted (see the header).
changed_rust_paths() {
  local paths
  paths=$(changed_paths | LC_ALL=C sort -u) || return 1
  grep -E -- "$rust_paths" <<<"$paths" || (($? == 1))
}

# The Rust check's six steps in the root, each named on a line of its own first, stopping at the
# first that fails, naming it (see the header).
run_rust() {
  local tool missing=() count step deny_out deny_rc
  for tool in cargo cargo-nextest cargo-deny; do
    command -v "$tool" >/dev/null || missing+=("$tool")
  done
  if ((${#missing[@]} == 1)); then
    echo "rust: ${missing[0]} is not on PATH: run team-doctor, whose tool lines name each fix"
    return 1
  elif ((${#missing[@]} > 1)); then
    local names=${missing[0]} i
    for ((i = 1; i < ${#missing[@]} - 1; i++)); do names+=", ${missing[i]}"; done
    echo "rust: $names and ${missing[-1]} are not on PATH: run team-doctor, whose tool lines name each fix"
    return 1
  fi
  count=$(budget_jobs)
  [[ -z $count ]] || export CARGO_BUILD_JOBS=$count NEXTEST_TEST_THREADS=$count
  if [[ -z ${RUSTC_WRAPPER+set} ]] && command -v sccache >/dev/null; then export RUSTC_WRAPPER=sccache; fi
  cd "$root"
  for step in 'cargo fmt --all --check' \
    'cargo clippy --workspace --all-targets --locked -- -D warnings' \
    'cargo nextest run --workspace --locked --no-tests=pass' \
    'cargo test --doc --workspace --locked' \
    'cargo-deny --locked --config deny.toml check'; do
    echo "rust: $step"
    # Each step is a fixed command of words with no quoting, split on its blanks.
    # shellcheck disable=SC2086
    $step || { echo "rust: $step failed"; return 1; }
  done
  step="the policy refuses tests/fixtures/rust-deny's refused-license (GPL-3.0-only)"
  echo "rust: $step"
  deny_rc=0
  deny_out=$(cargo-deny --offline --manifest-path tests/fixtures/rust-deny/Cargo.toml --config deny.toml check licenses 2>&1) ||
    deny_rc=$?
  if ((deny_rc == 0)) || [[ $deny_out != *refused-license* || $deny_out != *GPL-3.0-only* ]]; then
    printf 'rust: %s failed: cargo-deny exited %d, naming refused-license: %s, GPL-3.0-only: %s; its output:\n%s\n' "$step" "$deny_rc" \
      "$([[ $deny_out == *refused-license* ]] && echo yes || echo no)" "$([[ $deny_out == *GPL-3.0-only* ]] && echo yes || echo no)" \
      "$deny_out"
    return 1
  fi
}

# One line for each bats file whose seconds in <dir>/<name>.seconds exceed both 1.5 times and
# TESTS_SLOWER_BY more than its seconds in the timings (see the header) for this platform, with its
# advice (see the header), and under GitHub Actions the same text as a warning annotation; a file
# the timings lack, or lack for this platform, is never named.
slow_files() {
  local dir=$1 file column=linux label=${TESTS_TIMINGS:-tests/timings.tsv} timings
  local advice='find what slowed it'
  [[ -n ${TESTS_TIMINGS:-} ]] ||
    advice+=', or refresh tests/timings.tsv with tests/shards update if its seconds are stale'
  timings=${TESTS_TIMINGS:-$root/tests/timings.tsv}
  [[ $(uname -s) != Darwin ]] || column=macos
  [[ -f $timings ]] || return 0
  for file in "$dir"/*.seconds; do
    [[ -e $file ]] || continue
    printf 'tests/%s\t%s\n' "$(basename "$file" .seconds)" "$(<"$file")"
  done | awk -F'\t' -v column="$column" -v margin="${TESTS_SLOWER_BY:-60}" -v label="$label" \
    -v advice="$advice" -v annotate="$([[ ${GITHUB_ACTIONS:-} == true ]] && echo 1)" '
    FILENAME != "-" {
      if (/^#/) next
      if ($1 == "file") { for (i = 2; i <= NF; i++) if ($i == column) c = i; next }
      if (c && $c ~ /^[0-9]+$/) seconds[$1] = $c
      next
    }
    ($1 in seconds) && $2 > seconds[$1] * 1.5 && $2 > seconds[$1] + margin {
      text = sprintf("tests/run: %s took %ds, %ds in %s; %s", $1, $2, seconds[$1], label, advice)
      print text
      if (annotate) print "::warning title=bats file slower::" text
    }' "$timings" -
}

# The clock shim, tests/helpers/clockshift.c, built into <dir>/clockshift.so, and checked to move
# date's clock and jq's now the run's days past the unshifted clock (see the header); fails naming
# why.
clock_shim() {
  local so=$1/clockshift.so seconds=$((clock * 86400)) now ahead
  if ! cc -shared -fPIC -O2 -o "$so" "$root/tests/helpers/clockshift.c" -ldl; then
    echo "clock-ahead: cc could not build tests/helpers/clockshift.c"
    return 1
  fi
  # The clock with no shift, as a shim this run is already under reads it with CLOCKSHIFT_SECONDS 0.
  now=$(CLOCKSHIFT_SECONDS=0 date +%s)
  ahead=$(LD_PRELOAD=$so CLOCKSHIFT_SECONDS=$seconds date +%s)
  if ((ahead - now < seconds - 60)); then
    echo "clock-ahead: date +%s read $ahead under tests/helpers/clockshift.c, not $clock days past $now, so the shim moves no clock here"
    return 1
  fi
  # jq's now, which the team's programs read beside date's: a static jq never loads the shim.
  ahead=$(LD_PRELOAD=$so CLOCKSHIFT_SECONDS=$seconds jq -n 'now | floor') || {
    echo "clock-ahead: jq -n now failed under tests/helpers/clockshift.c"
    return 1
  }
  if ! [[ $ahead =~ ^[0-9]+$ ]] || ((ahead - now < seconds - 60)); then
    echo "clock-ahead: jq's now read $ahead under tests/helpers/clockshift.c, not $clock days past $now: $(command -v jq) is a static binary or loads no shim, so a test reading its now beside date's would fail on the two clocks alone; put a dynamically linked jq first on PATH"
    return 1
  fi
}

# Each test tagged wall-clock in the files listed in <files>, which a --clock-ahead run does not
# run, as "tests/<name>.bats: <test> # not run: tagged wall-clock".
wall_clock_tests() {
  local file
  while IFS= read -r file; do
    awk -v name="tests/${file##*/}" '
      /^# bats test_tags=/ { n = split(substr($0, length("# bats test_tags=") + 1), tags, /[[:space:]]*,[[:space:]]*/)
        for (i = 1; i <= n; i++) if (tags[i] == "wall-clock") tagged = 1
        next }
      /^@test / { if (tagged) { t = $0; sub(/^@test +"/, "", t); sub(/" *\{ *$/, "", t); print name ": " t " # not run: tagged wall-clock" }
        tagged = 0 }' "$file"
  done <"$1"
}

# The bats files (bats_files), in parallel, each test and file under its time limit (see the
# header); fails if any file fails.
run_bats() {
  local file failed=0 names minutes="$file_minutes minutes" tags='' clock_env=()
  ((file_minutes != 1)) || minutes='1 minute'
  out=$(team_mktemp -d)
  # Each file's output goes to $out/<file>, with $out/<file>.failed beside it when it fails,
  # $out/<file>.stopped when its time limit stopped it, and $out/<file>.seconds its seconds.
  bats_files >"$out/files" || { echo "bats: tests/shards could not split the files"; return 1; }
  if [[ -n $clock ]]; then
    if [[ ! -s $out/files ]]; then
      echo "clock-ahead: no bats file touched since $base"
      return 0
    fi
    echo "clock-ahead $clock days: $(wc -l <"$out/files") of $(find "$root/tests" -maxdepth 1 -name '*.bats' | wc -l) files touched since $base"
    mapfile -t names <<<"$selected"
    printf '  %s\n' "${names[@]}"
    clock_shim "$out" || return 1
    tags='!wall-clock'
    clock_env=("LD_PRELOAD=$out/clockshift.so${LD_PRELOAD:+ $LD_PRELOAD}" "CLOCKSHIFT_SECONDS=$((clock * 86400))")
  elif [[ -n $changed ]]; then
    if [[ ! -s $out/files ]]; then
      echo "bats: no path changed since $base, so no file runs"
      return 0
    fi
    echo "bats --changed $base: $(wc -l <"$out/files") of $(find "$root/tests" -maxdepth 1 -name '*.bats' | wc -l) files"
    mapfile -t names <<<"$selected"
    printf '  %s\n' "${names[@]}"
  elif [[ ! -s $out/files ]]; then
    echo "bats: shard $shard has no file"
    return 0
  fi
  # timeout ends 124 when its TERM stopped the file, 137 when its kill did. It runs the file in a
  # process group of its own, so its kill reaches what the file left behind, but a signal to this
  # run's group (team-heavy stop with no scope, a Ctrl-C) does not: each file's bash passes an
  # INT, TERM or HUP on to its timeout as TERM, which signals that group, and ends once it has;
  # the trap is set before timeout starts and reads $! when it fires, so a signal that comes
  # first ends the bash before it starts one, and any later one reaches it.
  # shellcheck disable=SC2016 # expanded by each file's bash
  # A --clock-ahead run's files (and every process they start) read the clock moved ahead, and
  # skip the tests tagged wall-clock; $3 is the tags filter, or none.
  tr '\n' '\0' <"$out/files" |
    env BATS_TEST_TIMEOUT="$test_seconds" "${clock_env[@]}" xargs -0 -r -n 1 -P "$jobs" bash -c '
      name=${4##*/} verdict=ok rc=0 stopped="" tags=()
      [[ -z $3 ]] || tags=(--filter-tags "$3")
      trap "[[ -z \$! ]] || { kill -TERM \$! 2>/dev/null; wait \$!; }; exit 143" INT TERM HUP
      timeout -k 30 "$2m" "$0/tests/vendor/bats-core/bin/bats" "${tags[@]}" "$4" >"$1/$name" 2>&1 &
      wait "$!" || rc=$?
      if ((rc != 0)); then verdict="not ok"; touch "$1/$name.failed"; fi
      if ((rc == 124 || rc == 137)) && ((SECONDS >= $2 * 60)); then
        touch "$1/$name.stopped"
        stopped=": stopped at its $2-minute limit"
      fi
      echo "$SECONDS" >"$1/$name.seconds"
      printf "%s tests/%s (%ds)%s\n" "$verdict" "$name" "$SECONDS" "$stopped"' "$root" "$out" "$file_minutes" "$tags"
  for file in "$out"/*.bats; do
    [[ -e $file.failed ]] || continue
    failed=$((failed + 1))
    printf '\n--- tests/%s\n' "${file##*/}"
    cat "$file"
    # A file stopped mid-line ends that line first.
    [[ ! -s $file || -z $(tail -c 1 "$file") ]] || echo
    [[ ! -e $file.stopped ]] ||
      echo "tests/run: tests/${file##*/} ran past $minutes; the test after the last line above was still running, or a process it left held the file's output open"
  done
  # A skipped test counts as passed, so each one is named, which a file's ok line never shows.
  for file in "$out"/*.bats; do
    grep -E '^ok [0-9]+ .* # skip( |$)' "$file" | sed "s|^|tests/${file##*/}: |" || (($? == 1))
  done
  [[ -z $clock ]] || wall_clock_tests "$out/files"
  echo "bats: $(cat "$out"/*.bats | grep -c '^ok ') tests passed; $failed of $(find "$out" -name '*.bats' | wc -l) files failed"
  slow_files "$out"
  ((failed == 0))
}

selected=''
if [[ -n $changed && $what == shellcheck ]]; then
  selected=$(changed_scripts) || die "could not read the paths changed since $base"
elif [[ -n $changed && $what == rust ]]; then
  selected=$(changed_rust_paths) || die "could not read the paths changed since $base"
elif [[ -n $changed ]]; then
  selected=$(changed_selection | LC_ALL=C sort -u) || die "could not read the paths changed since $base"
elif [[ -n $clock ]]; then
  selected=$(clock_selection | LC_ALL=C sort -u) || die "could not read the paths changed since $base"
fi
if [[ -n $list && -n $changed$clock ]]; then
  [[ -z $selected ]] || echo "$selected"
  exit
elif [[ -n $list ]]; then
  files=$(bats_files) || die "tests/shards could not split the files"
  while IFS= read -r file; do [[ -z $file ]] || echo "${file#"$root/"}"; done <<<"$files"
  exit
fi
fail=0 jobs=''
SECONDS=0
if [[ -n $changed && $what == shellcheck && -z $selected ]]; then
  echo "shellcheck: no shell script changed since $base, so none is checked"
elif [[ -n $changed && $what == shellcheck ]]; then
  mapfile -t scripts <<<"$selected"
  echo "shellcheck $(shellcheck --version | sed -n 's/^version: //p') --changed $base: ${#scripts[@]} of $(shell_scripts | wc -l) scripts"
  printf '  %s\n' "${scripts[@]}"
  (cd "$root" && shellcheck -x "${scripts[@]}") || fail=1
elif [[ $what == all || $what == shellcheck ]]; then
  mapfile -t scripts < <(shell_scripts)
  echo "shellcheck $(shellcheck --version | sed -n 's/^version: //p'): ${#scripts[@]} scripts"
  (cd "$root" && shellcheck -x "${scripts[@]}") || fail=1
fi
if [[ $what == all || $what == bats ]]; then
  jobs=$(parallelism)
  run_bats || fail=1
fi
if [[ $what == all || $what == toolkits ]]; then
  if "$root/servers/install"; then
    node --test --test-timeout=300000 --test-force-exit "$root"/tests/toolkits/*.test.mjs || fail=1
  else
    fail=1
  fi
fi
if [[ -n $changed && $what == rust && -z $selected ]]; then
  echo "rust: no Rust path changed, nothing to check"
elif [[ $what == all || $what == rust ]]; then
  if [[ -n $changed ]]; then
    mapfile -t names <<<"$selected"
    echo "rust --changed $base: ${#names[@]} Rust path$( ((${#names[@]} == 1)) || echo s) changed"
    printf '  %s\n' "${names[@]}"
  fi
  (run_rust) || fail=1
fi
printf 'tests/run %s: %dm %02ds%s\n' "$what" $((SECONDS / 60)) $((SECONDS % 60)) \
  "${jobs:+, up to $jobs bats file$( ((jobs == 1)) || echo s) at once}"
exit $fail
