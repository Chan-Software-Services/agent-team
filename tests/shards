#!/usr/bin/env bash
# The bats suite's shards, which tests/run bats --shard runs and CI's test-shards jobs each run
# one of.
# Each tests/*.bats file weighs its seconds in the timings (TESTS_TIMINGS when set, else
# tests/timings.tsv; a row for a file the checkout lacks weighs nothing) on this platform (macos on
# macOS, linux elsewhere); a file the timings lack weighs its bytes at the timed files' seconds
# per byte, so a new file needs no timing yet. The files, the heaviest first (ties by name), each
# go to the shard with the least weight so far (ties to the lowest number), so one tree splits the
# same on every machine of a platform.
#
# Usage: tests/shards <n>                 print every file, the heaviest first, as
#                                         "<shard>\t<weight>\ttests/<name>.bats", its shard 1 to n
#        tests/shards update [--to <file>] [<run id>]
#                                         rewrite tests/timings.tsv, or write <file>, from the
#                                         per-file seconds that a CI run's shard jobs printed
#                                         (default: the latest successful CI run), through gh, as
#                                         the Linux seconds; no CI shard job runs on macOS, so
#                                         each file keeps the macOS seconds tests/timings.tsv had,
#                                         and a file it lacks has none; a run whose shard jobs printed
#                                         fewer than half of tests/*.bats is refused, writing
#                                         nothing, so a partial run cannot skew the split
# CI's shard-plan job runs update --to on every run and its shards name that file by TESTS_TIMINGS,
# so they split by the latest successful run's seconds; the committed tests/timings.tsv is what
# they split by when that job cannot read a run, and what a local tests/run bats --shard splits
# by, so refresh it when files are added or the suite's times move.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# The shards need no team home, as on CI or a fresh clone.
# shellcheck disable=SC2034 # read by bin/lib/team.sh
team_home_report=1
# shellcheck source=bin/lib/team.sh
source "$root/bin/lib/team.sh" "$@"

usage="usage: tests/shards <n> | tests/shards update [--to <file>] [<run id>]"
timings=$root/tests/timings.tsv

# The timings from the CI run <run id> into <to>: each test-shards job's
# "ok|not ok tests/<name>.bats (<n>s)" lines as linux, and each of those files' macos seconds as
# tests/timings.tsv had them.
update() {
  local run=$1 to=$2 jobs id name sha created printed suite
  if [[ -z $run ]]; then
    run=$(cd "$root" && gh run list --workflow ci.yml --status success --limit 1 --json databaseId --jq '.[0].databaseId // empty')
    [[ -n $run ]] || die "no successful CI run to read"
  fi
  jobs=$(cd "$root" && gh run view "$run" --json jobs,headSha,createdAt) || die "cannot read CI run $run"
  sha=$(jq -r .headSha <<<"$jobs") created=$(jq -r .createdAt <<<"$jobs")
  # Removed when the script exits, so a die, which exits, removes it too.
  scratch=$(team_mktemp -d)
  while IFS=$'\t' read -r id name; do
    [[ $name == test-shards* ]] || continue
    (cd "$root" && gh run view "$run" --job "$id" --log) |
      grep -oE '(not )?ok tests/[^ /]+\.bats \([0-9]+s\)' |
      sed -E "s/^(not )?ok (tests\/[^ ]+) \(([0-9]+)s\)$/\2\t\3/" >>"$scratch/seconds" ||
      die "cannot read the log of $name in CI run $run"
  done < <(jq -r '.jobs[] | [.databaseId, .name] | @tsv' <<<"$jobs")
  [[ -s $scratch/seconds ]] || die "CI run $run printed no per-file seconds in a shard job"
  printed=$(cut -f1 "$scratch/seconds" | sort -u | wc -l)
  suite=$(cd "$root" && find tests -maxdepth 1 -name '*.bats' | wc -l)
  ((2 * printed >= suite)) || die "CI run $run printed $printed of $suite files; keeping the timings"
  if [[ -f $timings ]]; then cp "$timings" "$scratch/before"; else : >"$scratch/before"; fi
  {
    echo "# The seconds each bats file took on Linux in CI run $run (head ${sha:0:7}, $created),"
    echo "# and on macOS as the timings before it had them, since CI runs no bats on macOS; tests/shards update rewrites it."
    printf 'file\tlinux\tmacos\n'
    awk -F'\t' '
      FILENAME != "-" {
        if (/^#/) next
        if ($1 == "file") { for (i = 2; i <= NF; i++) if ($i == "macos") c = i; next }
        if (c && $c != "") macos[$1] = $c
        next
      }
      { linux[$1] = $2 }
      END { for (x in linux) printf "%s\t%s\t%s\n", x, linux[x], (x in macos ? macos[x] : "") }' \
      "$scratch/before" - <"$scratch/seconds" | LC_ALL=C sort
  } >"$scratch/after"
  mv "$scratch/after" "$to"
  [[ $to != "$timings" ]] || to=tests/timings.tsv
  echo "tests/shards: wrote $to from CI run $run"
}

# Every file's shard of <n>, as the header says.
shards() {
  local n=$1 column=linux given=${TESTS_TIMINGS:-$timings}
  [[ $(uname -s) != Darwin ]] || column=macos
  [[ -f $given ]] || given=/dev/null
  # Weights: the timed seconds, else the bytes at the timed files' seconds per byte (at least 1).
  (cd "$root" && find tests -maxdepth 1 -name '*.bats' -printf '%s\t%p\n') |
    awk -F'\t' -v column="$column" '
      FILENAME != "-" {
        if (/^#/) next
        if ($1 == "file") { for (i = 2; i <= NF; i++) if ($i == column) c = i; next }
        if (c && $c != "") seconds[$1] = $c
        next
      }
      { size[$2] = $1; if ($2 in seconds) { timed_s += seconds[$2]; timed_b += $1 } }
      END {
        ratio = timed_b ? timed_s / timed_b : 1
        for (f in size) {
          w = (f in seconds) ? seconds[f] : int(size[f] * ratio + 0.5)
          printf "%d\t%s\n", (w < 1 ? 1 : w), f
        }
      }' "$given" - |
    LC_ALL=C sort -t $'\t' -k1,1rn -k2,2 |
    awk -F'\t' -v n="$n" '
      BEGIN { for (i = 1; i <= n; i++) load[i] = 0 }
      { least = 1; for (i = 2; i <= n; i++) if (load[i] < load[least]) least = i
        load[least] += $1; printf "%d\t%s\t%s\n", least, $1, $2 }'
}

case ${1:-} in
  update)
    shift
    to=$timings run=''
    while (($#)); do
      case $1 in
        --to) [[ $# -ge 2 && -n $2 ]] || usage_error "$usage"; to=$2; shift 2 ;;
        *) [[ -z $run && $1 =~ ^[0-9]+$ ]] || usage_error "$usage"; run=$1; shift ;;
      esac
    done
    update "$run" "$to"
    ;;
  *)
    [[ $# -eq 1 && $1 =~ ^[1-9][0-9]*$ ]] || usage_error "$usage"
    shards "$1"
    ;;
esac
